<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Registered Students</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 2rem;
      background: #f0f4f8;
    }
    h1 {
      text-align: center;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 2rem;
    }
    th, td {
      border: 1px solid #ddd;
      padding: 1rem;
      text-align: left;
    }
    th {
      background-color: #007BFF;
      color: white;
    }
  </style>
</head>
<body>
  <h1>All Registered Students</h1>
  <% if (students.length > 0) { %>
    <table>
      <tr>
        <th>Name</th>
        <th>Roll No</th>
        <th>Email</th>
        <th>Club</th>
        <th>Reason</th>
      </tr>
      <% students.forEach(student => { %>
        <tr>
          <td><%= student.name %></td>
          <td><%= student.rollNo %></td>
          <td><%= student.email %></td>
          <td><%= student.club %></td>
          <td><%= student.whyJoin %></td>
        </tr>
      <% }); %>
    </table>
  <% } else { %>
    <p>No registrations yet.</p>
  <% } %>
</body>
</html>