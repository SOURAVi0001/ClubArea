<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <title><%= member.name %> - Member Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap');

    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #a1c4fd, #c2e9fb);
      margin: 0;
      padding: 2rem;
      color: #333;
    }

    h1 {
      text-align: center;
      margin-bottom: 2rem;
      color: #004d40;
    }

    .task-container {
      display: grid;
      gap: 2rem;
      max-width: 1000px;
      margin: auto;
    }

    .task-card {
      background: #fff;
      border-radius: 15px;
      box-shadow: 0 0 15px rgba(0,0,0,0.1);
      padding: 1.5rem;
      transition: transform 0.3s;
    }

    .task-card:hover {
      transform: scale(1.02);
    }

    .task-title {
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: #0288d1;
    }

    .status {
      font-size: 0.95rem;
      font-weight: bold;
      margin-bottom: 0.8rem;
      color: #388e3c;
    }

    .progress-bar {
      background: #eee;
      border-radius: 20px;
      height: 12px;
      overflow: hidden;
      margin-bottom: 1rem;
    }

    .progress {
      height: 100%;
      background: linear-gradient(to right, #4caf50, #ffc107);
      transition: width 0.3s ease;
    }

    .actions textarea {
      width: 100%;
      padding: 0.6rem;
      border-radius: 8px;
      border: 1px solid #ccc;
      margin-bottom: 0.8rem;
    }

    .actions button {
      padding: 0.6rem 1rem;
      margin-right: 1rem;
      background-color: #007bff;
      color: #fff;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.3s;
    }

    .actions button:hover {
      background-color: #0056b3;
    }

    footer {
      text-align: center;
      margin-top: 3rem;
      color: #666;
    }
  </style>
</head>
<body>

  <h1>Welcome, <%= member.name %> 👋</h1>

  <div class="task-container">
    <% member.tasks.forEach(task => { %>
      <div class="task-card">
        <div class="task-title"><%= task.title %></div>
        <div class="status">Status: <%= task.status %></div>

        <div class="progress-bar">
          <div class="progress" style="width: <%= task.deadlineProgress %>%;"></div>
        </div>

        <div class="actions">
          <textarea placeholder="Upload or paste your work link..."></textarea>
          <button>Submit Work</button>
          <% if(task.status !== 'Completed') { %>
            <button>Mark as Complete</button>
          <% } else { %>
            <button disabled style="background: #ccc;">Completed</button>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>

  <footer>
    &copy; 2025 ClubEaria - Member Portal
  </footer>

</body>
</html>