<!DOCTYPE html>
<html lang="en">
<head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>MEMBER-DASHBOARD</title>
      <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="flex">
    <div class="w-[300px] bg-cover">
      <h1 class=" text-[40px] text-blue mt-[10px] mx-[70px]">Horizina</h1>
      <div class="flex m-[20px]">
      <img src="./Club_Member/logo.png" alt="DP" class="h-[50px] w-[80px]">
      <div class="mx-[20px]">
             <h1 >Member Name</h1>
             <h1>MEMBER</h1>
      </div>
     </div>
     <div class="grid mt-[10px]">
    <a href="" class="flex justify-center bg-indigo-700 hover:bg-violet-700 text-white p-[30px] border-2 border-neutral-900">Dash-Board</a>
    <a href="" class="flex justify-center bg-indigo-700 hover:bg-violet-700 text-white p-[30px] border-2 border-neutral-900">Events</a>
    <a href="" class="flex justify-center bg-indigo-700 hover:bg-violet-700 text-white p-[30px] border-2 border-neutral-900">Contact Leader</a>
    <a href="" class="flex justify-center bg-indigo-700 hover:bg-violet-700 text-white p-[30px] border-2 border-neutral-900">Updates</a>
    <a href="" class="flex justify-center bg-indigo-700 hover:bg-violet-700 text-white p-[30px] border-2 border-neutral-900">Task-Status</a>
    <a href="" class="flex justify-center bg-indigo-700 hover:bg-violet-700 text-white p-[30px] border-2 border-neutral-900">Feedback</a>
    </div>
    </div>
    <div class="border-4 border-green-900 w-full">
      <div class="grid">

            <div class="flex justify-center border-4 border-green-900 h-[300px]">
                  <div class="flex-1 border-4 border-green-900 flex justify-center items-center">
                        <h1 class="border-4 border-green-900 p-4">Overview</h1>
                  </div>
                 
                  
            </div>
      </div>
      <div class="grid">

            <div class="flex justify-center border-4 border-green-900 h-[300px]">
                  <div class="flex-1 border-4 border-green-900 flex justify-center items-center">
                        <h1 class="border-4 border-green-900 p-4">Upcoming Events</h1>
                  </div>
                  <div class="flex-1 border-4 border-green-900 flex justify-center items-center">
                        <h1 class="border-4 border-green-900  p-4">Task Status Tracker</h1>
                  </div>
                  <div class="flex-1 border-4 border-green-900 flex justify-center items-center">
                        <h1 class="border-4 border-green-900 p-4">Feedback & Reports</h1>
                  </div>
            </div>
      </div>
      <div class="grid">

            <div class="flex justify-center border-4 border-green-900 h-[300px]">
                  <div class="flex-1 border-4 border-green-900 flex justify-center items-center">
                        <h1 class="border-4 border-green-900 p-4">Updates & Announcement</h1>
                  </div>
                  <div class="flex-1 border-4 border-green-900 flex justify-center items-center">
                        <h1 class="border-4 border-green-900  p-4">Activity Log</h1>
                  </div>
                  
            </div>
      </div>
    </div>
    </div>
</body>
</html>