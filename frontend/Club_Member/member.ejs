  <!-- Enhanced JavaScript for Dashboard Functionality -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Progress bar animation with smoother easing
      const progressBar = document.querySelector('.progress-bar');
      if (progressBar) {
        setTimeout(() => {
          progressBar.style.width = '75%';
        }, 700);
      }

      // Enhanced feedback form functionality
      const feedbackTextarea = document.getElementById('feedbackTextarea');
      const submitButton = document.getElementById('submitFeedback');
      const successMessage = document.getElementById('successMessage');
      
      if (feedbackTextarea && submitButton) {
        // Real-time validation with smooth animations
        feedbackTextarea.addEventListener('input', function() {
          const hasContent = this.value.trim().length > 0;
          submitButton.disabled = !hasContent;
          
          // Smooth button state transitions
          if (hasContent) {
            submitButton.classList.remove('opacity-50');
            submitButton.classList.add('hover:scale-105');
          } else {
            submitButton.classList.add('opacity-50');
            submitButton.classList.remove('hover:scale-105');
          }
          
          // Hide success message when typing
          if (hasContent && !successMessage.classList.contains('hidden')) {
            successMessage.classList.add('hidden');
          }
        });

        // Handle form submission with better animations
        submitButton.addEventListener('click', function(e) {
          e.preventDefault();
          const feedback = feedbackTextarea.value.trim();
          
          if (feedback.length > 0) {
            // Smooth submission animation
            submitButton.innerHTML = '<span class="truncate">Submitting...</span>';
            submitButton.disabled = true;
            submitButton.classList.add('animate-pulse');
            
            setTimeout(() => {
              // Reset form with smooth transitions
              feedbackTextarea.value = '';
              submitButton.innerHTML = '<span class="truncate">Submit Feedback</span>';
              submitButton.classList.add('opacity-50');
              submitButton.classList.remove('animate-pulse', 'hover:scale-105');
              submitButton.disabled = true;
              
              // Show success message with animation
              successMessage.classList.remove('hidden');
              
              // Hide success message after 4 seconds
              setTimeout(() => {
                successMessage.classList.add('hidden');
              }, 4000);
            }, 1200);
          }
        });
      }

      // Enhanced smooth scroll and loading states
      document.querySelectorAll('a[href^="/"]').forEach(link => {
        link.addEventListener('click', function(e) {
          // Smooth loading state
          this.style.transform = 'scale(0.98)';
          this.style.opacity = '0.8';
          setTimeout(() => {
            this.style.transform = 'scale(1)';
            this.style.opacity = '1';
          }, 200);
        });
      });

      // Enhanced card animations with stagger effect
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -30px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0) scale(1)';
          }
        });
      }, observerOptions);

      // Observe all dashboard cards with staggered animation
      document.querySelectorAll('.grid > div').forEach((card, index) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(30px) scale(0.95)';
        card.style.transition = `all 0.8s cubic-bezier(0.4, 0, 0.2, 1) ${index * 0.15}s`;
        observer.observe(card);
      });

      // Add pulse animation to important elements
      const pulseElements = document.querySelectorAll('.progress-bar, [id*="feedback"]');
      pulseElements.forEach(element => {
        element.addEventListener('mouseenter', function() {
          this.style.animation = 'pulse 1s ease-in-out';
        });
        element.addEventListener('animationend', function() {
          this.style.animation = '';
        });
      });

      // Responsive behavior enhancements
      function handleResize() {
        const isMobile = window.innerWidth < 768;
        const cards = document.querySelectorAll('.grid > div');
        
        cards.forEach(card => {
          if (isMobile) {
            card.style.transform = 'scale(1)';
          }
        });
      }

      window.addEventListener('resize', handleResize);
      handleResize(); // Initial call
    });
  </script>

  <!-- Additional CSS for enhanced effects -->
  <style>
    /* Custom animations */
    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Smooth backdrop blur */
    .backdrop-blur-sm {
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    /* Enhanced hover effects */
    .group:hover .group-hover\:scale-110 {
      transform: scale(1.1);
    }

    .group:hover .group-hover\:translate-x-1 {
      transform: translateX(0.25rem);
    }

    /* Better focus states */
    .form-input:focus {
      box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
    }

    /* Responsive text adjustments */
    @media (max-width: 640px) {
      .text-2xl { font-size: 1.5rem; }
      .text-3xl { font-size: 1.875rem; }
      .text-4xl { font-size: 2.25rem; }
    }

    /* Loading animation */
    .animate-pulse {
      animation: pulse 1s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    /* Gradient text effect */
    .bg-clip-text {
      -webkit-background-clip: text;
      background-clip: text;
    }
  </style>

</div>

</body>
</html>
