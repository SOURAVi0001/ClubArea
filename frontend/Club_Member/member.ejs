            <div class="flex max-w-[480px] flex-wrap items-end gap-4 py-3">
              <label class="flex flex-col min-w-40 flex-1">
                <textarea
                  placeholder="Share your feedback or suggestions"
                  class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#121416] focus:outline-0 focus:ring-2 focus:ring-blue-200 border border-[#dde1e3] bg-white focus:border-blue-500 min-h-36 placeholder:text-[#6a7681] p-[15px] text-base font-normal leading-normal transition-all"
                ></textarea>
              </label>
            </div>
            <div class="flex py-3 justify-between items-center">
              <a href="/member_feedback" class="text-[#2a5298] text-sm font-medium hover:underline">View feedback history →</a>
              <button
                class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-6 bg-[#2a5298] hover:bg-[#1e3f7c] text-white text-sm font-bold leading-normal tracking-[0.015em] transition-colors"
              >
                <span class="truncate">Submit Feedback</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- JavaScript for Mobile Menu and Progress Bar Animation -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Mobile menu functionality (inherited from sidebar)
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const menuButton = document.getElementById('mobile-menu-button');

      if (sidebar && backdrop && menuButton) {
        // Toggle mobile menu
        menuButton.addEventListener('click', function() {
          sidebar.classList.toggle('-translate-x-full');
          backdrop.classList.toggle('hidden');
        });

        // Close on backdrop click
        backdrop.addEventListener('click', function() {
          sidebar.classList.add('-translate-x-full');
          backdrop.classList.add('hidden');
        });

        // Close on escape key
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            sidebar.classList.add('-translate-x-full');
            backdrop.classList.add('hidden');
          }
        });
      }

      // Progress bar animation
      const progressBar = document.querySelector('[style*="width: 75%"]');
      if (progressBar) {
        progressBar.style.width = '0%';
        setTimeout(() => {
          progressBar.style.width = '75%';
          progressBar.style.transition = 'width 1s ease-in-out';
        }, 500);
      }

      // Add interactivity to feedback form
      const feedbackTextarea = document.querySelector('textarea');
      const submitButton = document.querySelector('button');
      
      if (feedbackTextarea && submitButton) {
        feedbackTextarea.addEventListener('input', function() {
          if (this.value.trim().length > 0) {
            submitButton.classList.remove('opacity-50');
            submitButton.disabled = false;
          } else {
            submitButton.classList.add('opacity-50');
            submitButton.disabled = true;
          }
        });

        // Initial state
        if (feedbackTextarea.value.trim().length === 0) {
          submitButton.classList.add('opacity-50');
          submitButton.disabled = true;
        }

        // Handle form submission
        submitButton.addEventListener('click', function(e) {
          const feedback = feedbackTextarea.value.trim();
          if (feedback.length > 0) {
            // Here you can add AJAX submission or form handling
            console.log('Feedback submitted:', feedback);
            feedbackTextarea.value = '';
            submitButton.classList.add('opacity-50');
            submitButton.disabled = true;
            
            // Show success message (optional)
            const successMessage = document.createElement('div');
            successMessage.className = 'mt-2 text-green-600 text-sm';
            successMessage.textContent = 'Thank you for your feedback!';
            feedbackTextarea.parentNode.appendChild(successMessage);
            
            setTimeout(() => {
              successMessage.remove();
            }, 3000);
          }
        });
      }
    });
  </script>

</div>
