<%- include("./Partials/starter.ejs") %>
<div class="relative flex size-full min-h-screen flex-col bg-white group/design-root overflow-x-hidden" style='font-family: "Plus Jakarta Sans", "Noto Sans", sans-serif;'>
  <div class="layout-container flex h-full grow flex-col">
    <div class="gap-1 px-6 flex flex-1 justify-center py-5">
      <%- include("./Partials/header.ejs") %>
          <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
            <div class="flex flex-wrap justify-between gap-3 p-4">
              <div class="flex min-w-72 flex-col gap-3">
                <p class="text-[#181111] tracking-light text-[32px] font-bold leading-tight">Task Details</p>
                <p class="text-[#886363] text-sm font-normal leading-normal">Review and manage the details of the assigned task.</p>
              </div>
            </div>
            <div class="p-4">
              <div
                class="bg-cover bg-center flex flex-col items-stretch justify-end rounded-lg pt-[132px]"
                style='background-image: linear-gradient(0deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0) 100%), url("https://lh3.googleusercontent.com/aida-public/AB6AXuARDIX8jI7zAFRCvZRRaSYrqgTbnDadd2YGc3C1gqDpnWUoUqDuiTcBTXeRgOBXrbHzLHwCN5JS9h7iLogSU4y2_DWpMmInXmyQWSMeSbNNoOL2w0vn8K08dXn_xtUOIAXJ394qayvmj3Z6ofl8jFYFLqWA3MMv7WvqlLEX4ECwpfUokY6fmfzo2Re7nYwIA31lLh3WxuQXzNCRAbtsTc9e2v-_CSRvTQzzFjKD2aR5R1QIrOoYGCHhybQcDcMMpDWFGp3l5pDiY9M");'
              >
                <div class="flex w-full items-end justify-between gap-4 p-4">
                  <div class="flex max-w-[440px] flex-1 flex-col gap-1">
                    <p class="text-white tracking-light text-2xl font-bold leading-tight max-w-[440px]"><%=task.title%></p>
                    <p class="text-white text-base font-medium leading-normal"></p>
                  </div>
                </div>
              </div>
            </div>
            <div class="p-4 grid grid-cols-[20%_1fr] gap-x-6">
              <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#e5dcdc] py-5">
                <p class="text-[#886363] text-sm font-normal leading-normal">Description</p>
                <p class="text-[#181111] text-sm font-normal leading-normal">
                  <%=task.description%> </p>
              </div>
              <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#e5dcdc] py-5">
                <p class="text-[#886363] text-sm font-normal leading-normal">Last Completion Date</p>
                <p class="text-[#181111] text-sm font-normal leading-normal"><%=task.task_completion_date%></p>
              </div>
            </div>
            <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
              <label class="flex flex-col min-w-40 flex-1">
                <textarea
                  placeholder="Add proof of completion"
                  class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#181111] focus:outline-0 focus:ring-0 border border-[#e5dcdc] bg-white focus:border-[#e5dcdc] min-h-36 placeholder:text-[#886363] p-[15px] text-base font-normal leading-normal"
                ></textarea>
              </label>
            </div>
            <div class="flex px-4 py-3 justify-end">
              <button
                class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-[#e51919] text-white text-sm font-bold leading-normal tracking-[0.015em]"
              >
                <span class="truncate">Submit</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
