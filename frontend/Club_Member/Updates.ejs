 <%- include("./Partials/starter.ejs") %>
    <div class="relative flex size-full min-h-screen flex-col bg-white group/design-root overflow-x-hidden" style='font-family: "Plus Jakarta Sans", "Noto Sans", sans-serif;'>
  <div class="layout-container flex h-full grow flex-col">
    <div class="gap-1 px-6 flex flex-1 justify-center py-5">
      <%- include("./Partials/header.ejs") %>
      <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
        <div class="flex flex-wrap justify-between gap-3 p-4">
          <p class="text-[#111518] tracking-light text-[32px] font-bold leading-tight min-w-72">Club Updates</p>
        </div>


        <!-- Recent Updates -->
        <h2 class="text-[#111518] text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5">Recent Updates</h2>

        <% if (update && update.length > 0) { %>
          <% update.forEach(function(item) { %>
            <div class="flex items-center gap-4 bg-white px-4 min-h-[72px] py-2 border-b border-gray-100">
              <div class="text-[#111518] flex items-center justify-center rounded-lg bg-[#f0f2f5] shrink-0 size-12" data-icon="Users" data-size="24px" data-weight="regular">
                <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" fill="currentColor" viewBox="0 0 256 256">
                  <path
                    d="M117.25,157.92a60,60,0,1,0-66.5,0A95.83,95.83,0,0,0,3.53,195.63a8,8,0,1,0,13.4,8.74,80,80,0,0,1,134.14,0,8,8,0,0,0,13.4-8.74A95.83,95.83,0,0,0,117.25,157.92ZM40,108a44,44,0,1,1,44,44A44.05,44.05,0,0,1,40,108Zm210.14,98.7a8,8,0,0,1-11.07-2.33A79.83,79.83,0,0,0,172,168a8,8,0,0,1,0-16,44,44,0,1,0-16.34-84.87,8,8,0,1,1-5.94-14.85,60,60,0,0,1,55.53,105.64,95.83,95.83,0,0,1,47.22,37.71A8,8,0,0,1,250.14,206.7Z"
                  ></path>
                </svg>
              </div>
              <div class="flex flex-col justify-center">
                <p class="text-[#111518] text-base font-medium leading-normal line-clamp-1"><%= item.title %></p>
                <p class="text-[#60768a] text-sm font-normal leading-normal line-clamp-2">
                  <%= item.date.toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', hour12: true }) %>
                </p>
                <div class="flex items-end gap-3 justify-between">
                  <p class="text-[#60768a] text-base font-normal leading-normal">
                    <%= item.description %>
                  </p>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="text-center text-gray-400 py-8 text-base">No updates available.</div>
        <% } %>

        <!-- Pagination -->
        <div class="flex justify-between items-center px-4 py-6">
          <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %>" class="text-blue-600 hover:underline font-medium">← Previous</a>
          <% } else { %>
            <span class="text-gray-400">← Previous</span>
          <% } %>

          <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %>" class="text-blue-600 hover:underline font-medium">Next →</a>
          <% } else { %>
            <span class="text-gray-400">Next →</span>
          <% } %>
        </div>

      </div>
    </div>
  </div>
</div>