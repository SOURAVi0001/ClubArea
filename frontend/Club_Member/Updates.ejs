<%- include("./Partials/starter.ejs") %>

<div class="relative flex size-full min-h-screen flex-col bg-gray-50 group/design-root overflow-x-hidden" style='font-family: "Plus Jakarta Sans", "Noto Sans", sans-serif;'>
  
  <!-- Include the sidebar partial with proper parameters -->
  <%- include('Partials/sidebar', { 
    Member_Name: typeof Member_Name !== 'undefined' ? Member_Name : 'Member Name',
    Club_Name: typeof Club_Name !== 'undefined' ? Club_Name : 'Club Name',
    currentPage: 'updates' 
  }) %>

  <!-- Main Content Area with margin for sidebar -->
  <main class="ml-0 md:ml-80 min-h-screen">
    <div class="layout-container flex h-full grow flex-col">
      <div class="gap-1 px-6 flex flex-1 justify-center py-5">
     
        
        <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
          
          <!-- Enhanced Page Header -->
          <header class="mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <div>
                <h1 class="text-4xl font-bold text-[#111518] mb-2">Club Updates</h1>
                <p class="text-gray-600">Stay informed with the latest club news and announcements.</p>
              </div>
            </div>
          </header>

          <!-- Recent Updates Section -->
          <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 mb-8">
            <h2 class="text-2xl font-bold text-[#111518] mb-6 flex items-center gap-2">
              <div class="bg-red-100 p-2 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
                </svg>
              </div>
              Recent Updates
            </h2>

            <!-- Updates List -->
            <div class="space-y-4">
              <% if (typeof update !== 'undefined' && update && update.length > 0) { %>
                <% update.forEach(function(item, index) { %>
                  <div class="bg-gray-50 rounded-xl p-6 hover:bg-gray-100 transition-colors border border-gray-200">
                    <div class="flex items-start gap-4">
                      <!-- Icon Section -->
                      <div class="flex-shrink-0 bg-blue-100 p-3 rounded-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
                        </svg>
                      </div>

                      <!-- Content Section -->
                      <div class="flex-1">
                        <!-- Update Header -->
                        <div class="flex items-start justify-between mb-3">
                          <h3 class="text-xl font-bold text-[#111518] leading-tight">
                            <%= item.title %>
                          </h3>
                          <div class="flex items-center gap-2 text-[#60768a] text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <%= item.date.toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', hour12: true }) %>
                          </div>
                        </div>

                        <!-- Update Description -->
                        <p class="text-[#60768a] text-base leading-relaxed mb-4">
                          <%= item.description %>
                        </p>

                        <!-- Update Number -->
                        <div class="flex items-center justify-between">
                          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                            Update #<%= index + 1 %>
                          </span>
                          
                          <!-- Time Since Update -->
                          <div class="text-xs text-gray-500">
                            <%
                              const now = new Date();
                              const updateDate = new Date(item.date);
                              const diffTime = Math.abs(now - updateDate);
                              const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                              const diffHours = Math.ceil(diffTime / (1000 * 60 * 60));
                              
                              let timeAgo;
                              if (diffDays === 1) {
                                timeAgo = "Yesterday";
                              } else if (diffDays > 1) {
                                timeAgo = diffDays + " days ago";
                              } else if (diffHours === 1) {
                                timeAgo = "1 hour ago";
                              } else if (diffHours > 1) {
                                timeAgo = diffHours + " hours ago";
                              } else {
                                timeAgo = "Just now";
                              }
                            %>
                            <%= timeAgo %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="text-center py-12 bg-gray-50 rounded-xl border border-gray-200">
                  <div class="flex flex-col items-center gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
                    </svg>
                    <div>
                      <p class="text-gray-500 text-lg font-medium">No updates available</p>
                      <p class="text-gray-400 text-sm">Check back later for new announcements</p>
                    </div>
                  </div>
                </div>
              <% } %>
            </div>
          </div>

          <!-- Enhanced Pagination Section -->
          <% if (typeof currentPage !== 'undefined' && typeof totalPages !== 'undefined' && totalPages > 1) { %>
          <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <div class="flex items-center justify-between">
              <div class="text-sm text-gray-600">
                <% if (typeof update !== 'undefined' && update) { %>
                  Showing page <%= currentPage %> of <%= totalPages %>
                <% } %>
              </div>
              
              <div class="flex items-center gap-3">
                <!-- Previous Button -->
                <% if (currentPage > 1) { %>
                  <a href="?page=<%= currentPage - 1 %>" 
                     class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Previous
                  </a>
                <% } else { %>
                  <span class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 text-gray-400 rounded-lg font-medium cursor-not-allowed">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Previous
                  </span>
                <% } %>

                <!-- Page Numbers -->
                <div class="flex items-center gap-2">
                  <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
                    <% if (i === currentPage) { %>
                      <span class="px-3 py-2 bg-[#2a5298] text-white rounded-lg font-medium">
                        <%= i %>
                      </span>
                    <% } else { %>
                      <a href="?page=<%= i %>" 
                         class="px-3 py-2 border border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50 transition-colors">
                        <%= i %>
                      </a>
                    <% } %>
                  <% } %>
                </div>

                <!-- Next Button -->
                <% if (currentPage < totalPages) { %>
                  <a href="?page=<%= currentPage + 1 %>" 
                     class="inline-flex items-center gap-2 px-4 py-2 bg-[#2a5298] text-white rounded-lg font-medium hover:bg-[#1e3f7c] transition-colors">
                    Next
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                <% } else { %>
                  <span class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 text-gray-400 rounded-lg font-medium cursor-not-allowed">
                    Next
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </span>
                <% } %>
              </div>
            </div>
          </div>
          <% } %>

          <!-- Update Statistics -->
          <div class="mt-8 grid gap-6 md:grid-cols-3">
            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
              <div class="flex items-center gap-3">
                <div class="bg-blue-100 p-3 rounded-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-gray-600 text-sm">Total Updates</p>
                  <p class="text-2xl font-bold text-gray-900">
                    <%= typeof update !== 'undefined' && update ? update.length : 0 %>
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
              <div class="flex items-center gap-3">
                <div class="bg-green-100 p-3 rounded-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-gray-600 text-sm">This Week</p>
                  <p class="text-2xl font-bold text-gray-900">
                    <% if (typeof update !== 'undefined' && update) { %>
                      <%
                        const now = new Date();
                        const oneWeekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
                        const thisWeekUpdates = update.filter(item => new Date(item.date) >= oneWeekAgo);
                      %>
                      <%= thisWeekUpdates.length %>
                    <% } else { %>
                      0
                    <% } %>
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
              <div class="flex items-center gap-3">
                <div class="bg-yellow-100 p-3 rounded-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-gray-600 text-sm">Today</p>
                  <p class="text-2xl font-bold text-gray-900">
                    <% if (typeof update !== 'undefined' && update) { %>
                      <%
                        const today = new Date().toDateString();
                        const todayUpdates = update.filter(item => new Date(item.date).toDateString() === today);
                      %>
                      <%= todayUpdates.length %>
                    <% } else { %>
                      0
                    <% } %>
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="mt-8 bg-blue-50 rounded-xl border border-blue-200 p-6">
            <h3 class="text-lg font-bold text-[#111518] mb-4 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Stay Connected
            </h3>
            <div class="grid md:grid-cols-2 gap-4 text-sm">
              <div>
                <h4 class="font-semibold text-[#111518] mb-2">📢 Never Miss an Update</h4>
                <ul class="space-y-1 text-gray-700">
                  <li>• Check this page regularly for announcements</li>
                  <li>• Important updates are posted here first</li>
                  <li>• Follow club social media for instant notifications</li>
                </ul>
              </div>
              <div>
                <h4 class="font-semibold text-[#111518] mb-2">💡 Have Questions?</h4>
                <ul class="space-y-1 text-gray-700">
                  <li>• Contact club leaders for clarification</li>
                  <li>• Use the feedback form for suggestions</li>
                  <li>• Attend meetings for detailed discussions</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- JavaScript for Enhanced Functionality -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Add fade-in animation to update cards
      const updateCards = document.querySelectorAll('.bg-gray-50.rounded-xl');
      updateCards.forEach((card, index) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        
        setTimeout(() => {
          card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        }, index * 100);
      });

      // Enhanced hover effects for update cards
      updateCards.forEach(card => {
        card.addEventListener('mouseenter', function() {
          this.style.transform = 'translateY(-2px)';
          this.style.boxShadow = '0 8px 25px rgba(0,0,0,0.1)';
        });
        
        card.addEventListener('mouseleave', function() {
          this.style.transform = 'translateY(0)';
          this.style.boxShadow = 'none';
        });
      });

      // Add smooth scroll for pagination links
      const paginationLinks = document.querySelectorAll('a[href*="?page="]');
      paginationLinks.forEach(link => {
        link.addEventListener('click', function(e) {
          // Smooth scroll to top when changing pages
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });

      // Auto-refresh functionality (optional)
      let refreshInterval;
      const startAutoRefresh = () => {
        refreshInterval = setInterval(() => {
          // Optional: Check for new updates via AJAX
          console.log('Checking for new updates...');
        }, 300000); // Check every 5 minutes
      };

      const stopAutoRefresh = () => {
        if (refreshInterval) {
          clearInterval(refreshInterval);
        }
      };

      // Start auto-refresh when page is visible, stop when hidden
      document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
          stopAutoRefresh();
        } else {
          startAutoRefresh();
        }
      });

      // Start auto-refresh on page load
      startAutoRefresh();
    });
  </script>

</div>
</body>
</html>
