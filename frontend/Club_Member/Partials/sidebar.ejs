<!-- Mobile sidebar backdrop -->
<div class="fixed inset-0 bg-black bg-opacity-50 z-40 md:hidden hidden" id="sidebar-backdrop"></div>

<!-- Mobile menu button -->
<button class="md:hidden fixed top-4 left-4 z-50 bg-white p-2 rounded-lg shadow-lg border border-gray-200" id="mobile-menu-button">
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
  </svg>
</button>

<!-- JavaScript for Mobile Menu -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const menuButton = document.getElementById('mobile-menu-button');

    if (sidebar && backdrop && menuButton) {
      // Toggle mobile menu
      menuButton.addEventListener('click', function() {
        sidebar.classList.toggle('-translate-x-full');
        backdrop.classList.toggle('hidden');
      });

      // Close on backdrop click
      backdrop.addEventListener('click', function() {
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.add('hidden');
      });

      // Close on escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          sidebar.classList.add('-translate-x-full');
          backdrop.classList.add('hidden');
        }
      });
    }
  });
</script>
