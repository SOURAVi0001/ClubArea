                <p class="text-gray-600">Connect with our club leaders instantly via real-time chat.</p>
              </div>
              <!-- Connection Status Indicator -->
              <div class="flex items-center gap-2">
                <div id="connectionStatus" class="w-3 h-3 rounded-full bg-gray-400"></div>
                <span id="connectionText" class="text-sm text-gray-500">Connecting...</span>
              </div>
            </div>
          </header>

          <!-- Active Chats Summary -->
