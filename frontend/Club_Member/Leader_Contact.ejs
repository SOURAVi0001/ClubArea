  <!-- Enhanced Chat Modal -->
  <div id="chatModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg h-[600px] flex flex-col animate-scale-up">
      <!-- Chat Header -->
      <div class="flex items-center justify-between p-4 border-b border-gray-200 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-t-xl">
        <div class="flex items-center gap-3">
          <div class="relative">
            <img id="leaderAvatar" class="w-10 h-10 rounded-full border-2 border-white" alt="Leader Avatar">
            <div id="leaderOnlineStatus" class="absolute -bottom-1 -right-1 w-4 h-4 bg-green-500 border-2 border-white rounded-full"></div>
          </div>
          <div>
            <h3 id="leaderName" class="font-bold text-white"></h3>
            <p id="leaderPosition" class="text-xs text-blue-100"></p>
            <div class="flex items-center gap-1 mt-1">
              <div id="typingIndicator" class="hidden flex items-center gap-1 text-xs text-blue-200">
                <div class="flex gap-1">
                  <div class="w-1 h-1 bg-blue-200 rounded-full animate-bounce"></div>
                  <div class="w-1 h-1 bg-blue-200 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
                  <div class="w-1 h-1 bg-blue-200 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                </div>
                <span class="ml-1">typing...</span>
              </div>
              <span id="lastSeenIndicator" class="text-xs text-blue-200">Online</span>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <!-- Minimize Button -->
          <button id="minimizeChatModal" class="text-blue-100 hover:text-white p-1 rounded-full hover:bg-blue-800 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
            </svg>
          </button>
          <!-- Close Button -->
          <button id="closeChatModal" class="text-blue-100 hover:text-white p-1 rounded-full hover:bg-blue-800 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Chat Messages -->
      <div id="chatMessages" class="flex-1 overflow-y-auto p-4 space-y-3 bg-gray-50">
        <!-- Loading indicator -->
        <div id="loadingMessages" class="flex justify-center items-center py-8">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
          <span class="ml-3 text-gray-600">Loading messages...</span>
        </div>
        <!-- Messages will be populated here -->
      </div>

      <!-- Message Status Bar -->
      <div id="messageStatus" class="px-4 py-1 text-xs text-gray-500 bg-gray-100 border-t border-gray-200 hidden">
        <span id="messageStatusText"></span>
      </div>

      <!-- Chat Input -->
      <div class="p-4 border-t border-gray-200 bg-white rounded-b-xl">
        <!-- File Upload Preview -->
        <div id="filePreview" class="hidden mb-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
              </svg>
              <span id="fileName" class="text-sm text-gray-700"></span>
            </div>
            <button id="removeFile" class="text-red-500 hover:text-red-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Input Area -->
        <div class="flex gap-2 items-end">
          <!-- File Upload -->
          <div class="relative">
            <input type="file" id="fileInput" class="hidden" accept="image/*,.pdf,.doc,.docx,.txt">
            <button id="fileUploadBtn" class="p-2 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
              </svg>
            </button>
          </div>

          <!-- Message Input -->
          <div class="flex-1 relative">
            <textarea
              id="messageInput"
              placeholder="Type your message..."
              rows="1"
              class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-none max-h-32 transition-all"
            ></textarea>
            <div class="absolute bottom-2 right-2 text-xs text-gray-400">
              <span id="charCount">0</span>/500
            </div>
          </div>

          <!-- Send Button -->
          <button
            id="sendMessage"
            class="px-4 py-3 bg-blue-600 text-white rounded-xl hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-200 transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed"
            disabled
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
          </button>
        </div>

        <!-- Quick Replies -->
        <div id="quickReplies" class="mt-3 flex flex-wrap gap-2">
          <button class="quick-reply px-3 py-1 bg-gray-200 hover:bg-gray-300 text-gray-700 text-xs rounded-full transition-colors" data-message="Hello! I have a question.">
            👋 Hello!
          </button>
          <button class="quick-reply px-3 py-1 bg-gray-200 hover:bg-gray-300 text-gray-700 text-xs rounded-full transition-colors" data-message="Can you help me with something?">
            🤔 Need help
          </button>
          <button class="quick-reply px-3 py-1 bg-gray-200 hover:bg-gray-300 text-gray-700 text-xs rounded-full transition-colors" data-message="Thank you for your time!">
            🙏 Thank you
          </button>
          <button class="quick-reply px-3 py-1 bg-gray-200 hover:bg-gray-300 text-gray-700 text-xs rounded-full transition-colors" data-message="I'll check back later.">
            ⏰ Later
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Minimized Chat Notification -->
  <div id="minimizedChat" class="fixed bottom-4 right-4 bg-blue-600 text-white p-4 rounded-lg shadow-lg hidden cursor-pointer hover:bg-blue-700 transition-colors">
    <div class="flex items-center gap-3">
      <img id="minLeaderAvatar" class="w-8 h-8 rounded-full" alt="Leader">
      <div>
        <div class="font-medium text-sm" id="minLeaderName"></div>
        <div class="text-xs text-blue-200" id="minLastMessage">Click to open chat</div>
      </div>
      <div id="minUnreadCount" class="bg-red-500 text-xs px-2 py-1 rounded-full hidden">0</div>
    </div>
  </div>

  <!-- Toast Notifications -->
  <div id="toastContainer" class="fixed top-4 right-4 z-50 space-y-2">
    <!-- Toasts will be added here -->
  </div>

  <!-- Socket.IO and Enhanced JavaScript -->
  <script src="/socket.io/socket.io.js"></script>
  <script>
    // Initialize Socket.IO
    const socket = io();
    
    // User data - Replace with actual data from your session/auth system
    const currentUser = {
      id: '<%= typeof Member_ID !== "undefined" ? Member_ID : "member_12345" %>',
      name: '<%= typeof Member_Name !== "undefined" ? Member_Name : "Member Name" %>',
      type: 'member'
    };

    // Chat state
    let currentChatState = {
      leaderId: null,
      leaderName: null,
      isOpen: false,
      isMinimized: false,
      unreadCount: 0,
      lastMessageTime: null
    };

    // DOM Elements
    const elements = {
      chatModal: document.getElementById('chatModal'),
      minimizedChat: document.getElementById('minimizedChat'),
      closeChatModal: document.getElementById('closeChatModal'),
      minimizeChatModal: document.getElementById('minimizeChatModal'),
      messageInput: document.getElementById('messageInput'),
      sendMessage: document.getElementById('sendMessage'),
      chatMessages: document.getElementById('chatMessages'),
      fileInput: document.getElementById('fileInput'),
      fileUploadBtn: document.getElementById('fileUploadBtn'),
      filePreview: document.getElementById('filePreview'),
      loadingMessages: document.getElementById('loadingMessages'),
      typingIndicator: document.getElementById('typingIndicator'),
      connectionStatus: document.getElementById('connectionStatus'),
      connectionText: document.getElementById('connectionText'),
      charCount: document.getElementById('charCount'),
      unreadCount: document.getElementById('unreadCount'),
      activeChatsSection: document.getElementById('activeChatsSection')
    };

    document.addEventListener('DOMContentLoaded', function() {
      initializeSocketConnection();
      setupEventListeners();
      loadActiveChats();
      updateConnectionStatus();
    });

    // Initialize Socket Connection
    function initializeSocketConnection() {
      socket.on('connect', function() {
        console.log('Connected to server');
        updateConnectionStatus(true);
        socket.emit('joinRoom', {
          userId: currentUser.id,
          userType: currentUser.type
        });
      });

      socket.on('disconnect', function() {
        console.log('Disconnected from server');
        updateConnectionStatus(false);
      });

      socket.on('newMessage', function(data) {
        handleIncomingMessage(data);
      });

      socket.on('messageDelivered', function(data) {
        updateMessageStatus(data.messageId, 'delivered');
      });

      socket.on('messageRead', function(data) {
        updateMessageStatus(data.messageId, 'read');
      });

      socket.on('userTyping', function(data) {
        if (data.userId !== currentUser.id && data.chatRoom === getCurrentChatRoom()) {
          showTypingIndicator(data.userName);
        }
      });

      socket.on('userStoppedTyping', function(data) {
        if (data.userId !== currentUser.id && data.chatRoom === getCurrentChatRoom()) {
          hideTypingIndicator();
        }
      });

      socket.on('leaderStatusUpdate', function(data) {
        updateLeaderOnlineStatus(data.leaderId, data.status);
      });
    }

    // Setup Event Listeners
    function setupEventListeners() {
      // Chat button clicks
      document.querySelectorAll('.chat-button').forEach(button => {
        button.addEventListener('click', function() {
          const leaderData = {
            id: this.dataset.leaderId,
            name: this.dataset.leaderName,
            position: this.dataset.leaderPosition,
            email: this.dataset.leaderEmail,
            avatar: this.dataset.leaderAvatar
          };
          openChatModal(leaderData);
        });
      });

      // Modal controls
      elements.closeChatModal.addEventListener('click', closeChatModal);
      elements.minimizeChatModal.addEventListener('click', minimizeChatModal);
      elements.minimizedChat.addEventListener('click', function() {
        if (currentChatState.isMinimized) {
          restoreChatModal();
        }
      });

      // Message sending
      elements.sendMessage.addEventListener('click', sendMessage);
      elements.messageInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          sendMessage();
        }
      });

      // Character count and auto-resize
      elements.messageInput.addEventListener('input', function() {
        const length = this.value.length;
        elements.charCount.textContent = length;
        
        // Auto-resize textarea
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 120) + 'px';

        // Enable/disable send button
        elements.sendMessage.disabled = length === 0 || length > 500;
        
        // Show typing indicator
        if (currentChatState.isOpen && length > 0) {
          emitTyping(true);
        }
      });

      // Stop typing when focus lost
      elements.messageInput.addEventListener('blur', function() {
        emitTyping(false);
      });

      // File upload
      elements.fileUploadBtn.addEventListener('click', function() {
        elements.fileInput.click();
      });

      elements.fileInput.addEventListener('change', handleFileSelect);

      // Quick replies
      document.querySelectorAll('.quick-reply').forEach(button => {
        button.addEventListener('click', function() {
          elements.messageInput.value = this.dataset.message;
          elements.messageInput.focus();
          elements.messageInput.dispatchEvent(new Event('input'));
        });
      });

      // Close modal on outside click
      elements.chatModal.addEventListener('click', function(e) {
        if (e.target === elements.chatModal) {
          closeChatModal();
        }
      });

      // Keyboard shortcuts
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && currentChatState.isOpen) {
          closeChatModal();
        }
      });
    }

    // Open Chat Modal
    function openChatModal(leaderData) {
      currentChatState = {
        leaderId: leaderData.id,
        leaderName: leaderData.name,
        isOpen: true,
        isMinimized: false,
        unreadCount: 0
      };

      // Update modal header
      document.getElementById('leaderName').textContent = leaderData.name;
      document.getElementById('leaderPosition').textContent = leaderData.position;
      document.getElementById('leaderAvatar').src = leaderData.avatar;
      
      // Show modal with animation
      elements.chatModal.classList.remove('hidden');
      elements.chatModal.style.animation = 'fadeIn 0.3s ease-out';

      // Load chat history
      loadChatHistory(leaderData.id);

      // Focus on input
      setTimeout(() => {
        elements.messageInput.focus();
      }, 300);

      // Join chat room
      socket.emit('joinChatRoom', {
        chatRoom: getCurrentChatRoom(),
        userId: currentUser.id,
        userName: currentUser.name
      });
    }

    // Close Chat Modal
    function closeChatModal() {
      currentChatState.isOpen = false;
      currentChatState.isMinimized = false;
      elements.chatModal.classList.add('hidden');
      elements.minimizedChat.classList.add('hidden');
      
      // Leave chat room
      if (currentChatState.leaderId) {
        socket.emit('leaveChatRoom', {
          chatRoom: getCurrentChatRoom(),
          userId: currentUser.id
        });
      }
      
      emitTyping(false);
      clearChat();
    }

    // Minimize Chat Modal
    function minimizeChatModal() {
      currentChatState.isMinimized = true;
      elements.chatModal.classList.add('hidden');
      
      // Show minimized chat
      document.getElementById('minLeaderAvatar').src = document.getElementById('leaderAvatar').src;
      document.getElementById('minLeaderName').textContent = currentChatState.leaderName;
      elements.minimizedChat.classList.remove('hidden');
      
      emitTyping(false);
    }

    // Restore Chat Modal
    function restoreChatModal() {
      currentChatState.isMinimized = false;
      elements.minimizedChat.classList.add('hidden');
      elements.chatModal.classList.remove('hidden');
      elements.messageInput.focus();
      
      // Reset unread count
      currentChatState.unreadCount = 0;
      updateUnreadCounter();
    }

    // Send Message
    async function sendMessage() {
      const message = elements.messageInput.value.trim();
      if (!message || !currentChatState.leaderId || message.length > 500) return;

      const tempMessageId = 'temp_' + Date.now();
      
      try {
        // Add message to UI immediately (optimistic update)
        addMessageToUI({
          id: tempMessageId,
          senderName: currentUser.name,
          message: message,
          timestamp: new Date(),
          type: 'sent',
          status: 'sending'
        });

        // Clear input
        elements.messageInput.value = '';
        elements.messageInput.style.height = 'auto';
        elements.charCount.textContent = '0';
        elements.sendMessage.disabled = true;
        emitTyping(false);

        // Send to server
        const response = await fetch('/api/chat/send-message', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            leaderId: currentChatState.leaderId,
            message: message,
            senderName: currentUser.name,
            senderId: currentUser.id
          })
        });

        const result = await response.json();
        
        if (result.success) {
          // Update temp message with real ID
          updateMessageStatus(tempMessageId, 'sent', result.data._id);
          showToast('Message sent successfully', 'success');
        } else {
          throw new Error(result.message);
        }

      } catch (error) {
        console.error('Error sending message:', error);
        updateMessageStatus(tempMessageId, 'failed');
        showToast('Failed to send message. Please try again.', 'error');
      }
    }

    // Load Chat History
    async function loadChatHistory(leaderId) {
      try {
        elements.loadingMessages.classList.remove('hidden');
        
        const response = await fetch(`/api/chat/history/${leaderId}?senderId=${currentUser.id}&limit=50`);
        const result = await response.json();

        if (result.success) {
          elements.chatMessages.innerHTML = '';
          elements.loadingMessages.classList.add('hidden');
          
          if (result.data.length === 0) {
            showWelcomeMessage();
          } else {
            result.data.forEach(msg => {
              const messageType = msg.senderId === currentUser.id ? 'sent' : 'received';
              addMessageToUI({
                id: msg._id,
                senderName: msg.senderName,
                message: msg.message,
                timestamp: new Date(msg.createdAt),
                type: messageType,
                status: messageType === 'sent' ? 'delivered' : null
              });
            });
          }
          
          scrollToBottom();
        }

      } catch (error) {
        console.error('Error loading chat history:', error);
        elements.loadingMessages.innerHTML = '<div class="text-red-500 text-center">Failed to load messages</div>';
      }
    }

    // Add Message to UI
    function addMessageToUI(messageData) {
      const messageDiv = document.createElement('div');
      messageDiv.className = `message-container flex ${messageData.type === 'sent' ? 'justify-end' : 'justify-start'} animate-fade-in`;
      messageDiv.dataset.messageId = messageData.id;

      const timeStr = messageData.timestamp.toLocaleTimeString('en-US', { 
        hour: '2-digit', 
        minute: '2-digit' 
      });

      const statusIcon = messageData.type === 'sent' ? getStatusIcon(messageData.status) : '';

      messageDiv.innerHTML = `
        <div class="max-w-xs lg:max-w-md px-4 py-3 rounded-2xl ${
          messageData.type === 'sent' 
            ? 'bg-blue-600 text-white rounded-br-lg' 
            : 'bg-white border border-gray-200 text-gray-900 rounded-bl-lg'
        } shadow-sm">
          ${messageData.type === 'received' ? `
            <div class="text-xs ${messageData.type === 'sent' ? 'text-blue-200' : 'text-gray-500'} mb-1 font-medium">
              ${messageData.senderName}
            </div>
          ` : ''}
          <div class="text-sm leading-relaxed break-words">
            ${messageData.message}
          </div>
          <div class="flex items-center justify-between mt-2">
            <div class="text-xs ${messageData.type === 'sent' ? 'text-blue-200' : 'text-gray-400'}">
              ${timeStr}
            </div>
            ${messageData.type === 'sent' ? `
              <div class="message-status text-xs ${messageData.type === 'sent' ? 'text-blue-200' : 'text-gray-400'}">
                ${statusIcon}
              </div>
            ` : ''}
          </div>
        </div>
      `;

      elements.chatMessages.appendChild(messageDiv);
      scrollToBottom();
      
      // Remove loading messages if they exist
      elements.loadingMessages.classList.add('hidden');
    }

    // Handle Incoming Messages
    function handleIncomingMessage(data) {
      if (data.chatRoom === getCurrentChatRoom()) {
        addMessageToUI({
          id: data.messageId,
          senderName: data.senderName,
          message: data.message,
          timestamp: new Date(data.timestamp),
          type: 'received'
        });

        // Mark as read if chat is open
        if (currentChatState.isOpen && !currentChatState.isMinimized) {
          markMessageAsRead(data.messageId);
        } else {
          currentChatState.unreadCount++;
          updateUnreadCounter();
          showNotification(data.senderName, data.message);
        }

        // Play notification sound
        playNotificationSound();
      } else {
        // Handle messages from other chats
        showToast(`New message from ${data.senderName}`, 'info');
      }
    }

    // Helper Functions
    function getCurrentChatRoom() {
      if (!currentChatState.leaderId) return null;
      return [currentUser.id, currentChatState.leaderId].sort().join('_');
    }

    function getStatusIcon(status) {
      switch (status) {
        case 'sending':
          return '<svg class="w-3 h-3 animate-spin inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2"></path></svg>';
        case 'sent':
          return '<svg class="w-3 h-3 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
        case 'delivered':
          return '<svg class="w-3 h-3 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg><svg class="w-3 h-3 inline -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
        case 'read':
          return '<svg class="w-3 h-3 inline text-blue-400" fill="currentColor" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg><svg class="w-3 h-3 inline -ml-1 text-blue-400" fill="currentColor" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
        case 'failed':
          return '<svg class="w-3 h-3 inline text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>';
        default:
          return '';
      }
    }

    function updateMessageStatus(messageId, status, newId = null) {
      const messageElement = document.querySelector(`[data-message-id="${messageId}"]`);
      if (messageElement) {
        if (newId) {
          messageElement.dataset.messageId = newId;
        }
        const statusElement = messageElement.querySelector('.message-status');
        if (statusElement) {
          statusElement.innerHTML = getStatusIcon(status);
        }
      }
    }

    function scrollToBottom() {
      elements.chatMessages.scrollTop = elements.chatMessages.scrollHeight;
    }

    function clearChat() {
      elements.chatMessages.innerHTML = '';
      elements.messageInput.value = '';
      elements.charCount.textContent = '0';
      currentChatState.leaderId = null;
      currentChatState.leaderName = null;
    }

    function showWelcomeMessage() {
      const welcomeDiv = document.createElement('div');
      welcomeDiv.className = 'flex justify-center py-8';
      welcomeDiv.innerHTML = `
        <div class="text-center max-w-xs">
          <div class="bg-blue-100 p-4 rounded-full w-16 h-16 mx-auto mb-4 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Start the conversation!</h3>
          <p class="text-sm text-gray-600">Send a message to ${currentChatState.leaderName} to get started.</p>
        </div>
      `;
      elements.chatMessages.appendChild(welcomeDiv);
    }

    function emitTyping(isTyping) {
      if (currentChatState.leaderId) {
        socket.emit(isTyping ? 'startTyping' : 'stopTyping', {
          chatRoom: getCurrentChatRoom(),
          userId: currentUser.id,
          userName: currentUser.name
        });
      }
    }

    function showTypingIndicator(userName) {
      elements.typingIndicator.classList.remove('hidden');
      elements.lastSeenIndicator.classList.add('hidden');
    }

    function hideTypingIndicator() {
      elements.typingIndicator.classList.add('hidden');
      elements.lastSeenIndicator.classList.remove('hidden');
    }

    function updateConnectionStatus(isConnected = false) {
      if (isConnected) {
        elements.connectionStatus.className = 'w-3 h-3 rounded-full bg-green-500';
        elements.connectionText.textContent = 'Connected';
        elements.connectionText.className = 'text-sm text-green-600';
      } else {
        elements.connectionStatus.className = 'w-3 h-3 rounded-full bg-red-500';
        elements.connectionText.textContent = 'Disconnected';
        elements.connectionText.className = 'text-sm text-red-600';
      }
    }

    function updateUnreadCounter() {
      const count = currentChatState.unreadCount;
      const minCount = document.getElementById('minUnreadCount');
      
      if (count > 0) {
        elements.unreadCount.textContent = count;
        elements.unreadCount.classList.remove('hidden');
        if (minCount) {
          minCount.textContent = count;
          minCount.classList.remove('hidden');
        }
      } else {
        elements.unreadCount.classList.add('hidden');
        if (minCount) {
          minCount.classList.add('hidden');
        }
      }
    }

    function showToast(message, type = 'info', duration = 3000) {
      const toast = document.createElement('div');
      toast.className = `toast-notification p-4 rounded-lg shadow-lg transform transition-all duration-300 translate-x-full ${
        type === 'success' ? 'bg-green-500 text-white' :
        type === 'error' ? 'bg-red-500 text-white' :
        type === 'warning' ? 'bg-yellow-500 text-white' :
        'bg-blue-500 text-white'
      }`;
      
      toast.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="text-sm font-medium">${message}</span>
          <button class="ml-2 text-white hover:text-gray-200" onclick="this.parentElement.parentElement.remove()">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      `;

      document.getElementById('toastContainer').appendChild(toast);
      
      // Animate in
      setTimeout(() => {
        toast.classList.remove('translate-x-full');
      }, 100);

      // Auto remove
      setTimeout(() => {
        toast.classList.add('translate-x-full');
        setTimeout(() => {
          toast.remove();
        }, 300);
      }, duration);
    }

    function playNotificationSound() {
      // Create a subtle notification sound
      const audioContext = new (window.AudioContext || window.webkitAudioContext)();
      const oscillator = audioContext.createOscillator();
      const gainNode = audioContext.createGain();
      
      oscillator.connect(gainNode);
      gainNode.connect(audioContext.destination);
      
      oscillator.frequency.value = 800;
      oscillator.type = 'sine';
      
      gainNode.gain.setValueAtTime(0, audioContext.currentTime);
      gainNode.gain.linearRampToValueAtTime(0.1, audioContext.currentTime + 0.01);
      gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
      
      oscillator.start(audioContext.currentTime);
      oscillator.stop(audioContext.currentTime + 0.3);
    }

    function markMessageAsRead(messageId) {
      socket.emit('markAsRead', {
        messageId: messageId,
        userId: currentUser.id
      });
    }

    function loadActiveChats() {
      // This would typically load from your API
      // For now, we'll show the section if there are any recent chats
      // You can implement this based on your backend API
    }

    function handleFileSelect() {
      const file = elements.fileInput.files[0];
      if (file) {
        // Show file preview
        document.getElementById('fileName').textContent = file.name;
        elements.filePreview.classList.remove('hidden');
        
        // You can implement file upload logic here
        // For example, upload to your server and then send the file URL as a message
      }
    }

    // Remove file preview
    document.getElementById('removeFile').addEventListener('click', function() {
      elements.fileInput.value = '';
      elements.filePreview.classList.add('hidden');
    });

    function updateLeaderOnlineStatus(leaderId, status) {
      // Update online status indicators for leaders
      const statusElement = document.getElementById(`status-${leaderId.split('_')[0]}`);
      if (statusElement) {
        statusElement.className = `absolute bottom-0 right-0 w-5 h-5 border-2 border-white rounded-full ${
          status === 'online' ? 'bg-green-500' :
          status === 'away' ? 'bg-yellow-500' : 'bg-gray-400'
        }`;
      }
    }

    function showNotification(senderName, message) {
      if (Notification.permission === 'granted') {
        new Notification(`New message from ${senderName}`, {
          body: message.substring(0, 100) + (message.length > 100 ? '...' : ''),
          icon: '/path/to/club-icon.png'
        });
      }
    }

    // Request notification permission
    if (Notification.permission !== 'granted' && Notification.permission !== 'denied') {
      Notification.requestPermission();
    }

  </script>

  <!-- Custom Styles -->
  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes scale-up {
      from { transform: scale(0.95); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .animate-fade-in {
      animation: fadeIn 0.3s ease-out;
    }

    .animate-scale-up {
      animation: scale-up 0.2s ease-out;
    }

    /* Custom scrollbar for chat messages */
    #chatMessages::-webkit-scrollbar {
      width: 4px;
    }

    #chatMessages::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 2px;
    }

    #chatMessages::-webkit-scrollbar-thumb {
      background: #c1c1c1;
      border-radius: 2px;
    }

    #chatMessages::-webkit-scrollbar-thumb:hover {
      background: #a1a1a1;
    }

    /* Auto-resize textarea */
    #messageInput {
      resize: none;
      overflow: hidden;
    }
  </style>

</div>
</body>
</html>
