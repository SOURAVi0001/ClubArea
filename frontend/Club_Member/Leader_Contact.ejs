                </svg>
              </div>
              Recent Conversations
              <span id="unreadCount" class="ml-auto bg-red-500 text-white text-xs px-2 py-1 rounded-full hidden">0</span>
            </h3>
            <div id="activeChats" class="space-y-3">
              <!-- Active chats will be populated here -->
            </div>
          </div>

