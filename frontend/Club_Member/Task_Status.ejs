<%- include("Partials/starter.ejs", { pageTitle: 'Member Task Status' }) %>

<div class="relative flex size-full min-h-screen flex-col bg-gray-50 group/design-root overflow-x-hidden" style='font-family: "Plus Jakarta Sans", "Noto Sans", sans-serif;'>
  
  <!-- Include the sidebar partial with proper parameters -->
  <%- include('Partials/sidebar.ejs', { 
    Member_Name: typeof Member_Name !== 'undefined' ? Member_Name : 'Member Name',
    Club_Name: typeof Club_Name !== 'undefined' ? Club_Name : 'Club Name',
    currentPage: 'tasks' 
  }) %>

  <!-- Main Content Area with responsive margin and mobile spacing -->
  <main class="ml-0 md:ml-80 min-h-screen">
    <!-- Mobile spacing to account for mobile toggle button -->
    <div class="pt-16 md:pt-0">
      <div class="layout-container flex h-full grow flex-col">
        <div class="gap-1 px-4 sm:px-6 lg:px-8 flex flex-1 justify-center py-5">
          <div class="layout-content-container flex flex-col max-w-[960px] flex-1 w-full">
            
            <!-- Enhanced Responsive Page Header -->
            <header class="mb-6 sm:mb-8">
              <div class="flex flex-col gap-3 sm:gap-4">
                <div>
                  <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#181111] mb-2">Team Tasks</h1>
                  <p class="text-sm sm:text-base text-gray-600">Monitor and manage all team task assignments and progress.</p>
                </div>
              </div>
            </header>

            <!-- Enhanced Responsive Search Section -->
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 sm:p-6 mb-6 sm:mb-8">
              <h3 class="text-base sm:text-lg font-bold text-[#181111] mb-4 flex items-center gap-2">
                <div class="bg-blue-100 p-2 rounded-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                </div>
                <span class="text-sm sm:text-base">Search Tasks</span>
              </h3>
              
              <form method="GET" action="/member/task-status" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
                <div class="flex-1 relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                  </div>
                  <input
                    name="search"
                    type="text"
                    placeholder="Search tasks by title, assignee, or description..."
                    class="w-full pl-10 pr-4 py-3 rounded-lg border border-gray-300 bg-gray-50 text-[#181111] 
                           placeholder:text-gray-500 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 
                           focus:bg-white transition-all duration-200 text-sm sm:text-base"
                    value="<%= typeof search !== 'undefined' ? search : '' %>"
                  />
                </div>
                <button
                  type="submit"
                  class="px-4 sm:px-6 py-3 bg-[#2a5298] text-white rounded-lg font-medium hover:bg-[#1e3f7c] 
                         transition-colors flex items-center justify-center gap-2 text-sm sm:text-base min-w-[100px] sm:min-w-[120px]"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                  <span class="hidden sm:inline">Search</span>
                  <span class="sm:hidden">Go</span>
                </button>
              </form>
            </div>

            <!-- Responsive Tasks Table Section -->
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-6 sm:mb-8">
              <div class="p-4 sm:p-6 border-b border-gray-200">
                <h3 class="text-lg sm:text-xl font-bold text-[#181111] flex items-center gap-2">
                  <div class="bg-green-100 p-2 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                    </svg>
                  </div>
                  <span class="text-sm sm:text-base lg:text-lg">Task Overview</span>
                  <span class="ml-auto text-xs sm:text-sm font-normal text-gray-500">
                    <%= typeof data !== 'undefined' ? data.length : 0 %> task<%= typeof data !== 'undefined' && data.length !== 1 ? 's' : '' %>
                  </span>
                </h3>
              </div>

              <!-- Desktop Table View -->
              <div class="hidden lg:block overflow-x-auto">
                <table class="w-full">
                  <thead class="bg-gray-50">
                    <tr>
                      <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Task</th>
                      <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Assigned To</th>
                      <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Description</th>
                      <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Last Completed</th>
                      <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Status</th>
                      <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
                    </tr>
                  </thead>
                  <tbody class="bg-white divide-y divide-gray-200">
                    <% if (typeof data === 'undefined' || data.length === 0) { %>
                      <tr>
                        <td colspan="6" class="px-6 py-12 text-center">
                          <div class="flex flex-col items-center gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                            <div>
                              <p class="text-gray-500 text-lg font-medium">No tasks found</p>
                              <p class="text-gray-400 text-sm">Try adjusting your search criteria</p>
                            </div>
                          </div>
                        </td>
                      </tr>
                    <% } else { %>
                      <% data.forEach(function(item, index) { %>
                        <tr class="hover:bg-gray-50 transition-colors">
                          <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                              <div class="bg-blue-100 p-2 rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                </svg>
                              </div>
                              <div>
                                <p class="text-[#181111] text-sm font-semibold"><%= item.title %></p>
                                <p class="text-gray-500 text-xs">Task #<%= index + 1 %></p>
                              </div>
                            </div>
                          </td>
                          <td class="px-6 py-4">
                            <div class="flex items-center gap-2">
                              <div class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center">
                                <span class="text-gray-600 font-medium text-xs">
                                  <%= item.assigned_to ? item.assigned_to.charAt(0).toUpperCase() : '?' %>
                                </span>
                              </div>
                              <span class="text-[#181111] text-sm font-medium">
                                <%= item.assigned_to || 'Unassigned' %>
                              </span>
                            </div>
                          </td>
                          <td class="px-6 py-4">
                            <p class="text-gray-600 text-sm max-w-xs truncate" title="<%= item.description %>">
                              <%= item.description %>
                            </p>
                          </td>
                          <td class="px-6 py-4">
                            <div class="flex items-center gap-2">
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7H3v12a2 2 0 0 0 2 2Z"/>
                              </svg>
                              <span class="text-gray-600 text-sm">
                                <%= item.task_completion_date ? 
                                    (item.task_completion_date.toDateString ? item.task_completion_date.toDateString() : item.task_completion_date) : 
                                    'Not completed' %>
                              </span>
                            </div>
                          </td>
                          <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                              <div class="w-20 bg-gray-200 rounded-full h-2 overflow-hidden">
                                <div 
                                  class="h-2 rounded-full transition-all duration-300
                                         <%= item.task_status >= 100 ? 'bg-green-500' : 
                                             item.task_status >= 75 ? 'bg-blue-500' : 
                                             item.task_status >= 50 ? 'bg-yellow-500' : 
                                             item.task_status >= 25 ? 'bg-orange-500' : 'bg-red-500' %>"
                                  style="width: <%= Math.min(item.task_status || 0, 100) %>%">
                                </div>
                              </div>
                              <span class="text-sm font-semibold
                                           <%= item.task_status >= 100 ? 'text-green-600' : 
                                               item.task_status >= 75 ? 'text-blue-600' : 
                                               item.task_status >= 50 ? 'text-yellow-600' : 
                                               item.task_status >= 25 ? 'text-orange-600' : 'text-red-600' %>">
                                <%= item.task_status || 0 %>%
                              </span>
                            </div>
                          </td>
                          <td class="px-6 py-4">
                            <a 
                              href="/View-Details/<%= item._id %>"
                              class="inline-flex items-center gap-2 px-3 py-2 text-sm font-medium text-[#2a5298] 
                                     hover:text-[#1e3f7c] hover:bg-blue-50 rounded-lg transition-colors"
                            >
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                              </svg>
                              View Details
                            </a>
                          </td>
                        </tr>
                      <% }); %>
                    <% } %>
                  </tbody>
                </table>
              </div>

              <!-- Mobile/Tablet Card View -->
              <div class="lg:hidden">
                <% if (typeof data === 'undefined' || data.length === 0) { %>
                  <div class="p-6 sm:p-8 text-center">
                    <div class="flex flex-col items-center gap-3">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                      </svg>
                      <div>
                        <p class="text-gray-500 text-lg font-medium">No tasks found</p>
                        <p class="text-gray-400 text-sm">Try adjusting your search criteria</p>
                      </div>
                    </div>
                  </div>
                <% } else { %>
                  <div class="divide-y divide-gray-200">
                    <% data.forEach(function(item, index) { %>
                      <div class="p-4 sm:p-6 hover:bg-gray-50 transition-colors">
                        <!-- Task Header -->
                        <div class="flex items-start justify-between mb-3">
                          <div class="flex items-center gap-3 flex-1 min-w-0">
                            <div class="bg-blue-100 p-2 rounded-lg flex-shrink-0">
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                              </svg>
                            </div>
                            <div class="min-w-0 flex-1">
                              <h4 class="text-[#181111] text-sm sm:text-base font-semibold truncate"><%= item.title %></h4>
                              <p class="text-gray-500 text-xs sm:text-sm">Task #<%= index + 1 %></p>
                            </div>
                          </div>
                          <!-- Status Badge -->
                          <div class="flex items-center gap-2 flex-shrink-0 ml-3">
                            <div class="w-16 sm:w-20 bg-gray-200 rounded-full h-2 overflow-hidden">
                              <div 
                                class="h-2 rounded-full transition-all duration-300
                                       <%= item.task_status >= 100 ? 'bg-green-500' : 
                                           item.task_status >= 75 ? 'bg-blue-500' : 
                                           item.task_status >= 50 ? 'bg-yellow-500' : 
                                           item.task_status >= 25 ? 'bg-orange-500' : 'bg-red-500' %>"
                                style="width: <%= Math.min(item.task_status || 0, 100) %>%">
                              </div>
                            </div>
                            <span class="text-xs sm:text-sm font-semibold
                                         <%= item.task_status >= 100 ? 'text-green-600' : 
                                             item.task_status >= 75 ? 'text-blue-600' : 
                                             item.task_status >= 50 ? 'text-yellow-600' : 
                                             item.task_status >= 25 ? 'text-orange-600' : 'text-red-600' %>">
                              <%= item.task_status || 0 %>%
                            </span>
                          </div>
                        </div>

                        <!-- Task Details -->
                        <div class="space-y-2 mb-4">
                          <!-- Assigned To -->
                          <div class="flex items-center gap-2">
                            <div class="w-6 h-6 sm:w-8 sm:h-8 bg-gray-200 rounded-full flex items-center justify-center flex-shrink-0">
                              <span class="text-gray-600 font-medium text-xs">
                                <%= item.assigned_to ? item.assigned_to.charAt(0).toUpperCase() : '?' %>
                              </span>
                            </div>
                            <span class="text-[#181111] text-xs sm:text-sm font-medium">
                              <%= item.assigned_to || 'Unassigned' %>
                            </span>
                          </div>
                          
                          <!-- Description -->
                          <p class="text-gray-600 text-xs sm:text-sm leading-relaxed">
                            <%= item.description %>
                          </p>
                          
                          <!-- Last Completed -->
                          <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7H3v12a2 2 0 0 0 2 2Z"/>
                            </svg>
                            <span class="text-gray-600 text-xs sm:text-sm">
                              Last completed: <%= item.task_completion_date ? 
                                  (item.task_completion_date.toDateString ? item.task_completion_date.toDateString() : item.task_completion_date) : 
                                  'Not completed' %>
                            </span>
                          </div>
                        </div>

                        <!-- Action Button -->
                        <div class="flex justify-end">
                          <a 
                            href="/View-Details/<%= item._id %>"
                            class="inline-flex items-center gap-2 px-3 py-2 text-xs sm:text-sm font-medium text-[#2a5298] 
                                   hover:text-[#1e3f7c] hover:bg-blue-50 rounded-lg transition-colors"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                            View Details
                          </a>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Responsive Pagination Section -->
            <% if (typeof hasMore !== 'undefined' || (typeof limit !== 'undefined' && limit > 3)) { %>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 sm:p-6 mb-6 sm:mb-8">
              <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="text-xs sm:text-sm text-gray-600 order-2 sm:order-1">
                  <% if (typeof data !== 'undefined') { %>
                    Showing <%= Math.min(limit || 3, data.length) %> of <%= data.length %> tasks
                  <% } %>
                </div>
                
                <div class="flex gap-3 order-1 sm:order-2">
                  <% if (typeof limit !== 'undefined' && limit > 3) { %>
                    <form method="GET" action="/member/task-status" class="inline">
                      <input type="hidden" name="limit" value="3" />
                      <% if (typeof search !== 'undefined' && search) { %>
                        <input type="hidden" name="search" value="<%= search %>" />
                      <% } %>
                      <button 
                        type="submit" 
                        class="px-3 sm:px-4 py-2 border border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50 transition-colors text-xs sm:text-sm"
                      >
                        Show Less
                      </button>
                    </form>
                  <% } %>

                  <% if (typeof hasMore !== 'undefined' && hasMore) { %>
                    <form method="GET" action="/member/task-status" class="inline">
                      <input type="hidden" name="limit" value="<%= (limit || 3) + 3 %>" />
                      <% if (typeof search !== 'undefined' && search) { %>
                        <input type="hidden" name="search" value="<%= search %>" />
                      <% } %>
                      <button 
                        type="submit" 
                        class="px-3 sm:px-4 py-2 bg-[#2a5298] text-white rounded-lg font-medium hover:bg-[#1e3f7c] transition-colors text-xs sm:text-sm"
                      >
                        Show More
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
            <% } %>

            <!-- Responsive Quick Stats Cards -->
            <div class="grid gap-4 sm:gap-6 grid-cols-2 lg:grid-cols-4">
              <div class="bg-white rounded-lg border border-gray-200 p-4 sm:p-6 shadow-sm">
                <div class="flex items-center gap-2 sm:gap-3">
                  <div class="bg-blue-100 p-2 sm:p-3 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-6 sm:w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-gray-600 text-xs sm:text-sm">Total Tasks</p>
                    <p class="text-lg sm:text-2xl font-bold text-gray-900 truncate">
                      <%= typeof data !== 'undefined' ? data.length : 0 %>
                    </p>
                  </div>
                </div>
              </div>

              <div class="bg-white rounded-lg border border-gray-200 p-4 sm:p-6 shadow-sm">
                <div class="flex items-center gap-2 sm:gap-3">
                  <div class="bg-green-100 p-2 sm:p-3 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-6 sm:w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-gray-600 text-xs sm:text-sm">Completed</p>
                    <p class="text-lg sm:text-2xl font-bold text-gray-900 truncate">
                      <% if (typeof data !== 'undefined') { %>
                        <%= data.filter(task => task.task_status >= 100).length %>
                      <% } else { %>
                        0
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>

              <div class="bg-white rounded-lg border border-gray-200 p-4 sm:p-6 shadow-sm">
                <div class="flex items-center gap-2 sm:gap-3">
                  <div class="bg-yellow-100 p-2 sm:p-3 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-6 sm:w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-gray-600 text-xs sm:text-sm">In Progress</p>
                    <p class="text-lg sm:text-2xl font-bold text-gray-900 truncate">
                      <% if (typeof data !== 'undefined') { %>
                        <%= data.filter(task => task.task_status > 0 && task.task_status < 100).length %>
                      <% } else { %>
                        0
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>

              <div class="bg-white rounded-lg border border-gray-200 p-4 sm:p-6 shadow-sm">
                <div class="flex items-center gap-2 sm:gap-3">
                  <div class="bg-red-100 p-2 sm:p-3 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-6 sm:w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.268 15.5c-.77.833.192 2.5 1.732 2.5z"/>
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-gray-600 text-xs sm:text-sm">Pending</p>
                    <p class="text-lg sm:text-2xl font-bold text-gray-900 truncate">
                      <% if (typeof data !== 'undefined') { %>
                        <%= data.filter(task => task.task_status === 0 || !task.task_status).length %>
                      <% } else { %>
                        0
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Enhanced JavaScript for Responsive Functionality -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Progress bar animations
      const progressBars = document.querySelectorAll('[style*="width:"]');
      progressBars.forEach(bar => {
        const width = bar.style.width;
        bar.style.width = '0%';
        setTimeout(() => {
          bar.style.width = width;
          bar.style.transition = 'width 1s ease-in-out';
        }, 100);
      });

      // Enhanced search functionality
      const searchForm = document.querySelector('form[action="/member/task-status"]');
      const searchInput = searchForm ? searchForm.querySelector('input[name="search"]') : null;

      if (searchInput) {
        // Add real-time search with debounce
        let searchTimeout;
        searchInput.addEventListener('input', function() {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            // Optional: implement real-time filtering here
          }, 300);
        });

        // Add keyboard shortcuts
        document.addEventListener('keydown', function(e) {
          if (e.ctrlKey && e.key === 'k') {
            e.preventDefault();
            searchInput.focus();
          }
        });
      }

      // Add hover effects to cards and table rows
      const interactiveElements = document.querySelectorAll('.hover\\:bg-gray-50');
      interactiveElements.forEach(element => {
        element.addEventListener('mouseenter', function() {
          if (window.innerWidth >= 1024) { // Only on desktop
            this.style.transform = 'translateY(-1px)';
            this.style.boxShadow = '0 4px 8px rgba(0,0,0,0.1)';
          }
        });
        
        element.addEventListener('mouseleave', function() {
          this.style.transform = 'translateY(0)';
          this.style.boxShadow = 'none';
        });
      });

      // Handle responsive layout changes
      function handleResize() {
        const width = window.innerWidth;
        
        // Adjust elements based on screen size
        if (width < 640) {
          // Extra small screens
          document.body.classList.add('xs-screen');
        } else {
          document.body.classList.remove('xs-screen');
        }
      }

      // Initial call and event listener
      handleResize();
      window.addEventListener('resize', handleResize);

      // Touch-friendly interactions for mobile
      if ('ontouchstart' in window) {
        // Add touch-specific styles or behaviors
        document.body.classList.add('touch-device');
      }
    });
  </script>

  <!-- Enhanced responsive styles -->
  <style>
    /* Ensure smooth transitions on all interactive elements */
    .transition-colors {
      transition-property: color, background-color, border-color;
      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      transition-duration: 150ms;
    }

    /* Better table overflow handling on mobile */
    @media (max-width: 1023px) {
      .overflow-x-auto {
        -webkit-overflow-scrolling: touch;
      }
    }

    /* Ensure text doesn't break layouts on very small screens */
    @media (max-width: 320px) {
      .truncate {
        max-width: 120px;
      }
    }

    /* Custom scrollbar for better UX */
    .overflow-x-auto::-webkit-scrollbar {
      height: 6px;
    }

    .overflow-x-auto::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 3px;
    }

    .overflow-x-auto::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 3px;
    }

    .overflow-x-auto::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Touch device optimizations */
    .touch-device button,
    .touch-device a {
      min-height: 44px; /* Minimum touch target size */
    }

    /* Loading animation for progress bars */
    @keyframes progressLoad {
      from { width: 0%; }
      to { width: var(--target-width); }
    }
  </style>
</div>

</body>
</html>
