<%- include("./Partials/starter.ejs") %>

<div class="relative flex size-full min-h-screen flex-col bg-gray-50 group/design-root overflow-x-hidden" style='font-family: "Plus Jakarta Sans", "Noto Sans", sans-serif;'>
  
  <!-- Include the sidebar partial with proper parameters -->
  <%- include('Partials/sidebar', { 
    Member_Name: typeof Member_Name !== 'undefined' ? Member_Name : 'Member Name',
    Club_Name: typeof Club_Name !== 'undefined' ? Club_Name : 'Club Name',
    currentPage: 'tasks' 
  }) %>

  <!-- Main Content Area with margin for sidebar -->
  <main class="ml-0 md:ml-80 min-h-screen">
    <div class="layout-container flex h-full grow flex-col">
      <div class="gap-1 px-6 flex flex-1 justify-center py-5">

        
        <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
          
          <!-- Enhanced Page Header -->
          <header class="mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <div>
                <h1 class="text-4xl font-bold text-[#181111] mb-2">Team Tasks</h1>
                <p class="text-gray-600">Monitor and manage all team task assignments and progress.</p>
              </div>
            </div>
          </header>

          <!-- Enhanced Search Section -->
          <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-8">
            <h3 class="text-lg font-bold text-[#181111] mb-4 flex items-center gap-2">
              <div class="bg-blue-100 p-2 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
              Search Tasks
            </h3>
            
            <form method="GET" action="/member/task-status" class="flex items-center gap-4">
              <div class="flex-1 relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                </div>
                <input
                  name="search"
                  type="text"
                  placeholder="Search tasks by title, assignee, or description..."
                  class="w-full pl-10 pr-4 py-3 rounded-lg border border-gray-300 bg-gray-50 text-[#181111] 
                         placeholder:text-gray-500 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 
                         focus:bg-white transition-all duration-200"
                  value="<%= typeof search !== 'undefined' ? search : '' %>"
                />
              </div>
              <button
                type="submit"
                class="px-6 py-3 bg-[#2a5298] text-white rounded-lg font-medium hover:bg-[#1e3f7c] 
                       transition-colors flex items-center gap-2"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                Search
              </button>
            </form>
          </div>

          <!-- Tasks Table Section -->
          <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-8">
            <div class="p-6 border-b border-gray-200">
              <h3 class="text-xl font-bold text-[#181111] flex items-center gap-2">
                <div class="bg-green-100 p-2 rounded-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                  </svg>
                </div>
                Task Overview
                <span class="ml-auto text-sm font-normal text-gray-500">
                  <%= typeof data !== 'undefined' ? data.length : 0 %> task<%= typeof data !== 'undefined' && data.length !== 1 ? 's' : '' %>
                </span>
              </h3>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                      Task
                    </th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                      Assigned To
                    </th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                      Description
                    </th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                      Last Completed
                    </th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                      Status
                    </th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                      Actions
                    </th>
                  </tr>
                </thead>

                <tbody class="bg-white divide-y divide-gray-200">
                  <% if (typeof data === 'undefined' || data.length === 0) { %>
                    <tr>
                      <td colspan="6" class="px-6 py-12 text-center">
                        <div class="flex flex-col items-center gap-3">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                          </svg>
                          <div>
                            <p class="text-gray-500 text-lg font-medium">No tasks found</p>
                            <p class="text-gray-400 text-sm">Try adjusting your search criteria</p>
                          </div>
                        </div>
                      </td>
                    </tr>
                  <% } else { %>
                    <% data.forEach(function(item, index) { %>
                      <tr class="hover:bg-gray-50 transition-colors">
                        <!-- Task Title -->
                        <td class="px-6 py-4">
                          <div class="flex items-center gap-3">
                            <div class="bg-blue-100 p-2 rounded-lg">
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                              </svg>
                            </div>
                            <div>
                              <p class="text-[#181111] text-sm font-semibold"><%= item.title %></p>
                              <p class="text-gray-500 text-xs">Task #<%= index + 1 %></p>
                            </div>
                          </div>
                        </td>

                        <!-- Assigned To -->
                        <td class="px-6 py-4">
                          <div class="flex items-center gap-2">
                            <div class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center">
                              <span class="text-gray-600 font-medium text-xs">
                                <%= item.assigned_to ? item.assigned_to.charAt(0).toUpperCase() : '?' %>
                              </span>
                            </div>
                            <span class="text-[#181111] text-sm font-medium">
                              <%= item.assigned_to || 'Unassigned' %>
                            </span>
                          </div>
                        </td>

                        <!-- Description -->
                        <td class="px-6 py-4">
                          <p class="text-gray-600 text-sm max-w-xs truncate" title="<%= item.description %>">
                            <%= item.description %>
                          </p>
                        </td>

                        <!-- Last Completed -->
                        <td class="px-6 py-4">
                          <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7H3v12a2 2 0 0 0 2 2Z"/>
                            </svg>
                            <span class="text-gray-600 text-sm">
                              <%= item.task_completion_date ? 
                                  (item.task_completion_date.toDateString ? item.task_completion_date.toDateString() : item.task_completion_date) : 
                                  'Not completed' %>
                            </span>
                          </div>
                        </td>

                        <!-- Status -->
                        <td class="px-6 py-4">
                          <div class="flex items-center gap-3">
                            <div class="w-20 bg-gray-200 rounded-full h-2 overflow-hidden">
                              <div 
                                class="h-2 rounded-full transition-all duration-300
                                       <%= item.task_status >= 100 ? 'bg-green-500' : 
                                           item.task_status >= 75 ? 'bg-blue-500' : 
                                           item.task_status >= 50 ? 'bg-yellow-500' : 
                                           item.task_status >= 25 ? 'bg-orange-500' : 'bg-red-500' %>"
                                style="width: <%= Math.min(item.task_status || 0, 100) %>%">
                              </div>
                            </div>
                            <span class="text-sm font-semibold
                                         <%= item.task_status >= 100 ? 'text-green-600' : 
                                             item.task_status >= 75 ? 'text-blue-600' : 
                                             item.task_status >= 50 ? 'text-yellow-600' : 
                                             item.task_status >= 25 ? 'text-orange-600' : 'text-red-600' %>">
                              <%= item.task_status || 0 %>%
                            </span>
                          </div>
                        </td>

                        <!-- Actions -->
                        <td class="px-6 py-4">
                          <a 
                            href="/View-Details/<%= item._id %>"
                            class="inline-flex items-center gap-2 px-3 py-2 text-sm font-medium text-[#2a5298] 
                                   hover:text-[#1e3f7c] hover:bg-blue-50 rounded-lg transition-colors"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                            View Details
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Pagination Section -->
          <% if (typeof hasMore !== 'undefined' || (typeof limit !== 'undefined' && limit > 3)) { %>
          <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <div class="flex justify-between items-center">
              <div class="text-sm text-gray-600">
                <% if (typeof data !== 'undefined') { %>
                  Showing <%= Math.min(limit || 3, data.length) %> of <%= data.length %> tasks
                <% } %>
              </div>
              
              <div class="flex gap-3">
                <% if (typeof limit !== 'undefined' && limit > 3) { %>
                  <form method="GET" action="/member/task-status" class="inline">
                    <input type="hidden" name="limit" value="3" />
                    <% if (typeof search !== 'undefined' && search) { %>
                      <input type="hidden" name="search" value="<%= search %>" />
                    <% } %>
                    <button 
                      type="submit" 
                      class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50 transition-colors"
                    >
                      Show Less
                    </button>
                  </form>
                <% } %>

                <% if (typeof hasMore !== 'undefined' && hasMore) { %>
                  <form method="GET" action="/member/task-status" class="inline">
                    <input type="hidden" name="limit" value="<%= (limit || 3) + 3 %>" />
                    <% if (typeof search !== 'undefined' && search) { %>
                      <input type="hidden" name="search" value="<%= search %>" />
                    <% } %>
                    <button 
                      type="submit" 
                      class="px-4 py-2 bg-[#2a5298] text-white rounded-lg font-medium hover:bg-[#1e3f7c] transition-colors"
                    >
                      Show More
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
          <% } %>

          <!-- Quick Stats Cards -->
          <div class="mt-8 grid gap-6 md:grid-cols-4">
            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
              <div class="flex items-center gap-3">
                <div class="bg-blue-100 p-3 rounded-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                  </svg>
                </div>
                <div>
                  <p class="text-gray-600 text-sm">Total Tasks</p>
                  <p class="text-2xl font-bold text-gray-900">
                    <%= typeof data !== 'undefined' ? data.length : 0 %>
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
              <div class="flex items-center gap-3">
                <div class="bg-green-100 p-3 rounded-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-gray-600 text-sm">Completed</p>
                  <p class="text-2xl font-bold text-gray-900">
                    <% if (typeof data !== 'undefined') { %>
                      <%= data.filter(task => task.task_status >= 100).length %>
                    <% } else { %>
                      0
                    <% } %>
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
              <div class="flex items-center gap-3">
                <div class="bg-yellow-100 p-3 rounded-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-gray-600 text-sm">In Progress</p>
                  <p class="text-2xl font-bold text-gray-900">
                    <% if (typeof data !== 'undefined') { %>
                      <%= data.filter(task => task.task_status > 0 && task.task_status < 100).length %>
                    <% } else { %>
                      0
                    <% } %>
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
              <div class="flex items-center gap-3">
                <div class="bg-red-100 p-3 rounded-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.268 15.5c-.77.833.192 2.5 1.732 2.5z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-gray-600 text-sm">Pending</p>
                  <p class="text-2xl font-bold text-gray-900">
                    <% if (typeof data !== 'undefined') { %>
                      <%= data.filter(task => task.task_status === 0 || !task.task_status).length %>
                    <% } else { %>
                      0
                    <% } %>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- JavaScript for Enhanced Functionality -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Progress bar animations
      const progressBars = document.querySelectorAll('[style*="width:"]');
      progressBars.forEach(bar => {
        const width = bar.style.width;
        bar.style.width = '0%';
        setTimeout(() => {
          bar.style.width = width;
          bar.style.transition = 'width 1s ease-in-out';
        }, 100);
      });

      // Enhanced search functionality
      const searchForm = document.querySelector('form[action="/member/task-status"]');
      const searchInput = searchForm ? searchForm.querySelector('input[name="search"]') : null;

      if (searchInput) {
        // Add real-time search with debounce
        let searchTimeout;
        searchInput.addEventListener('input', function() {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            // Optional: implement real-time filtering here
          }, 300);
        });

        // Add keyboard shortcuts
        document.addEventListener('keydown', function(e) {
          if (e.ctrlKey && e.key === 'k') {
            e.preventDefault();
            searchInput.focus();
          }
        });
      }

      // Add hover effects to table rows
      const tableRows = document.querySelectorAll('tbody tr');
      tableRows.forEach(row => {
        row.addEventListener('mouseenter', function() {
          this.style.transform = 'translateY(-1px)';
          this.style.boxShadow = '0 4px 8px rgba(0,0,0,0.1)';
        });
        
        row.addEventListener('mouseleave', function() {
          this.style.transform = 'translateY(0)';
          this.style.boxShadow = 'none';
        });
      });
    });
  </script>

</div>
</body>
</html>
