<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900&display=swap"
  />

  <title>Chat</title>
  <link rel="icon" type="image/x-icon" href="image/x-icon;base64," />

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>
<body class="bg-gray-50 text-gray-800" style='font-family: Inter, "Noto Sans", sans-serif;'>
  
  <!-- Include the sidebar partial -->
  <%- include('partials/sidebar', { 
    Leader_Name: Leader_Name, 
    Club_Name: Club_Name, 
    currentPage: 'chat' 
  }) %>

  <!-- Main Content Area with margin for sidebar -->
  <main class="ml-0 md:ml-80 min-h-screen">
    <div class="max-w-[960px] mx-auto px-6 py-8">
      <!-- Page Header -->
      <header class="mb-8">
        <h1 class="text-4xl font-bold text-[#111418] mb-2">Chat</h1>
        <p class="text-gray-600">Team communication and collaboration</p>
      </header>

      <!-- Coming Soon Content -->
      <div class="bg-white rounded-xl border border-gray-200 p-8 text-center shadow-sm">
        <div class="mb-6">
          <svg class="mx-auto h-16 w-16 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
        </div>
        
        <h2 class="text-3xl font-bold text-[#111418] mb-4">Coming Soon...</h2>
        <p class="text-gray-600 text-lg mb-6">
          We're working on an amazing chat experience for your club. 
          Stay tuned for real-time messaging, file sharing, and more!
        </p>
        
        <div class="flex justify-center space-x-4">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-blue-100 text-blue-800">
            💬 Real-time messaging
          </span>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-green-100 text-green-800">
            📁 File sharing
          </span>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-purple-100 text-purple-800">
            👥 Group channels
          </span>
        </div>
      </div>

      <!-- Additional placeholder content -->
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
          <h3 class="font-semibold text-gray-900 mb-2">Direct Messages</h3>
          <p class="text-gray-600 text-sm">Connect with individual team members privately</p>
        </div>
        
        <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
          <h3 class="font-semibold text-gray-900 mb-2">Group Channels</h3>
          <p class="text-gray-600 text-sm">Organize conversations by topics and projects</p>
        </div>
      </div>
    </div>
  </main>

</body>
</html>
