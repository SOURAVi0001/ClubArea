<html>
  <head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link
      rel="stylesheet"
      as="style"
      onload="this.rel='stylesheet'"
      href="https://fonts.googleapis.com/css2?display=swap&amp;family=Lexend%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900"
    />

    <title>Stitch Design</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  </head>
  <body>
    <div class="relative flex size-full min-h-screen flex-col bg-white group/design-root overflow-x-hidden" style='font-family: Lexend, "Noto Sans", sans-serif;'>
      <div class="layout-container flex h-full grow flex-col">
        <div class="px-40 flex flex-1 justify-center py-5">
            <%- include('./partials/header.ejs') %>
          <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
            <div class="flex flex-wrap justify-between gap-3 p-4"><p class="text-[#161212] tracking-light text-[32px] font-bold leading-tight min-w-72">Feedback</p></div>
            <div class="px-4 py-3">
              <label class="flex flex-col min-w-40 h-12 w-full">
                <div class="flex w-full flex-1 items-stretch rounded-xl h-full">
                  <div
                    class="text-[#816a6a] flex border-none bg-[#f4f1f1] items-center justify-center pl-4 rounded-l-xl border-r-0"
                    data-icon="MagnifyingGlass"
                    data-size="24px"
                    data-weight="regular"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" fill="currentColor" viewBox="0 0 256 256">
                      <path
                        d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z"
                      ></path>
                    </svg>
                  </div>
                  <input
                    placeholder="Search feedback"
                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#161212] focus:outline-0 focus:ring-0 border-none bg-[#f4f1f1] focus:border-none h-full placeholder:text-[#816a6a] px-4 rounded-l-none border-l-0 pl-2 text-base font-normal leading-normal"
                    value=""
                  />
                </div>
              </label>
            </div>
            <div class="flex gap-3 p-3 flex-wrap pr-4">
              <button class="flex h-8 shrink-0 items-center justify-center gap-x-2 rounded-full bg-[#f4f1f1] pl-4 pr-2">
                <p class="text-[#161212] text-sm font-medium leading-normal">Members</p>
                <div class="text-[#161212]" data-icon="CaretDown" data-size="20px" data-weight="regular">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20px" height="20px" fill="currentColor" viewBox="0 0 256 256">
                    <path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"></path>
                  </svg>
                </div>
              </button>
            </div>


          <% data.forEach(function(item) { %>
  <div class="flex w-full max-w-3xl flex-col gap-3 rounded-xl bg-white px-6 py-5 shadow-sm hover:shadow-md transition sm:flex-row sm:items-start sm:gap-6">
    <!-- Icon Section -->
    <div class="flex items-center justify-center rounded-xl bg-[#fff4f4] text-[#e63946] w-14 h-14 shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256">
        <path
          d="M240,120a48.05,48.05,0,0,0-48-48H152.2c-2.91-.17-53.62-3.74-101.91-44.24A16,16,0,0,0,24,40V200a16,16,0,0,0,26.29,12.25c37.77-31.68,77-40.76,93.71-43.3v31.72A16,16,0,0,0,151.12,214l11,7.33A16,16,0,0,0,186.5,212l11.77-44.36A48.07,48.07,0,0,0,240,120ZM40,199.93V40h0c42.81,35.91,86.63,45,104,47.24v65.48C126.65,155,82.84,164.07,40,199.93Zm131,8,0,.11-11-7.33V168h21.6ZM192,152H160V88h32a32,32,0,1,1,0,64Z"
        ></path>
      </svg>
    </div>

    <!-- Content Section -->
    <div class="flex flex-1 flex-col justify-center gap-2 text-sm text-[#161212]">
      <!-- Header Row -->
      <div class="flex flex-wrap justify-between gap-2">
        <h3 class="text-lg font-bold text-[#0d47a1]"><%= item.title %></h3>
        <span class="text-xs text-[#666]">Posted on <strong><%= new Date(item.date).toLocaleString('en-IN', {
  dateStyle: 'medium',
  timeStyle: 'short',
  hour12: true
}) %></strong></span>
      </div>

      <!-- Metadata Row -->
      <div class="flex flex-wrap items-center gap-2 text-[#444]">
        <span class="font-medium text-[#333]">Posted by : </span>
        <span class="text-[#555]"><%= item.posted_by %></span>
        <span class="text-[#888]">|</span>
        <a href="mailto:<%= item.email %>" class="text-blue-600 underline hover:text-blue-800">
          <%= item.email %>
        </a>
        <span class="text-[#888]">|</span>
        <span class="text-[#555] italic"><%= item.user_type %></span>
      </div>

      <!-- Feedback Text -->
      <p class="mt-1 text-[#444] leading-relaxed">
        <%= item.description %>
      </p>
    </div>
  </div>
<% }) %>
          <div class="flex justify-center gap-4 mt-6">
  <% if (limit > 5) { %>
    <a href="/leader/leader-feedback?<% if (search) { %>search=<%= search %>&<% } %><% if (userType) { %>userType=<%= userType %>&<% } %>limit=5"
      class="text-blue-600 underline hover:text-blue-800 transition">
      Show Less
    </a>
  <% } %>

  <% if (hasMore) { %>
    <a href="/leader/leader-feedback?<% if (search) { %>search=<%= search %>&<% } %><% if (userType) { %>userType=<%= userType %>&<% } %>limit=<%= limit + 5 %>"
      class="text-blue-600 underline hover:text-blue-800 transition">
      Show More
    </a>
  <% } %>
</div>  
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
