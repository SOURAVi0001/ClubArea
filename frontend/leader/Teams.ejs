<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700;900&family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap"
  />

  <title>Teams</title>
  <link rel="icon" type="image/x-icon" href="image/x-icon;base64," />

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>
<body class="bg-gray-50 text-gray-800" style='font-family: "Plus Jakarta Sans", "Noto Sans", sans-serif;'>
  
  <!-- Include the sidebar partial -->
 <%- include('partials/sidebar.ejs', { 
    Leader_Name: Leader_Name, 
    Club_Name: Club_Name, 
    currentPage: 'teams' 
  }) %>


  <!-- Main Content Area - LEFT margin for desktop, full width for mobile -->
  <main class="ml-0 md:ml-80 min-h-screen bg-[#fcf8f8] transition-all duration-300">
    <div class="max-w-[960px] mx-auto px-4 py-8 md:px-6">
      <!-- Mobile spacing to account for fixed toggle button -->
      <div class="pt-16 md:pt-0">
        
        <!-- Page Header -->
        <header class="mb-8">
          <h1 class="text-4xl font-bold text-[#1b0e0e] mb-2">Teams Management</h1>
          <p class="text-gray-600">Manage and view all teams within your club</p>
        </header>

        <!-- Quick Stats Cards -->
        <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 mb-8">
          <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <div class="bg-blue-100 p-3 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 515.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 919.288 0M15 7a3 3 0 11-6 0 3 3 0 616 0zm6 3a2 2 0 11-4 0 2 2 0 614 0zM7 10a2 2 0 11-4 0 2 2 0 614 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-gray-600 text-sm">Total Teams</p>
                <p class="text-2xl font-bold text-gray-900"><%= teamStats ? teamStats.length : 0 %></p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <div class="bg-green-100 p-3 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 6.292 4 4 0 010-6.292zM15 21H3v-1a6 6 0 0112 0v1z"/>
                </svg>
              </div>
              <div>
                <p class="text-gray-600 text-sm">Total Members</p>
                <p class="text-2xl font-bold text-gray-900">
                  <%= teamStats ? teamStats.reduce((total, team) => total + (team.membercount || 0), 0) : 0 %>
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <div class="bg-purple-100 p-3 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 912-2h2a2 2 0 912 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
              </div>
              <div>
                <p class="text-gray-600 text-sm">Avg per Team</p>
                <p class="text-2xl font-bold text-gray-900">
                  <%= teamStats && teamStats.length > 0 ? Math.round(teamStats.reduce((total, team) => total + (team.membercount || 0), 0) / teamStats.length) : 0 %>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Search and Filter Section -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-8">
          <div class="flex flex-col sm:flex-row gap-4">
            <!-- Search Input -->
            <div class="flex-1 relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
              <input
                id="teamSearch"
                type="text"
                placeholder="Search teams by name..."
                class="w-full pl-10 pr-4 py-3 rounded-lg border border-gray-300 bg-gray-50 text-[#1b0e0e] 
                       placeholder:text-gray-500 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 
                       focus:bg-white transition-all duration-200"
              />
            </div>
            
            <!-- Size Filter -->
            <select id="sizeFilter" class="px-4 py-3 rounded-lg border border-gray-300 bg-white text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 min-w-[150px]">
              <option value="">All Sizes</option>
              <option value="large">Large (10+ members)</option>
              <option value="medium">Medium (5-10 members)</option>
              <option value="small">Small (1-4 members)</option>
              <option value="empty">Empty (0 members)</option>
            </select>
            
            <!-- Reset Button -->
            <button
              id="resetFilters"
              type="button"
              class="px-4 py-3 text-sm text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition-colors border border-gray-300"
            >
              Reset
            </button>
          </div>
        </div>

        <!-- Teams Table Section -->
        <section class="mb-12">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-[#1b0e0e]">All Teams</h2>
            <div class="text-sm text-gray-500">
              <span id="teamCount"><%= teamStats ? teamStats.length : 0 %></span> total teams
            </div>
          </div>

          <!-- Enhanced Table Container -->
          <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full" id="teamsTable">
                <thead>
                  <tr class="bg-gray-50 border-b border-gray-200">
                    <th class="px-6 py-4 text-left text-[#1b0e0e] text-sm font-semibold">Team</th>
                    <th class="px-6 py-4 text-left text-[#1b0e0e] text-sm font-semibold">Name</th>
                    <th class="px-6 py-4 text-left text-[#1b0e0e] text-sm font-semibold">Members</th>
                    <th class="px-6 py-4 text-left text-[#1b0e0e] text-sm font-semibold">Actions</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200" id="teamsTableBody">
                  <% if (teamStats && teamStats.length > 0) { %>
                    <% teamStats.forEach(({ teamName, membercount }, index) => { %>
                      <tr class="hover:bg-gray-50 transition-colors duration-200 team-row"
                          data-team-name="<%= (teamName || '').toLowerCase() %>"
                          data-member-count="<%= membercount || 0 %>">
                        <!-- Team Icon -->
                        <td class="px-6 py-4">
                          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center border-2 border-white shadow-md">
                            <span class="text-white font-bold text-lg team-initial">
                              <%= (teamName || 'T').charAt(0).toUpperCase() %>
                            </span>
                          </div>
                        </td>
                        
                        <!-- Team Name -->
                        <td class="px-6 py-4">
                          <div class="flex flex-col">
                            <span class="text-[#1b0e0e] font-semibold text-base team-name">
                              <%= teamName || 'Unknown Team' %>
                            </span>
                            <span class="text-gray-500 text-sm">Team #<%= index + 1 %></span>
                          </div>
                        </td>
                        
                        <!-- Member Count -->
                        <td class="px-6 py-4">
                          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium 
                                       <%= (membercount || 0) > 10 ? 'bg-green-100 text-green-800' : 
                                           (membercount || 0) > 5 ? 'bg-blue-100 text-blue-800' : 
                                           (membercount || 0) > 0 ? 'bg-yellow-100 text-yellow-800' : 
                                           'bg-red-100 text-red-800' %> team-member-count">
                            <%= membercount || 0 %> member<%= (membercount !== 1) ? 's' : '' %>
                          </span>
                        </td>
                        
                        <!-- Actions -->
                        <td class="px-6 py-4">
                          <div class="flex items-center gap-2">
                            <button class="p-2 text-blue-600 hover:bg-blue-100 rounded-lg transition-colors" title="View Team">
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 616 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                              </svg>
                            </button>
                            <button class="p-2 text-green-600 hover:bg-green-100 rounded-lg transition-colors" title="Manage Team">
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                              </svg>
                            </button>
                          </div>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr id="noTeamsRow">
                      <td colspan="4" class="px-6 py-12 text-center">
                        <div class="flex flex-col items-center gap-3">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 515.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 919.288 0M15 7a3 3 0 11-6 0 3 3 0 616 0zm6 3a2 2 0 11-4 0 2 2 0 614 0zM7 10a2 2 0 11-4 0 2 2 0 614 0z"/>
                          </svg>
                          <div>
                            <p class="text-gray-500 text-lg font-medium">No teams found</p>
                            <p class="text-gray-400 text-sm">Teams will appear here once they are created</p>
                          </div>
                        </div>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <!-- No Results Message -->
            <div id="noResultsMessage" class="hidden text-center py-12">
              <div class="flex flex-col items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <div>
                  <p class="text-gray-500 text-lg font-medium">No teams found</p>
                  <p class="text-gray-400 text-sm">Try adjusting your search terms or filters</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Team Overview Section -->
        <section>
          <h2 class="text-2xl font-bold text-[#1b0e0e] mb-6">Team Size Distribution</h2>
          <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
            <!-- Large Teams -->
            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-semibold text-[#1b0e0e]">Large Teams</h3>
                <span class="bg-green-100 text-green-800 text-xs font-medium px-2 py-1 rounded-full">
                  <%= teamStats ? teamStats.filter(team => (team.membercount || 0) > 10).length : 0 %> teams
                </span>
              </div>
              <p class="text-gray-600 text-sm">Teams with 10+ members</p>
              <div class="mt-4 w-full bg-gray-200 rounded-full h-2">
                <div class="bg-green-600 h-2 rounded-full" style="width: <%= teamStats && teamStats.length > 0 ? Math.min((teamStats.filter(team => (team.membercount || 0) > 10).length / teamStats.length) * 100, 100) : 0 %>%"></div>
              </div>
            </div>

            <!-- Medium Teams -->
            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-semibold text-[#1b0e0e]">Medium Teams</h3>
                <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2 py-1 rounded-full">
                  <%= teamStats ? teamStats.filter(team => (team.membercount || 0) >= 5 && (team.membercount || 0) <= 10).length : 0 %> teams
                </span>
              </div>
              <p class="text-gray-600 text-sm">Teams with 5-10 members</p>
              <div class="mt-4 w-full bg-gray-200 rounded-full h-2">
                <div class="bg-blue-600 h-2 rounded-full" style="width: <%= teamStats && teamStats.length > 0 ? Math.min((teamStats.filter(team => (team.membercount || 0) >= 5 && (team.membercount || 0) <= 10).length / teamStats.length) * 100, 100) : 0 %>%"></div>
              </div>
            </div>

            <!-- Small Teams -->
            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-semibold text-[#1b0e0e]">Small Teams</h3>
                <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2 py-1 rounded-full">
                  <%= teamStats ? teamStats.filter(team => (team.membercount || 0) > 0 && (team.membercount || 0) < 5).length : 0 %> teams
                </span>
              </div>
              <p class="text-gray-600 text-sm">Teams with 1-4 members</p>
              <div class="mt-4 w-full bg-gray-200 rounded-full h-2">
                <div class="bg-yellow-600 h-2 rounded-full" style="width: <%= teamStats && teamStats.length > 0 ? Math.min((teamStats.filter(team => (team.membercount || 0) > 0 && (team.membercount || 0) < 5).length / teamStats.length) * 100, 100) : 0 %>%"></div>
              </div>
            </div>

            <!-- Empty Teams -->
            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-semibold text-[#1b0e0e]">Empty Teams</h3>
                <span class="bg-red-100 text-red-800 text-xs font-medium px-2 py-1 rounded-full">
                  <%= teamStats ? teamStats.filter(team => (team.membercount || 0) === 0).length : 0 %> teams
                </span>
              </div>
              <p class="text-gray-600 text-sm">Teams with 0 members</p>
              <div class="mt-4 w-full bg-gray-200 rounded-full h-2">
                <div class="bg-red-600 h-2 rounded-full" style="width: <%= teamStats && teamStats.length > 0 ? Math.min((teamStats.filter(team => (team.membercount || 0) === 0).length / teamStats.length) * 100, 100) : 0 %>%"></div>
              </div>
            </div>
          </div>
        </section>

        <!-- Quick Actions Section -->
        <section class="mt-8">
          <h2 class="text-2xl font-bold text-[#1b0e0e] mb-6">Quick Actions</h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <a href="/leader/leader-members" 
               class="flex items-center gap-4 p-6 bg-white rounded-lg border border-gray-200 hover:shadow-md transition-all">
              <div class="bg-blue-100 p-3 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 6.292 4 4 0 010-6.292zM15 21H3v-1a6 6 0 0112 0v1z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-[#1b0e0e]">View Members</h3>
                <p class="text-gray-600 text-sm">Manage all club members</p>
              </div>
            </a>

            <a href="/leader/leader-taskstatus" 
               class="flex items-center gap-4 p-6 bg-white rounded-lg border border-gray-200 hover:shadow-md transition-all">
              <div class="bg-green-100 p-3 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 912-2h2a2 2 0 912 2m-6 8h6m-6 4h6"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-[#1b0e0e]">Assign Tasks</h3>
                <p class="text-gray-600 text-sm">Create team tasks</p>
              </div>
            </a>

            <a href="/leader/openings" 
               class="flex items-center gap-4 p-6 bg-white rounded-lg border border-gray-200 hover:shadow-md transition-all">
              <div class="bg-purple-100 p-3 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-[#1b0e0e]">Create Recruitment</h3>
                <p class="text-gray-600 text-sm">Open team positions</p>
              </div>
            </a>
          </div>
        </section>
      </div>
    </div>
  </main>

  <!-- Enhanced JavaScript for Search and Filter -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const teamSearch = document.getElementById('teamSearch');
      const sizeFilter = document.getElementById('sizeFilter');
      const resetFilters = document.getElementById('resetFilters');
      const teamRows = document.querySelectorAll('.team-row');
      const noResultsMessage = document.getElementById('noResultsMessage');
      const teamCount = document.getElementById('teamCount');
      const teamsTableBody = document.getElementById('teamsTableBody');
      
      let allTeams = Array.from(teamRows);
      let filteredTeams = [...allTeams];

      // Highlight search terms
      function highlightText(element, searchTerm) {
        if (!searchTerm) return;
        
        const text = element.textContent;
        const regex = new RegExp(`(${searchTerm})`, 'gi');
        if (regex.test(text)) {
          element.innerHTML = text.replace(regex, '<mark class="bg-yellow-200 px-1 rounded">$1</mark>');
        }
      }

      // Remove highlights
      function removeHighlights() {
        const highlights = document.querySelectorAll('mark');
        highlights.forEach(mark => {
          const parent = mark.parentNode;
          parent.replaceChild(document.createTextNode(mark.textContent), mark);
          parent.normalize();
        });
      }

      // Filter teams
      function filterTeams() {
        const searchTerm = teamSearch.value.toLowerCase().trim();
        const sizeValue = sizeFilter.value;

        // Remove previous highlights
        removeHighlights();

        filteredTeams = allTeams.filter(row => {
          const teamName = row.dataset.teamName;
          const memberCount = parseInt(row.dataset.memberCount) || 0;

          // Text search
          const matchesSearch = !searchTerm || teamName.includes(searchTerm);

          // Size filter
          let matchesSize = true;
          if (sizeValue) {
            switch (sizeValue) {
              case 'large':
                matchesSize = memberCount > 10;
                break;
              case 'medium':
                matchesSize = memberCount >= 5 && memberCount <= 10;
                break;
              case 'small':
                matchesSize = memberCount > 0 && memberCount < 5;
                break;
              case 'empty':
                matchesSize = memberCount === 0;
                break;
            }
          }

          return matchesSearch && matchesSize;
        });

        // Show/hide rows
        allTeams.forEach(row => {
          if (filteredTeams.includes(row)) {
            row.style.display = '';
            
            // Highlight search terms
            if (searchTerm) {
              const nameElement = row.querySelector('.team-name');
              highlightText(nameElement, searchTerm);
            }
          } else {
            row.style.display = 'none';
          }
        });

        // Update count
        teamCount.textContent = filteredTeams.length;

        // Show/hide no results message
        if (filteredTeams.length === 0) {
          noResultsMessage.classList.remove('hidden');
        } else {
          noResultsMessage.classList.add('hidden');
        }
      }

      // Event listeners
      teamSearch.addEventListener('input', function() {
        clearTimeout(this.searchTimeout);
        this.searchTimeout = setTimeout(filterTeams, 300);
      });

      teamSearch.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          filterTeams();
        }
      });

      sizeFilter.addEventListener('change', filterTeams);

      resetFilters.addEventListener('click', function() {
        teamSearch.value = '';
        sizeFilter.value = '';
        filterTeams();
        teamSearch.focus();
      });

      // Keyboard shortcuts
      document.addEventListener('keydown', function(e) {
        if (e.ctrlKey && e.key === 'k') {
          e.preventDefault();
          teamSearch.focus();
        }
        if (e.key === 'Escape') {
          if (document.activeElement === teamSearch) {
            teamSearch.blur();
          }
        }
      });
    });
  </script>

  <!-- Custom styles for highlighting -->
  <style>
    mark {
      background-color: #fef08a !important;
      padding: 0 2px;
      border-radius: 2px;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .team-row {
      animation: fadeIn 0.3s ease-out;
    }

    /* Mobile table responsiveness */
    @media (max-width: 640px) {
      .overflow-x-auto {
        -webkit-overflow-scrolling: touch;
      }
      
      table th,
      table td {
        padding: 12px 8px;
        font-size: 14px;
      }
      
      .team-row .flex {
        gap: 4px;
      }
    }
  </style>

</body>
</html>
