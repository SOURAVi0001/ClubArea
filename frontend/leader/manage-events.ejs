  <!-- Main Content Area with Right Margin for Sidebar -->
  <main class="min-h-screen mr-0 lg:mr-80 transition-all duration-300">
    <!-- Content Container with proper spacing for mobile toggle -->
    <div class="max-w-6xl mx-auto px-6 py-8 pt-20 lg:pt-8">
      <!-- Page Header -->
      <header class="mb-8 flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Event Gallery Manager</h1>
          <p class="text-gray-600">Create and showcase your club's memorable moments</p>
        </div>
      </header>

      <!-- Add Event Form -->
      <form action="/leader/events_gallery" method="POST" enctype="multipart/form-data" class="dash-card mb-8">
        <h2 class="text-xl font-bold text-gray-900 mb-6"> Add New Event</h2>

        <div class="space-y-6">
          <div class="grid gap-6 md:grid-cols-2">
            <label class="block">
              <span class="block text-sm font-medium mb-2 text-gray-700">Event Title *</span>
              <input name="title" required placeholder="Enter event title" 
                     class="form-input w-full h-12 px-4 rounded-lg bg-gray-50 border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all" />
            </label>

            <label class="block">
              <span class="block text-sm font-medium mb-2 text-gray-700">Venue</span>
              <input name="venue" placeholder="Event location" 
                     class="form-input w-full h-12 px-4 rounded-lg bg-gray-50 border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all" />
            </label>
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            <label class="block">
              <span class="block text-sm font-medium mb-2 text-gray-700">Date *</span>
              <input type="date" name="date" required 
                     class="form-input w-full h-12 px-4 rounded-lg bg-gray-50 border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all" />
            </label>

            <label class="block">
              <span class="block text-sm font-medium mb-2 text-gray-700">Time *</span>
              <input type="time" name="time" required 
                     class="form-input w-full h-12 px-4 rounded-lg bg-gray-50 border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all" />
            </label>
          </div>

          <label class="block">
            <span class="block text-sm font-medium mb-2 text-gray-700"> Event Photos (max 5)</span>
            <input type="file" name="photos" accept="image/*" multiple
                   class="file:mr-4 file:rounded-lg file:border-0 file:bg-blue-600 file:text-white
                          file:py-3 file:px-6 file:text-sm file:font-semibold 
                          hover:file:bg-blue-700 file:transition-all w-full border border-gray-200 rounded-lg p-2" />
          </label>

          <label class="block">
            <span class="block text-sm font-medium mb-2 text-gray-700">Description</span>
            <textarea name="description" rows="4" placeholder="Tell us about this amazing event..."
                      class="form-textarea w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all resize-none"></textarea>
          </label>
        </div>

        <div class="text-right mt-6">
          <button type="submit" class="bg-blue-600 text-white px-8 py-3 rounded-lg font-semibold 
                                       hover:bg-blue-700 transition-all transform hover:scale-105 shadow-lg">
            ✨ Create Event
          </button>
        </div>
      </form>

      <!-- Events Gallery -->
      <section>
        <h2 class="text-2xl font-bold mb-6 text-gray-900"> Events Gallery</h2>

        <div id="events-container" class="space-y-6">
          <% events.forEach(ev => { %>
            <article class="dash-card">
              <div class="flex items-start gap-4 mb-4">
                <div class="bg-blue-100 p-3 rounded-full flex-shrink-0">
                  <svg class="h-6 w-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7H3v12a2 2 0 0 0 2 2Z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <h3 class="text-xl font-bold text-gray-900 mb-2"><%= ev.title %></h3>
                  <div class="flex flex-wrap gap-4 text-sm text-gray-600 mb-2">
                    <span class="flex items-center gap-1">
                      📅 <%= new Date(ev.date).toLocaleDateString('en-GB') %>
                    </span>
                    <span class="flex items-center gap-1">
                      🕐 <%= new Date('1970-01-01T' + ev.time).toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',hour12:true}) %>
                    </span>
                    <% if (ev.venue) { %>
                      <span class="flex items-center gap-1">
                        📍 <%= ev.venue %>
                      </span>
                    <% } %>
                  </div>
                  <% if (ev.description) { %>
                    <p class="text-gray-700 leading-relaxed mb-4"><%= ev.description %></p>
                  <% } %>

                  <!-- Photo Gallery -->
                  <% if (ev.photos && ev.photos.length) { %>
                    <div class="border-t border-gray-200 pt-4">
                      <h4 class="text-sm font-semibold text-gray-900 mb-3 flex items-center gap-2">
                        📸 Event Photos (<%= ev.photos.length %>)
                      </h4>
                      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
                        <% ev.photos.forEach((src, index) => { %>
                          <a href="<%= src %>" target="_blank" class="group block">
                            <img src="<%= src %>" alt="<%= ev.title %> photo <%= index + 1 %>" 
                                 class="w-full h-20 object-cover rounded-lg transition-transform group-hover:scale-105 shadow-sm"
                                 loading="lazy" 
                                 onerror="this.parentElement.innerHTML='<div class=\\'w-full h-20 bg-gray-200 rounded-lg flex items-center justify-center\\'>📷</div>'" />
                          </a>
                        <% }) %>
                      </div>
                    </div>
                  <% } else { %>
                    <div class="border-t border-gray-200 pt-4">
                      <p class="text-gray-500 text-sm italic">No photos uploaded for this event</p>
                    </div>
                  <% } %>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <!-- Pagination -->
        <div class="mt-8 flex justify-center gap-3">
          <button id="prev-btn" class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg font-medium 
                                       hover:bg-gray-300 transition-all disabled:opacity-50 disabled:cursor-not-allowed" 
                  disabled>
            ← Previous
          </button>
          <button id="next-btn" class="px-6 py-3 bg-blue-600 text-white rounded-lg font-medium 
                                       hover:bg-blue-700 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                  <%= events.length < 5 ? 'disabled' : '' %>>
            Next →
          </button>
        </div>
      </section>
    </div>
  </main>

  <script>
    // Mobile menu toggle function
    function toggleMobileMenu() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.querySelector('.mobile-overlay');
      
      sidebar.classList.toggle('translate-x-full');
      overlay.classList.toggle('hidden');
      
      // Prevent body scroll when sidebar is open
      if (!sidebar.classList.contains('translate-x-full')) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    }

    // Close mobile menu when clicking on nav items
    document.querySelectorAll('aside a').forEach(item => {
      item.addEventListener('click', () => {
        if (window.innerWidth < 1024) {
          const sidebar = document.getElementById('sidebar');
          const overlay = document.querySelector('.mobile-overlay');
          
          sidebar.classList.add('translate-x-full');
          overlay.classList.add('hidden');
          document.body.style.overflow = '';
        }
      });
    });

    // Close sidebar when window is resized to desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.querySelector('.mobile-overlay');
        
        sidebar.classList.remove('translate-x-full');
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }
    });

    // Pagination functionality
    const limit = 5;
    let skip = 0;
    const container = document.getElementById('events-container');
    const nextBtn = document.getElementById('next-btn');
    const prevBtn = document.getElementById('prev-btn');

    async function loadPage() {
      try {
        container.innerHTML = '<div class="text-center py-8"><div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div></div>';
        
        const res = await fetch(`/leader/events/page?skip=${skip}`);
        const { events, totalCount } = await res.json();

        container.innerHTML = '';
        events.forEach(ev => {
          const photosHtml = ev.photos && ev.photos.length ? 
            `<div class="border-t border-gray-200 pt-4">
              <h4 class="text-sm font-semibold text-gray-900 mb-3 flex items-center gap-2">
                📸 Event Photos (${ev.photos.length})
              </h4>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
                ${ev.photos.map((src, index) => `
                  <a href="${src}" target="_blank" class="group block">
                    <img src="${src}" alt="${ev.title} photo ${index + 1}" 
                         class="w-full h-20 object-cover rounded-lg transition-transform group-hover:scale-105 shadow-sm"
                         loading="lazy" 
                         onerror="this.parentElement.innerHTML='<div class=\\'w-full h-20 bg-gray-200 rounded-lg flex items-center justify-center\\'>📷</div>'" />
                  </a>
                `).join('')}
              </div>
            </div>` : 
            '<div class="border-t border-gray-200 pt-4"><p class="text-gray-500 text-sm italic">No photos uploaded for this event</p></div>';

          container.insertAdjacentHTML('beforeend', `
            <article class="dash-card">
              <div class="flex items-start gap-4 mb-4">
                <div class="bg-blue-100 p-3 rounded-full flex-shrink-0">
                  <svg class="h-6 w-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7H3v12a2 2 0 0 0 2 2Z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <h3 class="text-xl font-bold text-gray-900 mb-2">${ev.title}</h3>
                  <div class="flex flex-wrap gap-4 text-sm text-gray-600 mb-2">
                    <span class="flex items-center gap-1">📅 ${new Date(ev.date).toLocaleDateString('en-GB')}</span>
                    <span class="flex items-center gap-1">🕐 ${new Date('1970-01-01T' + ev.time).toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',hour12:true})}</span>
                    ${ev.venue ? `<span class="flex items-center gap-1">📍 ${ev.venue}</span>` : ''}
                  </div>
                  ${ev.description ? `<p class="text-gray-700 leading-relaxed mb-4">${ev.description}</p>` : ''}
                  ${photosHtml}
                </div>
              </div>
            </article>
          `);
        });

        prevBtn.disabled = skip === 0;
        nextBtn.disabled = skip + limit >= totalCount;
      } catch (error) {
        container.innerHTML = '<div class="text-center py-8 text-red-600">Error loading events</div>';
      }
    }

    nextBtn.addEventListener('click', () => { skip += limit; loadPage(); });
    prevBtn.addEventListener('click', () => { skip = Math.max(0, skip - limit); loadPage(); });
  </script>
</body>
</html>
