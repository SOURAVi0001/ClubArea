        <a href="/leader/leader-events" class="flex items-center gap-3 py-3 px-4 my-1 mx-2 rounded-lg text-gray-700 font-medium transition-all duration-200 hover:bg-gray-100 hover:text-gray-900 hover:translate-x-1">
