        <button onclick="toggleMobileMenu()" class="p-2 rounded-lg hover:bg-gray-100">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- User Profile Section -->
      <div class="flex items-center gap-3 mb-8 p-4 bg-gray-50 rounded-xl shadow-sm">
        <div class="w-12 h-12 rounded-full bg-center bg-cover bg-no-repeat flex-shrink-0"
             style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBTINofuvng1wVuWdUGzeZ6-_XHbkvxLy0aJjL6EjivosnxReZhAnjrUVjhxlOqXcERdeL33_DTIIGwlv-f_zAgFz5ZpfH6q7k3BxZTKc9I97Ld7XrnEm2-1AV4vD921V3B_AEpEyddkvs9IhKe6SjoHvgM7RBmmgZpHerQySSRhjzHPjQtT2hpf2L4KEx39_KsGz-5MahqHod96ojv6QU77BaG-cmbgNh8ee2v1oDlT8KyoJ7mXxCpRWPfDLwTbdcLmKJap3aEbx0");'>
