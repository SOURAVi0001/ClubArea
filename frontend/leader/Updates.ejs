<html>
  <head>
    <title>Updates</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?display=swap&family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900" />
  </head>
  <body style='font-family: Inter, "Noto Sans", sans-serif;'>
    <div class="relative flex min-h-screen flex-col bg-white overflow-x-hidden">
      <div class="layout-container flex h-full grow flex-col">
        <div class="gap-1 px-6 flex flex-1 justify-center py-5">
          <%- include('partials/header.ejs') %>

          <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
            <!-- Header -->
            <div class="flex flex-wrap justify-between gap-3 p-4">
              <div class="flex min-w-72 flex-col gap-3">
                <p class="text-[#111418] text-[32px] font-bold leading-tight">Updates</p>
                <p class="text-[#60758a] text-sm">Share announcements, news, and updates with your Club_Members.</p>
              </div>
            </div>

            <!-- Post Form -->
            <div class="flex items-center px-4 py-3 gap-3">
              <form id="updateForm" method="POST" action="/leader/Post_Updates" class="flex flex-col w-full max-w-2xl bg-white border border-[#dbe0e6] rounded-lg overflow-hidden">
                <div class="flex items-start p-4 gap-4">
                  <div class="rounded-full bg-cover bg-center size-10 shrink-0"></div>
                  <div class="flex flex-col flex-1 gap-2">
                    <input type="text" name="title" placeholder="Enter post title" class="w-full px-3 py-2 border border-[#dbe0e6] rounded text-sm focus:outline-none" />
                    <textarea name="content" placeholder="Write here?" class="w-full resize-none px-3 py-2 border border-[#dbe0e6] rounded text-sm focus:outline-none h-24" required></textarea>
                  </div>
                </div>
                <div class="flex items-center justify-between px-4 py-2 border-t border-[#dbe0e6] bg-white">
                  <div class="flex items-center gap-2">
                    <button type="button" class="text-[#60758a]" title="Add Image">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"><path d="M216,40H40A16,16,0..." /></svg>
                    </button>
                    <button type="button" class="text-[#60758a]" title="Add Link">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"><path d="M137.54,186.36a8,8..." /></svg>
                    </button>
                    <select id="postType" name="postType" class="border border-[#dbe0e6] rounded px-2 py-1 text-sm text-[#111418] bg-white">
                      <option value="club">Club Only</option>
                      <option value="public">Public</option>
                    </select>
                  </div>
                  <button type="submit" class="bg-[#0c7ff2] text-white text-sm font-medium px-4 py-1.5 rounded hover:bg-blue-600">Post</button>
                </div>
              </form>
            </div>

            <!-- JS to toggle form action -->
            <script>
              document.addEventListener('DOMContentLoaded', function () {
                const form = document.getElementById('updateForm');
                const postType = document.getElementById('postType');
                postType.addEventListener('change', function () {
                  form.action = postType.value === 'public' ? '/updates/public' : '/updates/club';
                });
              });
            </script>

            <!-- Recent Updates -->
            <h2 class="text-[#111418] text-[22px] font-bold leading-tight px-4 pb-3 pt-5">Recent Updates</h2>
            <div id="updates-container">
              <% data.forEach((d) => { %>
                <div class="flex w-full flex-row items-start justify-start gap-3 p-4">
                  <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full w-10 shrink-0" style='background-image: url("<%= d.imageUrl || "https://cdn-icons-png.flaticon.com/512/149/149071.png" %>");'></div>
                  <div class="flex h-full flex-1 flex-col items-start justify-start">
                    <div class="flex w-full flex-row items-start justify-start gap-x-3">
                      <p class="text-[#111418] text-sm font-bold"><%= d.posted_by %></p>
                      <p class="text-[#111418] text-sm font-bold">(<%= d.title %>)</p>
                      <p class="text-[#60758a] text-sm"><%= typeof d.ago === "function" ? d.ago() : "" %></p>
                    </div>
                    <p class="text-[#111418] text-sm"><%= d.description %></p>
                    <div class="flex w-full flex-row items-center justify-start gap-9 pt-2">
                      <div class="flex items-center gap-2">
                        <svg width="20" height="20" fill="currentColor"><path d="..." /></svg>
                        <p class="text-[#60758a] text-sm"><%= d.likes || 0 %></p>
                      </div>
                      <div class="flex items-center gap-2">
                        <svg width="20" height="20" fill="currentColor"><path d="..." /></svg>
                        <p class="text-[#60758a] text-sm"><%= d.dislikes || 0 %></p>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>

            <!-- Pagination Buttons -->
            <div class="flex justify-center gap-4 py-4">
              <button id="prev-btn" class="bg-gray-200 px-4 py-2 rounded text-sm font-medium text-gray-800 disabled:opacity-50" disabled>Previous</button>
              <button id="next-btn" class="bg-blue-500 text-white px-4 py-2 rounded text-sm font-medium disabled:opacity-50" <%= data.length < 5 ? "disabled" : "" %>>Next</button>
            </div>

            <!-- Pagination Script -->
            <script>
              let skip = 0;
              const limit = 5;
              const total = <%= totalCount %>;
              const container = document.getElementById("updates-container");
              const nextBtn = document.getElementById("next-btn");
              const prevBtn = document.getElementById("prev-btn");

              function renderUpdates(updates) {
                container.innerHTML = "";
                updates.forEach(d => {
                  const div = document.createElement("div");
                  div.className = "flex w-full flex-row items-start justify-start gap-3 p-4";
                  div.innerHTML = `
                    <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full w-10 shrink-0"
                      style='background-image: url("${d.imageUrl || "https://cdn-icons-png.flaticon.com/512/149/149071.png"}");'></div>
                    <div class="flex h-full flex-1 flex-col items-start justify-start">
                      <div class="flex w-full flex-row items-start justify-start gap-x-3">
                        <p class="text-[#111418] text-sm font-bold">${d.posted_by}</p>
                        <p class="text-[#111418] text-sm font-bold">(${d.title})</p>
                      </div>
                      <p class="text-[#111418] text-sm">${d.description}</p>
                      <div class="flex w-full flex-row items-center justify-start gap-9 pt-2">
                        <div class="flex items-center gap-2">
                          <svg width="20" height="20" fill="currentColor"><path d="..." /></svg>
                          <p class="text-[#60758a] text-sm">${d.likes || 0}</p>
                        </div>
                        <div class="flex items-center gap-2">
                          <svg width="20" height="20" fill="currentColor"><path d="..." /></svg>
                          <p class="text-[#60758a] text-sm">${d.dislikes || 0}</p>
                        </div>
                      </div>
                    </div>
                  `;
                  container.appendChild(div);
                });
              }

              async function loadUpdates() {
                const res = await fetch(`/leader/updates/page?skip=${skip}`);
                const { updates, totalCount } = await res.json();
                renderUpdates(updates);
                prevBtn.disabled = skip === 0;
                nextBtn.disabled = skip + limit >= totalCount;
              }

              nextBtn.addEventListener("click", () => {
                skip += limit;
                loadUpdates();
              });

              prevBtn.addEventListener("click", () => {
                skip = Math.max(0, skip - limit);
                loadUpdates();
              });
            </script>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>