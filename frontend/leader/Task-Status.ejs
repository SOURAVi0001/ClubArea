<html>
  <head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link
      rel="stylesheet"
      as="style"
      onload="this.rel='stylesheet'"
      href="https://fonts.googleapis.com/css2?display=swap&amp;family=Lexend%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900"
    />

    <title>Stitch Design</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  </head>
  <body>
    <div class="relative flex size-full min-h-screen flex-col bg-white group/design-root overflow-x-hidden" style='font-family: Lexend, "Noto Sans", sans-serif;'>
      <div class="layout-container flex h-full grow flex-col">

        <div class="px-40 flex flex-1 justify-center py-5">
           <%- include('./partials/header.ejs') %>
          <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
            <div class="flex flex-wrap justify-between gap-3 p-4">
              <p class="text-[#181111] tracking-light text-[32px] font-bold leading-tight min-w-72">Team Tasks</p>
              <button
                class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-8 px-4 bg-[#f4f0f0] text-[#181111] text-sm font-medium leading-normal"
              >
              <a href="/leader-Create-Task">
                <span class="truncate">New Task</span>
              </a>
              </button>
            </div>
           <form method="GET" action="/leader/leader-taskstatus" class="mb-4">
          <div class="flex items-center bg-[#f4f0f0] rounded-xl overflow-hidden w-full h-12">
            <div class="pl-4 text-[#886363]">
              <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" fill="currentColor" viewBox="0 0 256 256">
                <path
                  d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z"
                ></path>
              </svg>
            </div>
            <input
              name="search"
              placeholder="Search tasks"
              class="form-input w-full px-4 bg-[#f4f0f0] text-[#181111] placeholder:text-[#886363] focus:outline-none border-none"
              value="<%= typeof search !== 'undefined' ? search : '' %>"
            />
          </div>
        </form>
            <div class="px-4 py-3 @container">
              <div class="flex overflow-hidden rounded-xl border border-[#e5dcdc] bg-white">
                <table class="flex-1">
                  <thead>
                    <tr class="bg-white">
                      <th class="table-1c410645-b249-4dfa-bf2c-eaf7bcf13a30-column-120 px-4 py-3 text-left text-[#181111] w-[400px] text-sm font-medium leading-normal">Task</th>
                      <th class="table-1c410645-b249-4dfa-bf2c-eaf7bcf13a30-column-240 px-4 py-3 text-left text-[#181111] w-[400px] text-sm font-medium leading-normal">
                        Assigned To
                      </th>
                      <th class="table-1c410645-b249-4dfa-bf2c-eaf7bcf13a30-column-360 px-4 py-3 text-left text-[#181111] w-[400px] text-sm font-medium leading-normal">
                        Description
                      </th>
                      <th class="table-1c410645-b249-4dfa-bf2c-eaf7bcf13a30-column-480 px-4 py-3 text-left text-[#181111] w-[400px] text-sm font-medium leading-normal">
                        Last Completed
                      </th>
                      <th class="table-1c410645-b249-4dfa-bf2c-eaf7bcf13a30-column-600 px-4 py-3 text-left text-[#181111] w-[400px] text-sm font-medium leading-normal">Status</th>
                      <th
                        class="table-1c410645-b249-4dfa-bf2c-eaf7bcf13a30-column-720 px-4 py-3 text-left text-[#181111] w-60 text-[#886363] text-sm font-medium leading-normal"
                      ></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (data.length === 0) { %>
                      <tr>
                        <td colspan="5" class="text-center py-4 text-[#886363]">No tasks found.</td>
                      </tr>
                    <% } else { %>
                      <% data.forEach(function(item) { %>
                        <tr class="border-t border-t-[#e5dcdc]">
                          <td class="px-4 py-2 text-[#181111] text-sm font-normal leading-normal"><%= item.title %></td>
                          <td class="px-4 py-2 text-[#886363] text-sm font-normal leading-normal"><%= item.assigned_to %></td>
                          <td class="px-4 py-2 text-[#886363] text-sm font-normal leading-normal"><%= item.description %></td>
                          <td class="px-4 py-2 text-[#886363] text-sm font-normal leading-normal">
                            <%= item.task_completion_date.toDateString ? item.task_completion_date.toDateString() : item.task_completion_date %>
                          </td>
                          <td class="px-4 py-2 text-sm font-normal leading-normal">
                            <div class="flex items-center gap-3">
                              <div class="w-[88px] overflow-hidden rounded-sm bg-[#e5dcdc]">
                                <div class="h-1 rounded-full bg-[#181111]" style="width: <%= item.task_status %>%"></div>
                              </div>
                              <p class="text-[#181111] text-sm font-medium leading-normal"><%= item.task_status %></p>
                            </div>
                          </td>
                        </tr>
                      <% }); %>
                    <% } %>
                  </tbody>
                </table>
              </div>
              <style>
                          @container(max-width:120px){.table-1c410645-b249-4dfa-bf2c-eaf7bcf13a30-column-120{display: none;}}
                @container(max-width:240px){.table-1c410645-b249-4dfa-bf2c-eaf7bcf13a30-column-240{display: none;}}
                @container(max-width:360px){.table-1c410645-b249-4dfa-bf2c-eaf7bcf13a30-column-360{display: none;}}
                @container(max-width:480px){.table-1c410645-b249-4dfa-bf2c-eaf7bcf13a30-column-480{display: none;}}
                @container(max-width:600px){.table-1c410645-b249-4dfa-bf2c-eaf7bcf13a30-column-600{display: none;}}
                @container(max-width:720px){.table-1c410645-b249-4dfa-bf2c-eaf7bcf13a30-column-720{display: none;}}
              </style>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>











