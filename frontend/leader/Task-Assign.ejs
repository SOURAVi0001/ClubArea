<html>
  <head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link
      rel="stylesheet"
      as="style"
      onload="this.rel='stylesheet'"
      href="https://fonts.googleapis.com/css2?display=swap&amp;family=Lexend%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900"
    />

    <title>Stitch Design</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  </head>
  <body>
    <div
      class="relative flex size-full min-h-screen flex-col bg-white group/design-root overflow-x-hidden"
      style="--checkbox-tick-svg: url('data:image/svg+xml,%3csvg viewBox=%270 0 16 16%27 fill=%27rgb(22,18,18)%27 xmlns=%27http://www.w3.org/2000/svg%27%3e%3cpath d=%27M12.207 4.793a1 1 0 010 1.414l-5 5a1 1 0 01-1.414 0l-2-2a1 1 0 011.414-1.414L6.5 9.086l4.293-4.293a1 1 0 011.414 0z%27/%3e%3c/svg%3e'); --select-button-svg: url('data:image/svg+xml,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2724px%27 height=%2724px%27 fill=%27rgb(129,106,106)%27 viewBox=%270 0 256 256%27%3e%3cpath d=%27M181.66,170.34a8,8,0,0,1,0,11.32l-48,48a8,8,0,0,1-11.32,0l-48-48a8,8,0,0,1,11.32-11.32L128,212.69l42.34-42.35A8,8,0,0,1,181.66,170.34Zm-96-84.68L128,43.31l42.34,42.35a8,8,0,0,0,11.32-11.32l-48-48a8,8,0,0,0-11.32,0l-48,48A8,8,0,0,0,85.66,85.66Z%27%3e%3c/path%3e%3c/svg%3e'); font-family: Lexend, &quot;Noto Sans&quot;, sans-serif;"
    >
      <div class="layout-container flex h-full grow flex-col">
        <div class="px-40 flex flex-1 justify-center py-5">
            <%- include('./partials/header.ejs') %>
          <form 
          method="POST"
  action="/leader-Create-Task"
  class="layout-content-container flex flex-col max-w-[960px] flex-1"
>
  <div class="flex flex-wrap justify-between gap-3 p-4">
    <p class="text-[#161212] tracking-light text-[32px] font-bold leading-tight min-w-72">
      Assign Task
    </p>
  </div>

  <!-- Member Name -->
  <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
    <label class="flex flex-col min-w-40 flex-1">
      <p class="text-[#161212] text-base font-medium leading-normal pb-2">Member Name</p>
      <select
        name="assigned_to"
        required
        class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#161212] focus:outline-0 focus:ring-0 border border-[#e3dddd] bg-white focus:border-[#e3dddd] h-14 bg-[image:--select-button-svg] placeholder:text-[#816a6a] p-[15px] text-base font-normal leading-normal"
      >
        <% member.forEach(m => { %>
  <option value="<%= m.name %>"><%= m.name %></option>
<% }) %>
      </select>
    </label>
  </div>

  <!-- Task Title -->
  <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
    <label class="flex flex-col min-w-40 flex-1">
      <p class="text-[#161212] text-base font-medium leading-normal pb-2">Task Title</p>
      <input
        name="task_title"
        required
        placeholder="Enter task title"
        class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#161212] focus:outline-0 focus:ring-0 border border-[#e3dddd] bg-white focus:border-[#e3dddd] h-14 placeholder:text-[#816a6a] p-[15px] text-base font-normal leading-normal"
      />
    </label>
  </div>

  <!-- Description -->
  <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
    <label class="flex flex-col min-w-40 flex-1">
      <p class="text-[#161212] text-base font-medium leading-normal pb-2">Description</p>
      <textarea
        name="task_description"
        required
        placeholder="Enter task description"
        class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#161212] focus:outline-0 focus:ring-0 border border-[#e3dddd] bg-white focus:border-[#e3dddd] min-h-36 placeholder:text-[#816a6a] p-[15px] text-base font-normal leading-normal"
      ></textarea>
    </label>
  </div>

  <!-- Completion Date -->
  <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
    <label class="flex flex-col min-w-40 flex-1">
      <p class="text-[#161212] text-base font-medium leading-normal pb-2">Last Date of Completion</p>
      <input
        name="task_completion_date"
        type="date"
        required
        class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#161212] focus:outline-0 focus:ring-0 border border-[#e3dddd] bg-white focus:border-[#e3dddd] h-14 placeholder:text-[#816a6a] p-[15px] text-base font-normal leading-normal"
      />
    </label>
  </div>

  <!-- Optional Warning Checkbox -->
  <div class="px-4">
    <label class="flex gap-x-3 py-3 flex-row">
      <input
        type="checkbox"
        name="warning"
        class="h-5 w-5 rounded border-[#e3dddd] border-2 bg-transparent text-[#e5b2b2] checked:bg-[#e5b2b2] checked:border-[#e5b2b2] checked:bg-[image:--checkbox-tick-svg] focus:ring-0 focus:ring-offset-0 focus:border-[#e3dddd] focus:outline-none"
      />
      <p class="text-[#161212] text-base font-normal leading-normal">Set Warning</p>
    </label>
  </div>

  <!-- Submit Button -->
  <div class="flex px-4 py-3 justify-end">
    <button
      type="submit"
      class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-4 bg-[#e5b2b2] text-[#161212] text-sm font-bold leading-normal tracking-[0.015em]"
    >
      <span class="truncate">Assign Task</span>
    </button>
  </div>
</form>
        </div>
      </div>
    </div>
  </body>
</html>
