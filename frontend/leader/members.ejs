<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700;900&family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap"
  />

  <title>Members</title>
  <link rel="icon" type="image/x-icon" href="image/x-icon;base64," />

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>
<body class="bg-gray-50 text-gray-800" style='font-family: "Plus Jakarta Sans", "Noto Sans", sans-serif;'>
  
  <!-- Include the sidebar partial -->
  <%- include('partials/sidebar', { 
    Leader_Name: Leader_Name, 
    Club_Name: Club_Name, 
    currentPage: 'members' 
  }) %>

  <!-- Main Content Area with margin for sidebar -->
  <main class="ml-0 md:ml-80 min-h-screen bg-[#fcf8f8]">
    <div class="max-w-[960px] mx-auto px-6 py-8">
      
      <!-- Page Header -->
      <header class="mb-8">
        <h1 class="text-4xl font-bold text-[#1b0e0e] mb-2"> Members Management</h1>
        <p class="text-gray-600">Manage and view all club members and their teams</p>
      </header>

      <!-- Members Table Section -->
      <section class="mb-12">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-[#1b0e0e]"> All Members</h2>
          <div class="text-sm text-gray-500">
            <%= members.length %> total members
          </div>
        </div>

        <!-- Enhanced Table Container -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="bg-gray-50 border-b border-gray-200">
                  <th class="px-6 py-4 text-left text-[#1b0e0e] text-sm font-semibold">Profile</th>
                  <th class="px-6 py-4 text-left text-[#1b0e0e] text-sm font-semibold">Name</th>
                  <th class="px-6 py-4 text-left text-[#1b0e0e] text-sm font-semibold">Team</th>
                  <th class="px-6 py-4 text-left text-[#1b0e0e] text-sm font-semibold">Email</th>
                  <th class="px-6 py-4 text-left text-[#1b0e0e] text-sm font-semibold">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <% members.forEach((memberss, index) => { %>
                  <tr class="hover:bg-gray-50 transition-colors duration-200">
                    <!-- Profile Picture -->
                    <td class="px-6 py-4">
                      <div class="w-12 h-12 rounded-full bg-center bg-cover bg-no-repeat border-2 border-white shadow-md"
                           style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuCdzN9dP90LqFZUtXI4I5zvmUjuyZEP3_saSiiiu4trKeSPQUjdXKMSHotJnAvbYGPObjpYZtXX_I4tYtyzjrVLPwi6_3GYbV32kSX0QaivQ5tn85MCdk_w7VPsEIW8pP2SXstkSx0L0z9OQOYYSnr8SjrUq4wACRRsaqQ_PmD9gm8zVXBL3WGYHt0LFc2-2l5PYObrELTlVOj7P6WhufiTVmWgornqkEpin2i_VU4cSGMrx8rpTyZSSIHeBgpMf5KNioLDWtQODBA");'>
                      </div>
                    </td>
                    
                    <!-- Name -->
                    <td class="px-6 py-4">
                      <div class="flex flex-col">
                        <span class="text-[#1b0e0e] font-semibold text-base"><%= memberss.name %></span>
                        <span class="text-gray-500 text-sm">Member #<%= index + 1 %></span>
                      </div>
                    </td>
                    
                    <!-- Team -->
                    <td class="px-6 py-4">
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                        <%= memberss.teamName %>
                      </span>
                    </td>
                    
                    <!-- Email -->
                    <td class="px-6 py-4">
                      <a href="mailto:<%= memberss.email %>" class="text-blue-600 hover:text-blue-800 transition-colors flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                        <%= memberss.email %>
                      </a>
                    </td>
                    
                    <!-- Actions -->
                    <td class="px-6 py-4">
                      <div class="flex gap-2">
                        <button class="p-2 text-blue-600 hover:bg-blue-100 rounded-lg transition-colors" title="View Profile">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                          </svg>
                        </button>
                        <button class="p-2 text-green-600 hover:bg-green-100 rounded-lg transition-colors" title="Send Message">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                          </svg>
                        </button>
                        <button class="p-2 text-orange-600 hover:bg-orange-100 rounded-lg transition-colors" title="Edit Member">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Upcoming Event Section -->
    
    </div>
  </main>

</body>
</html>
