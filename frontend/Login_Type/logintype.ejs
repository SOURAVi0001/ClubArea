<html>
  <head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link
      rel="stylesheet"
      as="style"
      onload="this.rel='stylesheet'"
      href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900"
    />

    <title>Stitch Design</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  </head>
  <body class="min-h-screen relative bg-[url('/your/image.jpg')] bg-cover bg-center bg-no-repeat" style='font-family: Inter, "Noto Sans", sans-serif;'>
    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/100 to-black/60"></div>

    <!-- Foreground content -->
    <div class="relative z-10 flex items-center justify-center min-h-screen">
      <div class="text-white text-center w-full">
        <div class="flex flex-wrap gap-8 justify-center items-center h-[60vh]">
          <button
            id="admin-login"
            class="flex w-64 h-64 cursor-pointer items-center justify-center overflow-hidden rounded-2xl bg-[#197ce5] text-white text-2xl font-bold leading-normal tracking-[0.025em] hover:scale-105 transition-transform duration-200 shadow-lg"
          >
            <span class="truncate">Admin Login</span>
          </button>
          <button
            id="user-login"
            class="flex w-64 h-64 cursor-pointer items-center justify-center overflow-hidden rounded-2xl bg-[#243547] text-white text-2xl font-bold leading-normal tracking-[0.025em] hover:scale-105 transition-transform duration-200 shadow-lg"
          >
            <span class="truncate">User Login</span>
          </button>
        </div>
      </div>
    </div>
    <script>
      document.getElementById('admin-login').onclick = function(){
        window.location.href = '/admin_login';
      };
      document.getElementById('user-login').onclick = function(){
        window.location.href = '/user_login';
      };
    </script>
  </body>
</html>