<style>
  /* Custom Menu Icon Animation */
  .menu-icon {
    width: 20px;
    height: 16px;
    position: relative;
  }
  
  .menu-line {
    position: absolute;
    width: 20px;
    height: 2px;
    background-color: currentColor;
    border-radius: 1px;
    transition: all 0.3s ease;
  }
  
  /* Active Menu Animation */
  .menu-icon.active .menu-line:nth-child(1) {
    transform: rotate(45deg) translate(6px, 6px);
  }
  
  .menu-icon.active .menu-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  
  .menu-icon.active .menu-line:nth-child(3) {
    transform: rotate(-45deg) translate(6px, -6px);
  }

  /* Mobile Menu States */
  #mobile-menu.open {
    transform: translateX(0);
  }
  
  #mobile-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  /* Active Navigation States */
  .nav-item.active,
  .mobile-nav-item.active {
    background-color: rgba(168, 85, 247, 0.2) !important;
    color: #d946ef !important;
    border: 1px solid rgba(217, 70, 239, 0.3) !important;
  }

  .mobile-nav-item.active span:first-child {
    color: #d946ef !important;
  }

  /* Enhanced hover states for mobile menu */
  .mobile-nav-item:hover {
    background-color: #1e293b !important;
  }

  /* Focus States */
  .nav-item:focus,
  .mobile-nav-item:focus {
    outline: 2px solid #d946ef;
    outline-offset: 2px;
  }
</style>

<script>
  class ModernNavbar {
    constructor() {
      this.mobileMenuToggle = document.getElementById('mobile-menu-toggle');
      this.mobileMenu = document.getElementById('mobile-menu');
      this.mobileOverlay = document.getElementById('mobile-overlay');
      this.closeMobileMenu = document.getElementById('close-mobile-menu');
      this.menuIcon = document.querySelector('.menu-icon');
      this.isMenuOpen = false;

      this.init();
    }

    init() {
      // Event listeners
      this.mobileMenuToggle?.addEventListener('click', () => this.toggleMenu());
      this.closeMobileMenu?.addEventListener('click', () => this.closeMenu());
      this.mobileOverlay?.addEventListener('click', () => this.closeMenu());
      
      // Close menu when clicking nav links
      document.querySelectorAll('.mobile-nav-item').forEach(link => {
        link.addEventListener('click', () => {
          setTimeout(() => this.closeMenu(), 100);
        });
      });

      // Escape key handler
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isMenuOpen) {
          this.closeMenu();
        }
      });

      // Window resize handler
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024 && this.isMenuOpen) {
          this.closeMenu();
        }
      });

      // Set active navigation on page load
      this.setActiveNavigation();
      
      // Update active navigation when clicking links
      document.querySelectorAll('.nav-item, .mobile-nav-item').forEach(link => {
        link.addEventListener('click', () => {
          setTimeout(() => this.setActiveNavigation(), 50);
        });
      });
    }

    toggleMenu() {
      if (this.isMenuOpen) {
        this.closeMenu();
      } else {
        this.openMenu();
      }
    }

    openMenu() {
      this.isMenuOpen = true;
      this.mobileMenu?.classList.add('open');
      this.mobileOverlay?.classList.add('open');
      this.menuIcon?.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    closeMenu() {
      this.isMenuOpen = false;
      this.mobileMenu?.classList.remove('open');
      this.mobileOverlay?.classList.remove('open');
      this.menuIcon?.classList.remove('active');
      document.body.style.overflow = '';
    }

    setActiveNavigation() {
      const currentPath = window.location.pathname;
      const navLinks = document.querySelectorAll('.nav-item, .mobile-nav-item');
      
      // Clear all active states first
      navLinks.forEach(link => {
        link.classList.remove('active');
      });
      
      // Find and set the active link
      navLinks.forEach(link => {
        const href = link.getAttribute('href');
        
        // Direct match
        if (href === currentPath) {
          link.classList.add('active');
          return;
        }
        
        // Handle home page special case
        if (currentPath === '/' && href === '/') {
          link.classList.add('active');
          return;
        }
        
        // Handle trailing slash variations
        const normalizedHref = href.replace(/\/$/, '') || '/';
        const normalizedPath = currentPath.replace(/\/$/, '') || '/';
        
        if (normalizedHref === normalizedPath) {
          link.classList.add('active');
          return;
        }
      });
    }
  }

  // Initialize navbar
  document.addEventListener('DOMContentLoaded', () => {
    new ModernNavbar();
  });

  // Also set active navigation when the page loads (backup)
  window.addEventListener('load', () => {
    setTimeout(() => {
      const navbar = new ModernNavbar();
      navbar.setActiveNavigation();
    }, 100);
  });
</script>
