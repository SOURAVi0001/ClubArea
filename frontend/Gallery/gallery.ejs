<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link
      rel="stylesheet"
      as="style"
      onload="this.rel='stylesheet'"
      href="https://fonts.googleapis.com/css2?display=swap&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900&amp;family=Spline+Sans%3Awght%40400%3B500%3B700"
    />

    <title><%= title || 'ClubEaria - Gallery' %></title>
    <link rel="icon" type="image/x-icon" href="image/x-icon;base64," />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    
    <style>
        .club-row {
            scroll-behavior: smooth;
        }
        .image-container {
            transition: transform 0.2s ease;
        }
        .image-container:hover {
            transform: scale(1.05);
        }
        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.9);
        }
        .modal.active {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .modal img {
            max-width: 90%;
            max-height: 80vh;
            object-fit: contain;
        }
        .close-modal {
            position: fixed;
            top: 20px;
            right: 30px;
            color: white;
            font-size: 30px;
            cursor: pointer;
            background: rgba(0,0,0,0.7);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .scroll-btn {
            background: rgba(0,0,0,0.5);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .scroll-btn:hover {
            background: rgba(0,0,0,0.8);
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <div class="min-h-screen bg-slate-900 text-white pt-20" style='font-family: "Spline Sans", "Noto Sans", sans-serif;'>
        <div class="max-w-7xl mx-auto px-6 py-8">
            
            <!-- Header Section -->
            <div class="text-left mb-8">
                <h1 class="text-4xl font-bold text-gray mb-4">Gallery</h1>
                
            </div>
            <!-- Club Rows -->
            <% if (clubGalleries && clubGalleries.length > 0) { %>
                <div class="space-y-8">
                    <% clubGalleries.forEach(function(club, clubIndex) { %>
                    <div class="club-section" data-club="<%= club.clubName %>">
                        
                        <!-- Club Header -->
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <h2 class="text-2xl font-bold text-white"><%= club.clubName %></h2>
                                <p class="text-slate-400 text-sm">
                                    <%= club.events.length %> Events • 
                                    <%= club.events.reduce((sum, event) => sum + event.photos.length, 0) %> Photos
                                </p>
                            </div>
                            <div class="flex gap-2">
                                <button class="scroll-btn" onclick="scrollLeft('club-<%= clubIndex %>')">‹</button>
                                <button class="scroll-btn" onclick="scrollRight('club-<%= clubIndex %>')">›</button>
                            </div>
                        </div>

                        <!-- Horizontal Scrollable Images -->
                        <div class="relative">
                            <div id="club-<%= clubIndex %>" class="flex gap-4 overflow-x-auto scrollbar-hide pb-2" style="scroll-behavior: smooth;">
                                <% club.events.forEach(function(event) { %>
                                    <% event.photos.forEach(function(photo, photoIndex) { %>
                                    <div class="image-container flex-shrink-0 w-48 h-32 bg-cover bg-center rounded-lg cursor-pointer relative overflow-hidden border border-slate-700"
                                         style='background-image: url("<%= photo %>");'
                                         onclick="openModal('<%= photo %>', '<%= event.title %>', '<%= club.clubName %>', '<%= new Date(event.date).toLocaleDateString() %>', '<%= event.venue || '' %>', '<%= event.description || '' %>')">
                                        
                                        <!-- Image overlay with event info -->
                                        <div class="absolute inset-0 bg-black bg-opacity-0 hover:bg-opacity-60 transition-all duration-200 flex items-end">
                                            <div class="p-3 text-white opacity-0 hover:opacity-100 transition-opacity duration-200">
                                                <p class="text-xs font-semibold truncate"><%= event.title %></p>
                                                <p class="text-xs text-slate-300 truncate">
                                                    <%= new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <% }); %>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                </div>
            <% } else { %>
            <!-- No Clubs Found -->
            <div class="text-center py-16">
                <div class="text-6xl mb-4">📸</div>
                <h3 class="text-white text-2xl font-bold mb-2">No Gallery Items</h3>
                <p class="text-slate-400">No event photos have been uploaded yet.</p>
            </div>
            <% } %>

            <!-- Error Message -->
            <% if (typeof error !== 'undefined') { %>
            <div class="p-4 bg-red-900/20 border border-red-700 rounded-lg text-red-200 text-center mt-8">
                ⚠️ <%= error %>
            </div>
            <% } %>
        </div>
    </div>

    <!-- Photo Modal -->
    <div id="photoModal" class="modal">
        <span class="close-modal" onclick="closeModal()">×</span>
        <div class="text-center">
            <img id="modalImage" src="" alt="" class="rounded-lg">
            <div class="bg-slate-800 text-white p-4 rounded-lg mt-4 max-w-md mx-auto">
                <h3 id="modalTitle" class="font-bold text-lg mb-2"></h3>
                <div class="text-sm text-slate-300 space-y-1">
                    <p><strong>Club:</strong> <span id="modalClub"></span></p>
                    <p><strong>Date:</strong> <span id="modalDate"></span></p>
                    <p id="modalVenueContainer"><strong>Venue:</strong> <span id="modalVenue"></span></p>
                    <p id="modalDescriptionContainer"><strong>Description:</strong> <span id="modalDescription"></span></p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Search functionality
        document.getElementById('searchInput')?.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            const clubSections = document.querySelectorAll('.club-section');
            
            clubSections.forEach(section => {
                const clubName = section.dataset.club.toLowerCase();
                if (clubName.includes(searchTerm) || searchTerm === '') {
                    section.style.display = 'block';
                } else {
                    section.style.display = 'none';
                }
            });
        });

        // Scroll functions
        function scrollLeft(containerId) {
            const container = document.getElementById(containerId);
            container.scrollBy({ left: -300, behavior: 'smooth' });
        }

        function scrollRight(containerId) {
            const container = document.getElementById(containerId);
            container.scrollBy({ left: 300, behavior: 'smooth' });
        }

        // Modal functionality
        function openModal(imageSrc, title, club, date, venue, description) {
            document.getElementById('modalImage').src = imageSrc;
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalClub').textContent = club;
            document.getElementById('modalDate').textContent = date;
            
            // Show/hide venue and description if they exist
            const venueContainer = document.getElementById('modalVenueContainer');
            const descriptionContainer = document.getElementById('modalDescriptionContainer');
            
            if (venue) {
                document.getElementById('modalVenue').textContent = venue;
                venueContainer.style.display = 'block';
            } else {
                venueContainer.style.display = 'none';
            }
            
            if (description) {
                document.getElementById('modalDescription').textContent = description;
                descriptionContainer.style.display = 'block';
            } else {
                descriptionContainer.style.display = 'none';
            }
            
            document.getElementById('photoModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            document.getElementById('photoModal').classList.remove('active');
            document.body.style.overflow = 'auto';
        }

        // Close modal when clicking outside
        document.getElementById('photoModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });

        // Close modal with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });

        // Touch/swipe support for mobile
        let startX = null;
        
        document.querySelectorAll('[id^="club-"]').forEach(container => {
            container.addEventListener('touchstart', function(e) {
                startX = e.touches[0].clientX;
            });
            
            container.addEventListener('touchmove', function(e) {
                if (startX === null) return;
                
                const currentX = e.touches[0].clientX;
                const diff = startX - currentX;
                
                if (Math.abs(diff) > 50) {
                    if (diff > 0) {
                        scrollRight(this.id);
                    } else {
                        scrollLeft(this.id);
                    }
                    startX = null;
                }
            });
        });
    </script>
</body>
</html>
