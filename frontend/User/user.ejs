<%- include('../partials/head') %>

<!-- ============ User Applications Dashboard ============ -->
<section class="relative min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 overflow-hidden">
  
  <!-- Animated Background Elements -->
  <div class="absolute inset-0">
    <div class="absolute top-20 left-10 w-72 h-72 bg-purple-300 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-blob"></div>
    <div class="absolute top-40 right-10 w-72 h-72 bg-yellow-300 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-blob animation-delay-2000"></div>
    <div class="absolute bottom-20 left-20 w-72 h-72 bg-pink-300 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-blob animation-delay-4000"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 py-12">
    
    <!-- ===== HERO SECTION ===== -->
    <header class="text-center mb-16">
      <div class="glass-card p-8 rounded-3xl max-w-4xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">
  <span class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 bg-clip-text text-transparent">
    Your Career Journey,
  </span>
  <span class="bg-gradient-to-r from-yellow-400 via-red-500 to-pink-500 bg-clip-text text-transparent ml-2">
    <%= username %>
  </span>
</h1>
        <p class="text-xl text-gray-600 mb-6 max-w-2xl mx-auto">
          Discover amazing opportunities and track your application progress 
        </p>
        
        <!-- Quick Stats -->
        <div class="flex flex-wrap justify-center gap-8 text-sm">
          <div class="text-center">
            <div class="text-2xl font-bold text-indigo-600">
              <%= opening ? opening.filter(op => op.status === 'active').length : 0 %>
            </div>
            <div class="text-black">Available Positions</div>
          </div>
          <div class="text-center">
  <div class="text-2xl font-bold text-purple-600" id="userApplicationsCount">
    <%= openingsApplied.length %>
  </div>
  <div class="text-gray-600">Your Applications</div> <!-- FIXED -->
</div>
          <div class="text-center">
            <div class="text-2xl font-bold text-pink-600" id="successRate">
  <% if (openingsApplied && openingsApplied.length > 0) { %>
    <%= ((openingsApplied.filter(op => op.status === 'accepted').length * 100) / openingsApplied.length).toFixed(1) %>%
  <% } else { %>
    0%
  <% } %>
</div>
            <div class="text-gray-500">Success Rate</div>
          </div>
        </div>
      </div>
    </header>

    <!-- ===== YOUR APPLICATIONS STATUS ===== -->
    <section class="mb-16">
     <% if (openingsApplied && openingsApplied.length > 0) { %>
  <h2 class="text-black text-xl font-bold mb-4">Your Applications</h2>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="appliedOpeningsGrid">
    <% openingsApplied.forEach((op, index) => { 
      const maxApplicants = op.maxApplicants || 25;
      const currentApplicants = op.applicantCount || 0;
      const progressPercent = Math.min((currentApplicants / maxApplicants) * 100, 100);
      const createdDate = new Date(op.createdDate || Date.now());
      const deadline = new Date(createdDate.getTime() + (30 * 24 * 60 * 60 * 1000));
      const daysLeft = Math.ceil((deadline.getTime() - new Date().getTime()) / (24 * 60 * 60 * 1000));
      
      const teamColors = {
        'Technical Team': { bg: 'from-emerald-400 to-teal-500', text: 'text-emerald-600', icon: 'emerald' },
        'Marketing Team': { bg: 'from-purple-400 to-pink-500', text: 'text-purple-600', icon: 'purple' },
        'Events Team': { bg: 'from-blue-400 to-indigo-500', text: 'text-blue-600', icon: 'blue' },
        'Content Team': { bg: 'from-orange-400 to-red-500', text: 'text-orange-600', icon: 'orange' },
        'Design Team': { bg: 'from-pink-400 to-rose-500', text: 'text-pink-600', icon: 'pink' }
      };
      const teamStyle = teamColors[op.teamName] || teamColors['Technical Team'];
    %>
    <div class="opportunity-card group" data-team="<%= op.teamName %>">
      <div class="glass-card p-6 h-full hover:shadow-2xl transition-all duration-300">
        <!-- Header (same as before) -->
        <div class="flex items-start justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-r <%= teamStyle.bg %> flex items-center justify-center text-white">
              <!-- (SVG Icon, same as before) -->
            </div>
            <div>
              <h3 class="text-lg font-bold text-gray-800"><%= op.role || 'Member' %></h3>
              <p class="text-sm <%= teamStyle.text %> font-medium"><%= op.teamName %></p>
            </div>
          </div>
          <!-- Show Application Status Here -->
          <div class="flex flex-col items-end gap-1">
            <span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-medium rounded-full">
              Applied
            </span>
            <span class="px-2 py-1 text-xs font-medium rounded-full
  <% if (op.status === 'accepted') { %> bg-green-100 text-green-700
  <% } else if (op.status === 'pending') { %> bg-orange-100 text-orange-700
  <% } else if (op.status === 'rejected') { %> bg-red-100 text-red-700
  <% } %>">
  Status: <%= op.status.charAt(0).toUpperCase() + op.status.slice(1) %>
</span>
            <% if (daysLeft <= 3 && daysLeft > 0) { %>
              <span class="px-2 py-1 bg-red-100 text-red-700 text-xs font-medium rounded-full animate-pulse">
                <%= daysLeft %>d left
              </span>
            <% } %>
          </div>
        </div>
        <!-- Description, Progress Bar, Details (same as before) -->
        <p class="text-gray-600 text-sm mb-4 line-clamp-3">
          <%= op.description || 'Join our dynamic team and contribute to exciting projects!' %>
        </p>
        <div class="mb-4">
          <div class="flex justify-between text-xs text-gray-500 mb-1">
            <span>Applications</span>
            <span><%= currentApplicants %>/<%= maxApplicants %></span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-2">
            <div class="bg-gradient-to-r <%= teamStyle.bg %> h-2 rounded-full"
                 style="width: <%= progressPercent %>%"></div>
          </div>
        </div>
        <div class="flex justify-between items-center text-xs text-gray-500 mb-6">
          <span class="flex items-center gap-1">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"/>
            </svg>
            Deadline: <%= deadline.toLocaleDateString() %>
          </span>
          <span class="flex items-center gap-1">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <%= op.clubName || 'ClubEaria' %>
          </span>
        </div>
        <!-- Instead of "Apply Now", show "You have applied" -->
        <button
          class="bg-gray-200 text-gray-400 cursor-not-allowed font-semibold w-full py-2 rounded transition"
          disabled>
          You have applied
        </button>
      </div>
    </div>
    <% }) %>
  </div>
<% } %>


      <div id="userApplications" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <!-- Applications will be loaded here -->
        <div class="application-skeleton">
          <div class="animate-pulse">
            <div class="h-4 bg-gray-200 rounded w-3/4 mb-2"></div>
            <div class="h-3 bg-gray-200 rounded w-1/2 mb-4"></div>
            <div class="h-8 bg-gray-200 rounded w-1/3"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== AVAILABLE OPPORTUNITIES ===== -->
    <section>
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold text-gray-800 flex items-center gap-3">
          <div class="w-1 h-8 bg-gradient-to-b from-purple-500 to-pink-600 rounded"></div>
          Available Opportunities
        </h2>
      </div>

      <% if (opening && opening.filter(op => op.status === 'active').length > 0) { %>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="openingsGrid">
          <% opening.filter(op => op.status === 'active').forEach((op, index) => { 
            const maxApplicants = op.maxApplicants || 25;
            const currentApplicants = op.applicantCount || 0;
            const progressPercent = Math.min((currentApplicants / maxApplicants) * 100, 100);
            const createdDate = new Date(op.createdDate || Date.now());
            const deadline = new Date(createdDate.getTime() + (30 * 24 * 60 * 60 * 1000));
            const daysLeft = Math.ceil((deadline.getTime() - new Date().getTime()) / (24 * 60 * 60 * 1000));
            
            const teamColors = {
              'Technical Team': { bg: 'from-emerald-400 to-teal-500', text: 'text-emerald-600', icon: 'emerald' },
              'Marketing Team': { bg: 'from-purple-400 to-pink-500', text: 'text-purple-600', icon: 'purple' },
              'Events Team': { bg: 'from-blue-400 to-indigo-500', text: 'text-blue-600', icon: 'blue' },
              'Content Team': { bg: 'from-orange-400 to-red-500', text: 'text-orange-600', icon: 'orange' },
              'Design Team': { bg: 'from-pink-400 to-rose-500', text: 'text-pink-600', icon: 'pink' }
            };
            
            const teamStyle = teamColors[op.teamName] || teamColors['Technical Team'];
          %>
          
          <div class="opportunity-card group" data-team="<%= op.teamName %>">
            <div class="glass-card p-6 h-full hover:shadow-2xl transition-all duration-300">
              
              <!-- Header -->
              <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-xl bg-gradient-to-r <%= teamStyle.bg %> flex items-center justify-center text-white">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                      <% if (op.teamName === 'Technical Team') { %>
                        <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z"/>
                      <% } else if (op.teamName === 'Marketing Team') { %>
                        <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"/>
                      <% } else { %>
                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"/>
                      <% } %>
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-lg font-bold text-gray-800"><%= op.role || 'Member' %></h3>
                    <p class="text-sm <%= teamStyle.text %> font-medium"><%= op.teamName %></p>
                  </div>
                </div>
                
                <div class="flex flex-col items-end gap-1">
                  <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">
                    Active
                  </span>
                  <% if (daysLeft <= 3 && daysLeft > 0) { %>
                  <span class="px-2 py-1 bg-red-100 text-red-700 text-xs font-medium rounded-full animate-pulse">
                    <%= daysLeft %>d left
                  </span>
                  <% } %>
                </div>
              </div>

              <!-- Description -->
              <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                <%= op.description || 'Join our dynamic team and contribute to exciting projects!' %>
              </p>

              <!-- Progress Bar -->
              <div class="mb-4">
                <div class="flex justify-between text-xs text-gray-500 mb-1">
                  <span>Applications</span>
                  <span><%= currentApplicants %>/<%= maxApplicants %></span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-gradient-to-r <%= teamStyle.bg %> h-2 rounded-full transition-all duration-500" 
                       style="width: <%= progressPercent %>%"></div>
                </div>
              </div>

              <!-- Details -->
              <div class="flex justify-between items-center text-xs text-gray-500 mb-6">
                <span class="flex items-center gap-1">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"/>
                  </svg>
                  Deadline: <%= deadline.toLocaleDateString() %>
                </span>
                <span class="flex items-center gap-1">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <%= op.clubName || 'ClubEaria' %>
                </span>
              </div>

              <!-- Apply Now Button -->
              <button onclick="applyToOpening('<%= op.clubName %>', '<%= op.teamName %>')" 
                      class="btn-apply group w-full text-black"
                      id="apply-btn-<%= op._id %>">
                <span>Apply Now</span>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                </svg>
              </button>
            </div>
          </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-16">
          <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0H8m8 0v2a2 2 0 01-2 2H10a2 2 0 01-2-2V6"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-400 mb-2">No Active Openings</h3>
          <p class="text-gray-500">Check back soon for new opportunities!</p>
        </div>
      <% } %>
    </section>
  </div>
</section>

<!-- ============ Enhanced Styles ============ -->
<style>
  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }

  .animate-blob {
    animation: blob 7s infinite;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-4000 {
    animation-delay: 4s;
  }

  .glass-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }

  .opportunity-card {
    transform: translateY(0);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .opportunity-card:hover {
    transform: translateY(-8px);
  }

  .btn-apply {
    @apply flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r 
           from-indigo-500 to-purple-600 px-6 py-3 font-semibold text-white
           transition-all duration-300 hover:scale-105 hover:shadow-lg
           focus:outline-none focus:ring-2 focus:ring-indigo-500/50;
  }

  .btn-apply:disabled {
    @apply opacity-50 cursor-not-allowed transform-none;
  }

  .btn-apply.loading {
    @apply opacity-70;
  }

  .btn-refresh {
    @apply flex items-center gap-2 rounded-lg bg-white/80 px-3 py-2 text-sm font-medium
           text-gray-600 backdrop-blur-sm transition-all duration-200 hover:bg-white
           focus:outline-none focus:ring-2 focus:ring-indigo-500/50;
  }

  .filter-btn {
    @apply px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200
           border border-gray-200 bg-white/80 text-gray-600 hover:bg-indigo-50
           focus:outline-none focus:ring-2 focus:ring-indigo-500/50;
  }

  .filter-btn.active {
    @apply bg-indigo-500 text-white border-indigo-500;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .status-badge {
    @apply px-3 py-1 rounded-full text-xs font-medium;
  }

  .status-hired {
    @apply bg-green-100 text-green-700;
  }

  .status-rejected {
    @apply bg-red-100 text-red-700;
  }

  .status-pending {
    @apply bg-yellow-100 text-yellow-700;
  }

  .status-under-review {
    @apply bg-blue-100 text-blue-700;
  }

  .application-skeleton {
    @apply glass-card p-6 rounded-xl;
  }

  /* Loading spinner */
  .loading-spinner {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 2px solid #ffffff;
    border-radius: 50%;
    border-top-color: transparent;
    animation: spin 1s ease-in-out infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .text-4xl {
      font-size: 2rem;
    }
    
    .sm\:text-5xl {
      font-size: 2.5rem;
    }
    
    .opportunity-card:hover {
      transform: translateY(-4px);
    }

    .filter-btn {
      @apply px-3 py-1 text-xs;
    }
  }
</style>

<script>
  // Store user applications data
  let userApplications = [];
  let appliedRoles = new Set(); // Track applied roles to filter them out

  // Initialize fake user data
  function initializeUserData() {
    const userNames = ['John Doe', 'Jane Smith', 'Alex Johnson', 'Emily Davis', 'Michael Brown', 'Sarah Wilson'];
    const randomName = userNames[Math.floor(Math.random() * userNames.length)];
    document.getElementById('userName').textContent = randomName;
  }

  // Apply to opening function - stores clubName and teamName in session and redirects
  function applyToOpening(clubName, teamName) {
    console.log('Applying to Club:', clubName, 'Team:', teamName);
    
    // Add to applied roles immediately for UI feedback
    const roleKey = `${clubName}-${teamName}`;
    appliedRoles.add(roleKey);
    
    // Update button to show applied state immediately
    const button = event.target.closest('button');
    if (button) {
      button.disabled = true;
      button.classList.add('applied');
      button.innerHTML = `
        <span>Processing...</span>
        <div class="loading-spinner"></div>
      `;
    }
    
    // Store application data in session
    fetch('/store-application-data', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      credentials: 'include',
      body: JSON.stringify({
        applied: {
          clubName: clubName,
          TeamName: teamName
        }
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Redirect to store-application-data1
        window.location.href = '/store-application-data1';
      } else {
        console.error('Failed to store session:', data.message);
        // Still redirect as fallback
        window.location.href = '/store-application-data1';
      }
    })
    .catch(error => {
      console.error('Error storing session:', error);
      // Fallback redirect
      window.location.href = '/store-application-data1';
    });
  }

  // Load user applications from database
  function loadUserApplications() {
    // Show loading skeleton
    const container = document.getElementById('userApplications');
    container.innerHTML = `
      <div class="application-skeleton">
        <div class="animate-pulse">
          <div class="h-4 bg-gray-200 rounded w-3/4 mb-2"></div>
          <div class="h-3 bg-gray-200 rounded w-1/2 mb-4"></div>
          <div class="h-8 bg-gray-200 rounded w-1/3"></div>
        </div>
      </div>
      <div class="application-skeleton">
        <div class="animate-pulse">
          <div class="h-4 bg-gray-200 rounded w-2/3 mb-2"></div>
          <div class="h-3 bg-gray-200 rounded w-1/3 mb-4"></div>
          <div class="h-8 bg-gray-200 rounded w-1/4"></div>
        </div>
      </div>
    `;

    // Fetch real user applications
    fetch('/user-applications', {
      method: 'GET',
      credentials: 'include'
    })
    .then(response => response.json())
    .then(data => {
      if (data.success && data.applications) {
        userApplications = data.applications;
        
        // Update applied roles set for filtering
        appliedRoles.clear();
        userApplications.forEach(app => {
          const roleKey = `${app.clubName}-${app.teamName}`;
          appliedRoles.add(roleKey);
        });
        
        displayUserApplications();
        updateStats();
        filterAvailableOpportunities();
      } else {
        console.log('No applications found:', data.message);
        displayEmptyApplications();
        filterAvailableOpportunities();
      }
    })
    .catch(error => {
      console.error('Error loading applications:', error);
      displayEmptyApplications();
      filterAvailableOpportunities();
    });
  }

  // Load applied roles for filtering (lightweight version)
  function loadAppliedRoles() {
    fetch('/user-applied-roles', {
      method: 'GET',
      credentials: 'include'
    })
    .then(response => response.json())
    .then(data => {
      if (data.success && data.appliedRoles) {
        appliedRoles = new Set(data.appliedRoles);
        filterAvailableOpportunities();
      }
    })
    .catch(error => {
      console.error('Error loading applied roles:', error);
    });
  }

  // Display empty applications state
  function displayEmptyApplications() {
    const container = document.getElementById('userApplications');
    container.innerHTML = `
      <div class="col-span-full text-center py-12">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-500 mb-2">No Applications Yet</h3>
        <p class="text-gray-400">Start applying to positions below!</p>
      </div>
    `;
  }

  // Display user applications with enhanced status cards
  function displayUserApplications() {
    const container = document.getElementById('userApplications');
    
    if (!userApplications.length) {
      displayEmptyApplications();
      return;
    }

    container.innerHTML = userApplications.map(app => {
      const statusMap = {
        'pending': { class: 'status-pending', text: 'Under Review', cardClass: 'pending', icon: '⏳' },
        'approved': { class: 'status-hired', text: 'Approved', cardClass: 'hired', icon: '✅' },
        'accepted': { class: 'status-hired', text: 'Hired', cardClass: 'hired', icon: '🎉' },
        'active': { class: 'status-hired', text: 'Active', cardClass: 'hired', icon: '🎉' },
        'rejected': { class: 'status-rejected', text: 'Not Selected', cardClass: 'rejected', icon: '❌' },
        'interview_scheduled': { class: 'status-under-review', text: 'Interview Scheduled', cardClass: 'under-review', icon: '📅' }
      };
      
      const status = statusMap[app.status] || statusMap['pending'];
      const appliedDate = new Date(app.appliedDate);
      
      return `
        <div class="status-card ${status.cardClass} transform hover:scale-105">
          <div class="flex items-start justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-indigo-100 to-purple-100 flex items-center justify-center text-2xl">
                ${status.icon}
              </div>
              <div>
                <h3 class="font-bold text-gray-800 text-lg">${app.role || 'Member'}</h3>
                <p class="text-sm text-gray-600 font-medium">${app.teamName || 'Team'}</p>
                <p class="text-xs text-gray-500">${app.clubName || 'Club'}</p>
              </div>
            </div>
            <span class="status-badge ${status.class} font-semibold">${status.text}</span>
          </div>
          
          <div class="text-xs text-gray-500 mb-4 flex items-center gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"/>
            </svg>
            Applied: ${appliedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </div>

          <!-- Application Details -->
          ${app.applicantName ? `
            <div class="text-xs text-gray-600 mb-3 p-2 bg-gray-50 rounded">
              <p><strong>Name:</strong> ${app.applicantName}</p>
              ${app.applicantEmail ? `<p><strong>Email:</strong> ${app.applicantEmail}</p>` : ''}
              ${app.phone ? `<p><strong>Phone:</strong> ${app.phone}</p>` : ''}
            </div>
          ` : ''}
          
          ${app.status === 'accepted' || app.status === 'approved' || app.status === 'active' ? `
            <div class="bg-gradient-to-r from-green-50 to-emerald-50 border border-green-200 rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/>
                </svg>
                <p class="text-green-700 font-bold">Congratulations!</p>
              </div>
              <p class="text-green-600 text-sm">You've been selected for this position. Welcome to the team!</p>
            </div>
          ` : app.status === 'rejected' ? `
            <div class="bg-gradient-to-r from-red-50 to-pink-50 border border-red-200 rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"/>
                </svg>
                <p class="text-red-700 font-medium">Not selected this time</p>
              </div>
              <p class="text-red-600 text-sm">Keep applying to other positions. Every application is a learning experience!</p>
            </div>
          ` : app.status === 'interview_scheduled' ? `
            <div class="bg-gradient-to-r from-purple-50 to-indigo-50 border border-purple-200 rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"/>
                </svg>
                <p class="text-purple-700 font-medium">Interview Scheduled</p>
              </div>
              <p class="text-purple-600 text-sm">Your interview has been scheduled. Check your email for details.</p>
            </div>
          ` : `
            <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <div class="w-5 h-5 border-2 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
                <p class="text-blue-700 font-medium">Review in progress</p>
              </div>
              <p class="text-blue-600 text-sm">Your application is being carefully reviewed. We'll notify you once a decision is made.</p>
            </div>
          `}
        </div>
      `;
    }).join('');
  }

  // Filter out applied opportunities from available opportunities
  function filterAvailableOpportunities() {
    const opportunityCards = document.querySelectorAll('.opportunity-card');
    let visibleCount = 0;
    
    opportunityCards.forEach(card => {
      const clubName = card.dataset.club;
      const teamName = card.dataset.team;
      const roleKey = `${clubName}-${teamName}`;
      
      if (appliedRoles.has(roleKey)) {
        // Hide applied opportunities and update button
        card.style.display = 'none';
        const button = card.querySelector('.btn-apply');
        if (button) {
          button.disabled = true;
          button.classList.add('applied');
          button.innerHTML = `
            <span>Already Applied</span>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
          `;
        }
      }
      else {
        card.style.display = 'block';
        visibleCount++;
      }
    });
    
    // Update available positions count
    const availableCount = document.getElementById('availablePositionsCount');
    if (availableCount) {
      availableCount.textContent = visibleCount;
    }
    
    // Show/hide no opportunities message
    const noOpportunitiesDiv = document.getElementById('noOpportunities');
    if (noOpportunitiesDiv) {
      if (visibleCount === 0) {
        noOpportunitiesDiv.classList.remove('hidden');
      }
      else {
        noOpportunitiesDiv.classList.add('hidden');
      }
    }
  }

  // Update statistics
  function updateStats() {
    const totalApps = userApplications.length;
    const hiredApps = userApplications.filter(app => 
      app.status === 'accepted' || app.status === 'approved' || app.status === 'active'
    ).length;
    const successRate = totalApps > 0 ? Math.round((hiredApps / totalApps) * 100) : 0;
    
    const userApplicationsCountEl = document.getElementById('userApplicationsCount');
    const userTotalApplicationsEl = document.getElementById('userTotalApplications');
    const successRateEl = document.getElementById('successRate');
    
    if (userApplicationsCountEl) userApplicationsCountEl.textContent = totalApps;
    if (userTotalApplicationsEl) userTotalApplicationsEl.textContent = totalApps;
    if (successRateEl) successRateEl.textContent = successRate + '%';
  }

  // Filter openings by team
  function filterOpenings(team) {
    const cards = document.querySelectorAll('.opportunity-card');
    const buttons = document.querySelectorAll('.filter-btn');
    
    // Update active button
    buttons.forEach(btn => {
      btn.classList.remove('active');
      if (btn.dataset.filter === team) {
        btn.classList.add('active');
      }
    });
    
    // Filter cards with smooth animation
    cards.forEach(card => {
      const clubName = card.dataset.club;
      const teamName = card.dataset.team;
      const roleKey = `${clubName}-${teamName}`;
      
      // Don't show applied roles
      if (appliedRoles.has(roleKey)) {
        card.style.display = 'none';
        return;
      }
      
      if (team === 'all' || card.dataset.team === team) {
        card.style.display = 'block';
        card.style.opacity = '0';
        setTimeout(() => card.style.opacity = '1', 10);
      } else {
        card.style.opacity = '0';
        setTimeout(() => card.style.display = 'none', 300);
      }
    });
  }

  // Refresh applications with animation
  function refreshApplications() {
    const btn = document.querySelector('.btn-refresh');
    const svg = btn.querySelector('svg');
    
    // Animate refresh button
    svg.style.transform = 'rotate(360deg)';
    svg.style.transition = 'transform 0.5s ease';
    setTimeout(() => {
      svg.style.transform = 'rotate(0deg)';
    }, 500);
    
    // Reload applications from database
    loadUserApplications();
  }

  // Initialize page
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize user data (if function exists)
    if (typeof initializeUserData === 'function') {
      initializeUserData();
    }
    
    // Load user applications on page load
    loadUserApplications();
    
    // Add smooth scrolling for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ 
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });

    // Add intersection observer for animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
        }
      });
    }, observerOptions);

    // Observe opportunity cards for scroll animations
    document.querySelectorAll('.opportunity-card').forEach(card => {
      card.style.opacity = '0';
      card.style.transform = 'translateY(20px)';
      card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      observer.observe(card);
    });
  });

  // Add keyboard navigation support
  document.addEventListener('keydown', function(e) {
    // ESC key to close any modals or reset filters
    if (e.key === 'Escape') {
      filterOpenings('all');
    }
  });

  // Prevent form resubmission on page refresh
  if (window.history.replaceState) {
    window.history.replaceState(null, null, window.location.href);
  }
</script>

