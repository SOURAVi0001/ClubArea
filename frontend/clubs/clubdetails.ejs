<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= PageTitle %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      as="style"
      onload="this.rel='stylesheet'"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700;900&family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap"
    />

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography,aspect-ratio"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              'tech-blue': '#5B96FF',
              'tech-magenta': '#EE46D3',
              'bg-dark': '#14191f',
            },
            fontFamily: {
              jakarta: ['"Plus Jakarta Sans"', 'Noto Sans', 'sans-serif'],
            },
            boxShadow: {
              neon: '0 0 20px #675BF766',
            }
          },
        },
      };
    </script>

    <style>
      body {
        font-family: 'Plus Jakarta Sans', 'Noto Sans', sans-serif;
        background: #14191f;
      }

      .bg-club-image {
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        position: relative;
      }

      .overlay-gradient {
        background: linear-gradient(to top, rgba(10, 15, 20, 0.85), rgba(10, 15, 20, 0.5));
      }
    </style>
  </head>

  <body class="bg-bg-dark text-white">
    <div class="min-h-screen w-full flex items-center justify-center px-4 py-10">
      <div
        class="relative rounded-2xl overflow-hidden w-full max-w-5xl aspect-[3/2] bg-club-image"
        style='background-image: url("<%= club.image %>");'
      >
        <!-- Gradient Overlay for text readability -->
        <div class="absolute inset-0 overlay-gradient"></div>

        <!-- Text Content Positioned Over Image -->
        <div class="relative z-10 flex flex-col justify-end h-full p-6 md:p-10">
          <h1 class="text-3xl md:text-4xl font-semibold text-tech-blue drop-shadow-md mb-3">
            <%= club.name %>
          </h1>
          <p class="text-base md:text-lg text-gray-200 max-w-3xl leading-relaxed">
            <%= club.description %>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
