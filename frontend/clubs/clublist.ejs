<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= PageTitle %></title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;900&family=Inter:wght@400;600;900&display=swap"
    />

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography,aspect-ratio"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              'tech-blue': '#5B96FF',
              'tech-violet': '#675BF7',
              'tech-magenta': '#EE46D3',
              'glass-dark': '#181B25e6',
              'glow-border': '#80f9ff',
            },
            boxShadow: {
              'tech-drift': '0 10px 32px #675BF766, 0 0 8px #EE46D366',
            },
            fontFamily: {
              techno: ['Orbitron', 'Inter', 'sans-serif'],
            },
          }
        }
      };
    </script>
    <style>
      body {
        font-family: 'Inter', 'Orbitron', sans-serif;
        background: radial-gradient(circle at 60% 40%, #15172a 60%, #201645 100%);
        min-height: 100vh;
      }
      .card-futuristic {
        background: rgba(24,27,37,0.92);
        border: 2px solid #675BF755;
        border-radius: 1.25rem;
        box-shadow: 0 2px 20px #5B96FF70, 0 0 6px #EE46D390;
        transition: box-shadow 0.25s, border 0.25s, transform 0.17s;
        backdrop-filter: blur(16px) saturate(1.22);
      }
      .card-futuristic:hover, .card-futuristic:focus-visible {
        box-shadow: 0 14px 38px #5B96FF88, 0 0 18px #EE46D366;
        border-color: #EE46D3;
        transform: scale(1.048) translateY(-8px);
        z-index:2;
      }

      /* Animated tech border */
      .pulse-border-tech {
        position: relative;
        z-index:1;
      }
      .pulse-border-tech:before {
        content: "";
        position:absolute; inset:0;
        border-radius:inherit;
        z-index:-1;
        box-shadow: 0 0 34px 8px #5B96FF99, 0 0 16px 2px #EE46D377;
        opacity:0.32;
        pointer-events: none;
        animation:pulseGlowTech 1.7s infinite alternate;
      }
      @keyframes pulseGlowTech {
        0% { opacity:0.27;}
        100%{opacity:0.7;}
      }
    </style>
  </head>
  <body class="text-white overflow-x-hidden">
    <!-- Neon animated border top -->
    <div class="h-1 w-full bg-gradient-to-r from-tech-blue via-fuchsia-400 to-tech-violet animate-pulse"></div>

    <!-- Navbar (kept as your included partial) -->
    <%- include('../partials/navbar') %>

    <!-- Main content -->
    <section class="w-full min-h-screen flex items-center justify-center px-4 py-6 md:py-14 bg-transparent">
      <div class="w-full max-w-6xl">
        <!-- Header -->
        <div class="mb-12 text-center">
          <h1 class="text-4xl md:text-5xl font-techno font-extrabold uppercase tracking-tight text-tech-blue drop-shadow mb-2">CLUB NEXUS</h1>
          <p class="text-xl md:text-2xl text-gray-300 font-medium mb-4 tracking-wide">Connect. Create. Collab.<br><span class="text-tech-blue font-semibold">Tech-driven communities, visually discovered.</span></p>
        </div>
        <!-- Search Bar -->
        <div class="flex justify-center mb-14">
          <div class="pulse-border-tech flex items-center w-full max-w-lg bg-glass-dark border border-tech-blue rounded-xl shadow-tech-drift px-5 h-14 focus-within:ring-2 focus-within:ring-tech-magenta">
            <svg class="text-tech-blue mr-3 shrink-0" xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" viewBox="0 0 256 256">
              <path fill="currentColor"
                d="M229.7 218.3l-50.1-50a88 88 0 1 0-11.3 11.3l50 50.1a8 8 0 0 0 11.4-11.4ZM40 112a72 72 0 1 1 72 72a72.1 72.1 0 0 1-72-72Z" />
            </svg>
            <input
              placeholder="Search for clubs"
              class="w-full h-10 bg-transparent text-lg font-medium text-white placeholder:text-gray-400 focus:outline-none"
            />
          </div>
        </div>

        <!-- Featured Clubs -->
        <h2 class="text-[1.32rem] font-techno uppercase text-tech-blue tracking-wide mb-4 pl-2">Featured Clubs</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mb-16">
          <% Register.forEach(function(club) { %>
          <a href="/club/<%= club.id %>" class="card-futuristic pulse-border-tech p-4 flex flex-col gap-4 group transition-all shadow-lg">
            <div class="aspect-square rounded-xl bg-center bg-cover border-2 border-tech-magenta shadow-lg mb-3" style='background-image: url("<%= club.image %>");'></div>
            <div>
              <h3 class="text-lg md:text-xl font-techno font-semibold text-white group-hover:text-tech-blue transition truncate mb-1"><%= club.name %></h3>
              <p class="text-sm md:text-base text-gray-300 group-hover:text-tech-magenta/90">
                <%= club.description.split(" ").slice(0, 13).join(" ") %><%= club.description.split(" ").length > 25 ? "..." : "" %>
              </p>
            </div>
          </a>
          <% }); %>
        </div>

        <!-- All Clubs Example Grid (static cards, replace/add your own dynamic rendering as needed) -->
        <h2 class="text-[1.32rem] font-techno uppercase text-tech-magenta tracking-wide mb-4 pl-2">All Clubs</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mb-12">
          <div class="card-futuristic pulse-border-tech p-4 flex flex-col gap-4">
            <div class="aspect-square rounded-xl bg-center bg-cover" style='background-image: url("https://source.unsplash.com/random/300x300?photography");'></div>
            <h3 class="text-lg font-techno font-semibold text-white mb-1">Photography Enthusiasts</h3>
            <p class="text-sm text-gray-300">Capture stunning moments and share your photographic journey.</p>
          </div>
          <div class="card-futuristic pulse-border-tech p-4 flex flex-col gap-4">
            <div class="aspect-square rounded-xl bg-center bg-cover" style='background-image: url("https://source.unsplash.com/random/300x300?music");'></div>
            <h3 class="text-lg font-techno font-semibold text-white mb-1">Music Lovers Society</h3>
            <p class="text-sm text-gray-300">Connect with fellow music enthusiasts and explore diverse genres.</p>
          </div>
          <div class="card-futuristic pulse-border-tech p-4 flex flex-col gap-4">
            <div class="aspect-square rounded-xl bg-center bg-cover" style='background-image: url("https://source.unsplash.com/random/300x300?gaming");'></div>
            <h3 class="text-lg font-techno font-semibold text-white mb-1">Gaming Guild</h3>
            <p class="text-sm text-gray-300">Join forces with gamers and conquer virtual worlds together.</p>
          </div>
          <div class="card-futuristic pulse-border-tech p-4 flex flex-col gap-4">
            <div class="aspect-square rounded-xl bg-center bg-cover" style='background-image: url("https://source.unsplash.com/random/300x300?travel");'></div>
            <h3 class="text-lg font-techno font-semibold text-white mb-1">Travel Buddies</h3>
            <p class="text-sm text-gray-300">Plan and embark on exciting travel adventures with like-minded individuals.</p>
          </div>
          <div class="card-futuristic pulse-border-tech p-4 flex flex-col gap-4">
            <div class="aspect-square rounded-xl bg-center bg-cover" style='background-image: url("https://source.unsplash.com/random/300x300?film");'></div>
            <h3 class="text-lg font-techno font-semibold text-white mb-1">Film Buffs Club</h3>
            <p class="text-sm text-gray-300">Discuss and analyze films, from classics to contemporary masterpieces.</p>
          </div>
          <div class="card-futuristic pulse-border-tech p-4 flex flex-col gap-4">
            <div class="aspect-square rounded-xl bg-center bg-cover" style='background-image: url("https://source.unsplash.com/random/300x300?environment");'></div>
            <h3 class="text-lg font-techno font-semibold text-white mb-1">Environmental Advocates</h3>
            <p class="text-sm text-gray-300">Make a positive impact on the environment through collective action.</p>
          </div>
        </div>
      </div>
    </section>
  </body>
</html>
