<!DOCTYPE html>
<html lang="en">
<head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Document</title>
      <script src="https://cdn.tailwindcss.com"></script>
      <link rel="icon" type="image/x-icon" href="/favicon.ico">
</head>
<body class="flex justify-center bg-cover bg-center" style="background-image: url('/Login/image.png');">
     <div class="absolute inset-0 bg-black opacity-80 z-0"></div>

           <form action="/VALIDATE" method="POST"
      class="flex justify-center my-[200px] border border-b-black-400 rounded-md px-3 py-2 z-10 w-[420px]"
      style="background-image: url('/Login/image.png');">

  <!-- Form inputs -->
  <div class="flex justify-center rounded-md w-[450px] p-6 shadow-lg">
    <div>
      <h1 class="mx-[100px] text-3xl mb-6 text-white"><%= PageTitle%></h1>

      <% if (errors && errors.length > 0) { %>
        <div class="mb-4 p-2 bg-red-200 text-red-800 rounded">
          <ul>
        <% errors.forEach(function(error) { %>
          <li><%= error.msg %></li>
        <% }); %>
          </ul>
        </div>
      <% } %>

      <input title="Name" type="text" name="name" placeholder="Name" value="<%= oldInput && oldInput.name ? oldInput.name : '' %>" class="border border-gray-400 rounded-md px-3 py-2 
      focus:outline-none focus:ring-2 focus:ring-grey-200" required />
      <br><br>

      <input title="Email" type="text" name="email" placeholder="Email" value="<%= oldInput && oldInput.email ? oldInput.email : '' %>" class="border border-gray-400 rounded-md px-3 py-2 
      focus:outline-none focus:ring-2 focus:ring-grey-200" required />
      <br><br>

      <input title="Password" type="password" name="password" placeholder="Password" class="border border-gray-400 rounded-md 
      px-3 py-2 focus:outline-none focus:ring-2 focus:ring-grey-200" required />
      <br><br>

      <input title="Confirm Password" type="password" name="confirmpassword" placeholder="Confirm Password" class="border border-gray-400 rounded-md 
      px-3 py-2 focus:outline-none focus:ring-2 focus:ring-grey-200" required />
      <br><br>

      <button id="Sign_Up" type="submit" class="flex justify-center mt-[10px] mx-10 border p-2 bg-slate-200 mx-12 rounded-2xl hover:bg-blue-400">
        Sign Up
      </button>
    </div>
  </div>
</form>


  
     </div>
</body>
</html>