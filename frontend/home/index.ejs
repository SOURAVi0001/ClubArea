<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<!-- ======================  Hero Section  ===================== -->
<section class="relative flex min-h-screen items-center justify-center overflow-hidden pt-24">
  <!-- Background video -->
  <video
    src="/home/INTRODUCTION.MP4"
    class="hero-vid absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    controls
    playsinline
  ></video>

  <!-- Dark gradient overlay -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"></div>

  <!-- Content overlay -->
  <div class="relative z-20 mx-auto w-full max-w-7xl px-6 py-20">
    <div class="grid gap-12 lg:grid-cols-2">
      <div class="space-y-8 text-white">
        <!-- "Experience ClubArea" block -->
        <div class="space-y-3">
          <h2 class="text-3xl font-bold sm:text-4xl lg:text-5xl">
            Experience <span class="text-sky-300">ClubArea</span>
          </h2>
          <p class="max-w-md text-gray-200 sm:text-lg">
            Watch how our platform transforms college club management and engagement.
          </p>
        </div>

        <!-- Typing headline + description -->
        <div class="space-y-6">
          <!-- Fixed container for typing text -->
          <div class="w-full overflow-visible">
            <h1
              id="hero-type"
              class="border-r-2 border-white/80 pr-4 text-2xl font-extrabold 
                     tracking-tight sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl
                     min-w-max"
              style="font-family:'Pacifico','Brush Script Std',cursive;"
            ></h1>
          </div>

          <div class="max-w-2xl space-y-4">
            <p class="text-gray-100 sm:text-lg">
              Welcome to <span class="font-semibold text-sky-200">ClubArea</span> – your centralized
              platform for everything related to college clubs! From event announcements and recruitment
              drives to AI-powered mock interviews, we keep you in the loop.
            </p>
            <p class="text-lg font-medium text-fuchsia-200">
              Discover. Connect. Grow. All in one place.
            </p>
          </div>
        </div>

        <!-- Action buttons -->
        <div class="flex flex-col gap-4 pt-2 sm:flex-row">
  <a href="/clublist"
     class="px-6 py-2 rounded-lg font-semibold text-white bg-red-600 hover:bg-red-700 transition duration-200">
     Explore Clubs
  </a>
  <a href="/recruitment"
     class="px-6 py-2 rounded-lg font-semibold text-red-600 border border-red-600 hover:bg-red-100 transition duration-200">
     Join Recruitment
  </a>
</div>
      </div>

      <!-- ===== Right: Stats card (shifted to rightmost) ===== -->
    

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="h-7 w-7 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>

<!-- ======================  Logos Row  ======================= -->
<section class="bg-slate-900 py-16">
  <div class="container mx-auto px-6">
    <div class="mb-12 text-center">
      <h3 class="mb-4 text-2xl font-bold">Trusted by Leading Clubs</h3>
      <p class="text-gray-400">Join the growing community of student organizations</p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-8 opacity-60 transition-opacity hover:opacity-100">
      <img src="/home/clublogo.png" alt="ClubArea Logo" class="h-16 object-contain filter grayscale transition-all hover:grayscale-0" />
      <!-- Add more partner logos here -->
    </div>
  </div>
</section>

<!-- ===============  Page-specific styles & scripts  =============== -->
<style>
  /* Glass-morphism helper */
  .glass-card{
    background:rgba(255,255,255,.1);
    backdrop-filter:blur(12px);
    border:1px solid rgba(255,255,255,.18);
  }

  /* Enhanced typing animation with better visibility */
  #hero-type{
    white-space: nowrap;
    overflow: visible !important;
    display: inline-block;
    position: relative;
  }
  
  #hero-type::before{
    content:"ALL CLUBS, ONE-STOP SOLUTION!";
    display:inline-block;
    white-space:nowrap;
    overflow:hidden;
    animation:typing 7s steps(29,end) infinite,blink 1s step-end infinite;
    max-width: none;
  }
  
  @keyframes typing{
    0%{width:0}
    40%{width:100%}
    60%{width:100%}
    100%{width:0}
  }
  
  @keyframes blink{
    0%,100%{border-color:transparent}
    50%{border-color:currentColor}
  }

  /* Responsive typing text for smaller screens */
  @media (max-width: 768px) {
    #hero-type::before {
      content: "ALL CLUBS, ONE SOLUTION!";
      animation: typing-mobile 6s steps(24,end) infinite, blink 1s step-end infinite;
    }
    
    @keyframes typing-mobile {
      0%{width:0}
      40%{width:100%}
      60%{width:100%}
      100%{width:0}
    }
  }

  @media (max-width: 480px) {
    #hero-type::before {
      content: "ALL CLUBS, ONE STOP!";
      animation: typing-small 5s steps(20,end) infinite, blink 1s step-end infinite;
    }
    
    @keyframes typing-small {
      0%{width:0}
      40%{width:100%}
      60%{width:100%}
      100%{width:0}
    }
  }

  /* Button utilities */
  .btn-primary{@apply inline-block rounded-full bg-gradient-to-r from-purple-600 to-fuchsia-600 px-8 py-3 font-semibold text-white transition duration-300 hover:scale-105 hover:shadow-xl hover:shadow-purple-500/30;}
  .btn-secondary{@apply inline-block rounded-full bg-white/10 px-8 py-3 font-semibold text-white backdrop-blur-sm transition duration-300 hover:bg-white/20 hover:scale-105;}

  /* Video tweaks */
  .hero-vid{filter:brightness(.75) saturate(1.15);}
  video::-webkit-media-controls-panel{background:rgba(0,0,0,.7);}
</style>

<script>
  /* Mobile-menu toggle from your existing navbar script */
  const burger=document.getElementById('nav-toggle');
  const mobileMenu=document.getElementById('mobile-menu');
  if(burger&&mobileMenu){
    let open=false;
    burger.addEventListener('click',()=>{
      open=!open;
      mobileMenu.style.maxHeight=open?mobileMenu.scrollHeight+'px':'0';
      burger.children[0].style.transform=open?'rotate(45deg) translateY(6px)':'';
      burger.children[1].style.opacity=open?'0':'1';
      burger.children[2].style.transform=open?'rotate(-45deg) translateY(-6px)':'';
    });
  }
</script>
