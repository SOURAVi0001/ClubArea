    </div>

    <!-- Quick Links -->
    <div>
      <h4 class="text-lg font-semibold text-fuchsia-400 mb-4">Quick Links</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/clublist"    class="hover:text-fuchsia-300 transition">Explore Clubs</a></li>
        <li><a href="/recruitment" class="hover:text-fuchsia-300 transition">Recruitment</a></li>
        <li><a href="/updates"     class="hover:text-fuchsia-300 transition">Club Updates</a></li>
        <li><a href="/ContactUs"     class="hover:text-fuchsia-300 transition">Support</a></li>
