        <a href="tel:+15551234567" class="hover:text-fuchsia-300">+1&nbsp;(555)&nbsp;123-4567</a>
      </p>

      <!-- Social icons -->
      <div class="flex gap-4">
        <a href="#" aria-label="Twitter"   class="text-gray-400 hover:text-fuchsia-400 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 256 256">
            <path d="M245.66 77.52a104.25 104.25 0 0 1-29.52 8.1 51.45 51.45 0 0 0 22.55-28.4 102.52 102.52 0 0 1-32.55 12.44A51.34 51.34 0 0 0 123.8 119a145.56 145.56 0 0 1-105.68-53.62 51.34 51.34 0 0 0 15.88 68.46 50.83 50.83 0 0 1-23.3-6.44v.65A51.36 51.36 0 0 0 51 179.08a51.3 51.3 0 0 1-23.26.88 51.37 51.37 0 0 0 47.9 35.6A102.9 102.9 0 0 1 11 230.3a145.23 145.23 0 0 0 78.62 23"/>
          </svg>
        </a>
        <a href="#" aria-label="Instagram" class="text-gray-400 hover:text-fuchsia-400 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 256 256">
            <path d="M186 24H70A46 46 0 0 0 24 70v116a46 46 0 0 0 46 46h116a46 46 0 0 0 46-46V70a46 46 0 0 0-46-46Zm30 162a30 30 0 0 1-30 30H70a30 30 0 0 1-30-30V70a30 30 0 0 1 30-30h116a30 30 0 0 1 30 30Zm-58-86a50 50 0 1 0 50 50a50 50 0 0 0-50-50Zm0 84a34 34 0 1 1 34-34a34 34 0 0 1-34 34Zm42-92a14 14 0 1 1 14-14a14 14 0 0 1-14 14Z"/>
          </svg>
        </a>
        <a href="#" aria-label="LinkedIn"  class="text-gray-400 hover:text-fuchsia-400 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 256 256">
            <path d="M216 24H40A16 16 0 0 0 24 40v176a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V40a16 16 0 0 0-16-16Zm-104 160H88V112h24Zm-12-92a12 12 0 1 1 12-12a12 12 0 0 1-12 12Zm120 92h-24v-44c0-11.66-1.78-20-13.54-20c-7.4 0-12.44 5-14.44 10c-.71 1.78-1 4.25-1 6.72v47.28h-24V112h23v12h.31a25.31 25.31 0 0 1 22.69-12.48c16.58 0 29 10.84 29 34Z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-fuchsia-700/20 py-6 text-center text-xs text-gray-500">
    &copy; <%= new Date().getFullYear() %> ClubArea. All rights reserved.
  </div>
</footer>

<!-- ===============  Page-specific styles & scripts  =============== -->
<style>
  /* Glass-morphism helper */
  .glass-card{background:rgba(255,255,255,.1);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.18);}
  /* Typing animation */
  #hero-type{white-space:nowrap;overflow:visible;display:inline-block;position:relative;}
  #hero-type::before{
    content:"ALL CLUBS, ONE-STOP SOLUTION!";
    white-space:nowrap;overflow:hidden;display:inline-block;
    animation:typing 7s steps(29,end) infinite,blink 1s step-end infinite;
  }
  @keyframes typing{0%{width:0}40%{width:100%}60%{width:100%}100%{width:0}}
  @keyframes blink{0%,100%{border-color:transparent}50%{border-color:currentColor}}
  @media (max-width:768px){
     #hero-type::before{content:"ALL CLUBS, ONE SOLUTION!";
       animation:typing-m 6s steps(24,end) infinite,blink 1s step-end infinite;}
     @keyframes typing-m{0%{width:0}40%{width:100%}60%{width:100%}100%{width:0}}
  }
  @media (max-width:480px){
     #hero-type::before{content:"ALL CLUBS, ONE STOP!";
       animation:typing-s 5s steps(20,end) infinite,blink 1s step-end infinite;}
     @keyframes typing-s{0%{width:0}40%{width:100%}60%{width:100%}100%{width:0}}
  }
  /* Video tweaks */
  .hero-vid{filter:brightness(.75) saturate(1.15);}
  video::-webkit-media-controls-panel{background:rgba(0,0,0,.7);}
</style>

<script>
  /* Navbar mobile toggle (assumes nav-toggle & mobile-menu exist in navbar partial) */
  const burger=document.getElementById('nav-toggle');
  const mobileMenu=document.getElementById('mobile-menu');
  if(burger&&mobileMenu){
    let open=false;
    burger.addEventListener('click',()=>{
      open=!open;
      mobileMenu.style.maxHeight=open?mobileMenu.scrollHeight+'px':'0';
      burger.children[0].style.transform=open?'rotate(45deg) translateY(6px)':'';
      burger.children[1].style.opacity=open?'0':'1';
      burger.children[2].style.transform=open?'rotate(-45deg) translateY(-6px)':'';
    });
  }
</script>
