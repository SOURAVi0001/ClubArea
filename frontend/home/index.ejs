<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<!-- ======================  Hero Section  ===================== -->
<section class="relative flex min-h-screen items-center justify-center overflow-hidden pt-24">
  <!-- Background video -->
  <video
    src="/home/INTRODUCTION.MP4"
    class="hero-vid absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
  ></video>

  <!-- Dark gradient overlay -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"></div>

  <!-- Content overlay -->
  <div class="relative z-20 mx-auto w-full max-w-7xl px-6 py-20">
    <div class="grid gap-12 lg:grid-cols-2">
      <!-- ===== Left: Text ===== -->
      <div class="space-y-8 text-white">
        <div class="space-y-3">
          <h2 class="text-3xl font-bold sm:text-4xl lg:text-5xl">
            Experience <span class="text-sky-300">ClubArea</span>
          </h2>
          <p class="max-w-md text-gray-200 sm:text-lg">
            Watch how our platform transforms college club management and engagement.
          </p>
        </div>

        <!-- Typing headline -->
        <div class="space-y-6">
          <div class="w-full overflow-visible">
            <h1
              id="hero-type"
              class="border-r-2 border-white/80 pr-4 text-2xl font-extrabold tracking-tight
                     sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl min-w-max"
              style="font-family:'Pacifico','Brush Script Std',cursive;"
            ></h1>
          </div>

          <div class="max-w-2xl space-y-4">
            <p class="text-gray-100 sm:text-lg">
              Welcome to <span class="font-semibold text-sky-200">ClubArea</span> – your centralized
              platform for everything related to college clubs! From event announcements and recruitment
              drives to AI-powered mock interviews, we keep you in the loop.
            </p>
            <p class="text-lg font-medium text-fuchsia-200">
              Discover. Connect. Grow. All in one place.
            </p>
          </div>
        </div>

        <!-- Action buttons -->
        <div class="flex flex-col gap-4 pt-2 sm:flex-row">
          <a href="/clublist"
             class="px-6 py-2 rounded-lg font-semibold text-white bg-red-600 hover:bg-red-700 transition">
             Explore Clubs
          </a>
          <a href="/recruitment"
             class="px-6 py-2 rounded-lg font-semibold text-red-600 border border-red-600 hover:bg-red-100 transition">
             Join Recruitment
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="h-7 w-7 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>

