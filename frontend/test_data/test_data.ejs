                                <div class="absolute inset-0 bg-gradient-to-r from-fuchsia-600/50 to-purple-600/50 rounded-lg blur opacity-0 hover:opacity-100 transition-opacity duration-200"></div>
                            </button>
                        </a>
                    </div>
                </nav>

                <!-- Mobile Menu Button -->
                <div class="lg:hidden">
                    <button id="mobile-menu-toggle" class="relative p-2 text-slate-400 hover:text-white hover:bg-slate-800/50 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-slate-600">
                        <span class="sr-only">Open main menu</span>
                        <div class="menu-icon">
                            <span class="menu-line top-0 left-0"></span>
                            <span class="menu-line top-2 left-0"></span>
                            <span class="menu-line top-4 left-0"></span>
                        </div>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Overlay and Panel -->
        <div id="mobile-overlay" class="lg:hidden fixed inset-0 bg-slate-900 z-40 opacity-0 invisible transition-all duration-300"></div>
        <div id="mobile-menu" class="lg:hidden fixed inset-y-0 right-0 w-full max-w-sm bg-slate-900 border-l border-slate-700 transform translate-x-full transition-transform duration-300 ease-in-out z-50 shadow-2xl">
            
            <!-- Mobile Menu Header -->
            <div class="flex items-center justify-between p-6 border-b border-slate-700 bg-slate-800">
                <div class="flex items-center space-x-3">
                    <img src="/partials/logo.png" alt="ClubArea" class="h-7 w-auto" />
                    <span class="text-white font-semibold"></span>
                </div>
                <button id="close-mobile-menu" class="p-2 text-slate-400 hover:text-white hover:bg-slate-700 rounded-lg transition-colors duration-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <!-- Mobile Menu Navigation -->
            <nav class="flex-1 px-6 py-6 space-y-1 bg-slate-900">
                <a href="/" class="mobile-nav-item group flex items-center px-4 py-3 text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-all duration-200">
                    <span class="w-6 h-6 mr-3 text-fuchsia-400"></span>
                    Home
                    <svg class="ml-auto w-4 h-4 text-slate-500 group-hover:text-slate-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
                
                <a href="/clublist" class="mobile-nav-item group flex items-center px-4 py-3 text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-all duration-200">
                    <span class="w-6 h-6 mr-3 text-fuchsia-400"></span>
                    Clubs
                    <svg class="ml-auto w-4 h-4 text-slate-500 group-hover:text-slate-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
                
                <a href="/recruitment" class="mobile-nav-item group flex items-center px-4 py-3 text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-all duration-200">
                    <span class="w-6 h-6 mr-3 text-fuchsia-400"></span>
                    Recruitment
                    <svg class="ml-auto w-4 h-4 text-slate-500 group-hover:text-slate-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
                
                <a href="/updates" class="mobile-nav-item group flex items-center px-4 py-3 text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-all duration-200">
                    <span class="w-6 h-6 mr-3 text-fuchsia-400"></span>
                    Updates
                    <svg class="ml-auto w-4 h-4 text-slate-500 group-hover:text-slate-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
                
                <a href="/gallery" class="mobile-nav-item group flex items-center px-4 py-3 text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-all duration-200">
                    <span class="w-6 h-6 mr-3 text-fuchsia-400"></span>
                    Gallery
                    <svg class="ml-auto w-4 h-4 text-slate-500 group-hover:text-slate-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
                
                <a href="/ContactUs" class="mobile-nav-item group flex items-center px-4 py-3 text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-all duration-200">
                    <span class="w-6 h-6 mr-3 text-fuchsia-400"></span>
                    Contact
                    <svg class="ml-auto w-4 h-4 text-slate-500 group-hover:text-slate-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
                  <a href="/testing_data" class="mobile-nav-item group flex items-center px-4 py-3 text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-all duration-200">
        <span class="w-6 h-6 mr-3 text-fuchsia-400"></span>
        Testing data
        <svg class="ml-auto w-4 h-4 text-slate-500 group-hover:text-slate-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
            </nav>

            <!-- Mobile Login Button -->
            <div class="p-6 border-t border-slate-700 bg-slate-800">
                <a href="/login_type" class="block">
                    <button class="w-full px-6 py-3 bg-gradient-to-r from-fuchsia-600 to-purple-600 text-white font-semibold rounded-lg shadow-lg hover:from-fuchsia-500 hover:to-purple-500 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-fuchsia-500/50">
                        Login to ClubEaria
                    </button>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>Club Management Testing Interface</h1>
            <p>Professional Data Display for Development & Testing</p>
        </div>

        <!-- Statistics -->
        <div class="stats-container">
            <div class="stat-card">
                <span class="stat-number" id="totalUsers">0</span>
                <div class="stat-label">Total Users</div>
            </div>
            <div class="stat-card">
                <span class="stat-number" id="totalAdmins">0</span>
                <div class="stat-label">Total Admins</div>
            </div>
            <div class="stat-card">
                <span class="stat-number" id="totalLeaders">0</span>
                <div class="stat-label">Leaders</div>
            </div>
            <div class="stat-card">
                <span class="stat-number" id="totalMembers">0</span>
                <div class="stat-label">Members</div>
            </div>
            <div class="stat-card">
                <span class="stat-number" id="totalClubs">0</span>
                <div class="stat-label">Clubs</div>
            </div>
        </div>

        <!-- Regular Users Section -->
        <div class="section">
            <div class="section-header">
                <h2 class="section-title">Regular Users (userdb)</h2>
                <button class="toggle-btn" onclick="toggleSection('users')">Toggle View</button>
            </div>
            <div class="section-content" id="users">
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Search users by name or email..." onkeyup="searchUsers(this.value)">
                </div>
                <div class="data-grid" id="userGrid">
                    <% if (typeof users !== 'undefined' && users.length > 0) { %>
                        <% users.forEach((user, index) => { %>
                            <div class="data-card user-card" data-search="<%= user.name.toLowerCase() %> <%= user.email.toLowerCase() %>">
                                <div class="card-header">
                                    <div class="card-title"><%= user.name %></div>
                                    <span class="role-badge user-badge">User</span>
                                </div>
                                <div class="card-details">
                                    <div class="detail-item">
                                        <span class="detail-label">Name</span>
                                        <span class="detail-value"><%= user.name %></span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">Email</span>
                                        <span class="detail-value"><%= user.email %></span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">Password</span>
                                        <span class="detail-value password-value"><%= user.password %></span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">User ID</span>
                                        <span class="detail-value"><%= user._id ? (user._id.$oid || user._id) : 'N/A' %></span>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="data-card">
                            <p style="text-align: center; color: #666;">No users found. Make sure to pass 'users' data to this template.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Admin Users Section -->
        <div class="section">
            <div class="section-header">
                <h2 class="section-title">Admin Users by Clubs (admindb)</h2>
                <button class="toggle-btn" onclick="toggleSection('admins')">Toggle View</button>
            </div>
            <div class="section-content" id="admins">
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Search admins by name, email, club, or team..." onkeyup="searchAdmins(this.value)">
                </div>
                <div id="adminGrid">
                    <% if (typeof admins !== 'undefined' && admins.length > 0) { %>
                        <%
                            // Group admins by club
                            const clubGroups = {};
                            admins.forEach(admin => {
                                if (!clubGroups[admin.clubId]) {
                                    clubGroups[admin.clubId] = {
                                        clubName: admin.clubName,
                                        members: []
                                    };
                                }
                                clubGroups[admin.clubId].members.push(admin);
                            });
                        %>
                        
                        <% Object.keys(clubGroups).forEach(clubId => { %>
                            <div class="club-section">
                                <div class="club-header">
                                    <div class="club-title"><%= clubGroups[clubId].clubName %></div>
                                    <div class="club-id"><%= clubId %></div>
                                </div>
                                <div style="padding: 16px;">
                                    <%
                                        // Group by team within club
                                        const teamGroups = {};
                                        const leaders = [];
                                        
                                        clubGroups[clubId].members.forEach(member => {
                                            if (member.role === 'leader') {
                                                leaders.push(member);
                                            } else {
                                                const teamName = member.teamName || 'No Team';
                                                if (!teamGroups[teamName]) {
                                                    teamGroups[teamName] = [];
                                                }
                                                teamGroups[teamName].push(member);
                                            }
                                        });
                                    %>
                                    
                                    <!-- Leaders -->
                                    <% if (leaders.length > 0) { %>
                                        <div class="team-section">
                                            <div class="team-title">Leaders</div>
                                            <div class="team-members">
                                                <% leaders.forEach(leader => { %>
                                                    <div class="data-card leader-card" data-search="<%= leader.email.toLowerCase() %> <%= leader.clubName.toLowerCase() %> leader <%= (leader.name || '').toLowerCase() %>">
                                                        <div class="card-header">
                                                            <div class="card-title"><%= leader.name || leader.email.split('@')[0] %></div>
                                                            <span class="role-badge leader-badge">Leader</span>
                                                        </div>
                                                        <div class="card-details">
                                                            <% if (leader.name) { %>
                                                            <div class="detail-item">
                                                                <span class="detail-label">Name</span>
                                                                <span class="detail-value"><%= leader.name %></span>
                                                            </div>
                                                            <% } %>
                                                            <div class="detail-item">
                                                                <span class="detail-label">Email</span>
                                                                <span class="detail-value"><%= leader.email %></span>
                                                            </div>
                                                            <div class="detail-item">
                                                                <span class="detail-label">Password</span>
                                                                <span class="detail-value password-value"><%= leader.password %></span>
                                                            </div>
                                                            <div class="detail-item">
                                                                <span class="detail-label">Club</span>
                                                                <span class="detail-value"><%= leader.clubName %></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        </div>
                                    <% } %>
                                    
                                    <!-- Team Members -->
                                    <% Object.keys(teamGroups).forEach(teamName => { %>
                                        <div class="team-section">
                                            <div class="team-title"><%= teamName %></div>
                                            <div class="team-members">
                                                <% teamGroups[teamName].forEach(member => { %>
                                                    <div class="data-card admin-card" data-search="<%= member.email.toLowerCase() %> <%= member.clubName.toLowerCase() %> <%= teamName.toLowerCase() %> member <%= (member.name || '').toLowerCase() %>">
                                                        <div class="card-header">
                                                            <div class="card-title"><%= member.name || member.email.split('@')[0] %></div>
                                                            <span class="role-badge member-badge">Member</span>
                                                        </div>
                                                        <div class="card-details">
                                                            <% if (member.name) { %>
                                                            <div class="detail-item">
                                                                <span class="detail-label">Name</span>
                                                                <span class="detail-value"><%= member.name %></span>
                                                            </div>
                                                            <% } %>
                                                            <div class="detail-item">
                                                                <span class="detail-label">Email</span>
                                                                <span class="detail-value"><%= member.email %></span>
                                                            </div>
                                                            <div class="detail-item">
                                                                <span class="detail-label">Password</span>
                                                                <span class="detail-value password-value"><%= member.password %></span>
                                                            </div>
                                                            <div class="detail-item">
                                                                <span class="detail-label">Team</span>
                                                                <span class="detail-value"><%= member.teamName || 'No Team' %></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="data-card">
                            <p style="text-align: center; color: #666;">No admin users found. Make sure to pass 'admins' data to this template.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Navbar functionality
        class ModernNavbar {
            constructor() {
                this.mobileMenuToggle = document.getElementById('mobile-menu-toggle');
                this.mobileMenu = document.getElementById('mobile-menu');
                this.mobileOverlay = document.getElementById('mobile-overlay');
                this.closeMobileMenu = document.getElementById('close-mobile-menu');
                this.menuIcon = document.querySelector('.menu-icon');
                this.isMenuOpen = false;

                this.init();
            }

            init() {
                this.mobileMenuToggle?.addEventListener('click', () => this.toggleMenu());
                this.closeMobileMenu?.addEventListener('click', () => this.closeMenu());
                this.mobileOverlay?.addEventListener('click', () => this.closeMenu());
                
                document.querySelectorAll('.mobile-nav-item').forEach(link => {
                    link.addEventListener('click', () => {
                        setTimeout(() => this.closeMenu(), 100);
                    });
                });

                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && this.isMenuOpen) {
                        this.closeMenu();
                    }
                });

                window.addEventListener('resize', () => {
                    if (window.innerWidth >= 1024 && this.isMenuOpen) {
                        this.closeMenu();
                    }
                });

                this.setActiveNavigation();
                
                document.querySelectorAll('.nav-item, .mobile-nav-item').forEach(link => {
                    link.addEventListener('click', () => {
                        setTimeout(() => this.setActiveNavigation(), 50);
                    });
                });
            }

            toggleMenu() {
                if (this.isMenuOpen) {
                    this.closeMenu();
                } else {
                    this.openMenu();
                }
            }

            openMenu() {
                this.isMenuOpen = true;
                this.mobileMenu?.classList.add('open');
                this.mobileOverlay?.classList.add('open');
                this.menuIcon?.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            closeMenu() {
                this.isMenuOpen = false;
                this.mobileMenu?.classList.remove('open');
                this.mobileOverlay?.classList.remove('open');
                this.menuIcon?.classList.remove('active');
                document.body.style.overflow = '';
            }

            setActiveNavigation() {
                const currentPath = window.location.pathname;
                const navLinks = document.querySelectorAll('.nav-item, .mobile-nav-item');
                
                navLinks.forEach(link => {
                    link.classList.remove('active');
                });
                
                navLinks.forEach(link => {
                    const href = link.getAttribute('href');
                    
                    if (href === currentPath) {
                        link.classList.add('active');
                        return;
                    }
                    
                    if (currentPath === '/' && href === '/') {
                        link.classList.add('active');
                        return;
                    }
                    
                    const normalizedHref = href.replace(/\/$/, '') || '/';
                    const normalizedPath = currentPath.replace(/\/$/, '') || '/';
                    
                    if (normalizedHref === normalizedPath) {
                        link.classList.add('active');
                        return;
                    }
                });
            }
        }

        // Testing UI functionality
        function updateStats() {
            const users = document.querySelectorAll('.user-card').length;
            const admins = document.querySelectorAll('.admin-card, .leader-card').length;
            const leaders = document.querySelectorAll('.leader-card').length;
            const members = document.querySelectorAll('.admin-card').length;
            const clubs = document.querySelectorAll('.club-section').length;

            document.getElementById('totalUsers').textContent = users;
            document.getElementById('totalAdmins').textContent = admins;
            document.getElementById('totalLeaders').textContent = leaders;
            document.getElementById('totalMembers').textContent = members;
            document.getElementById('totalClubs').textContent = clubs;
        }

        function toggleSection(sectionId) {
            const section = document.getElementById(sectionId);
            section.classList.toggle('hidden');
        }

        function searchUsers(query) {
            const cards = document.querySelectorAll('#userGrid .user-card');
            const searchTerm = query.toLowerCase();
            
            cards.forEach(card => {
                const searchData = card.dataset.search;
                if (searchData.includes(searchTerm)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function searchAdmins(query) {
            const cards = document.querySelectorAll('#adminGrid .data-card');
            const searchTerm = query.toLowerCase();
            
            cards.forEach(card => {
                const searchData = card.dataset.search;
                if (searchData.includes(searchTerm)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Initialize everything
        document.addEventListener('DOMContentLoaded', function() {
            new ModernNavbar();
            updateStats();
        });

        window.addEventListener('load', () => {
            setTimeout(() => {
                const navbar = new ModernNavbar();
                navbar.setActiveNavigation();
                updateStats();
            }, 100);
        });
    </script>
</body>
</html>
