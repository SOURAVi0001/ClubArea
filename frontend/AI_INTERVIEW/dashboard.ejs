<html>
  <head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link
      rel="stylesheet"
      as="style"
      onload="this.rel='stylesheet'"
      href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900"
    />

    <title>Stitch Design</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  </head>
  <body>

       <%- include( '../partials/navbar' )%>
       
    <div class="relative flex size-full min-h-screen flex-col bg-[#1a1a1a] dark group/design-root overflow-x-hidden" style='font-family: Inter, "Noto Sans", sans-serif;'>
      <div class="layout-container flex h-full grow flex-col">
        <header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-b-[#363636] px-10 py-3">
          <div class="flex items-center gap-4 text-white">
            <div class="size-4">
              <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M24 18.4228L42 11.475V34.3663C42 34.7796 41.7457 35.1504 41.3601 35.2992L24 42V18.4228Z"
                  fill="currentColor"
                ></path>
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M24 8.18819L33.4123 11.574L24 15.2071L14.5877 11.574L24 8.18819ZM9 15.8487L21 20.4805V37.6263L9 32.9945V15.8487ZM27 37.6263V20.4805L39 15.8487V32.9945L27 37.6263ZM25.354 2.29885C24.4788 1.98402 23.5212 1.98402 22.646 2.29885L4.98454 8.65208C3.7939 9.08038 3 10.2097 3 11.475V34.3663C3 36.0196 4.01719 37.5026 5.55962 38.098L22.9197 44.7987C23.6149 45.0671 24.3851 45.0671 25.0803 44.7987L42.4404 38.098C43.9828 37.5026 45 36.0196 45 34.3663V11.475C45 10.2097 44.2061 9.08038 43.0155 8.65208L25.354 2.29885Z"
                  fill="currentColor"
                ></path>
              </svg>
            </div>
            <h2 class="text-white text-lg font-bold leading-tight tracking-[-0.015em]">InterviewAI</h2>
          </div>
          <div class="flex flex-1 justify-end gap-8">
            <!-- <div class="flex items-center gap-9">
              <a class="text-white text-sm font-medium leading-normal" href="#">Dashboard</a>
              <a class="text-white text-sm font-medium leading-normal" href="#">Candidates</a>
              <a class="text-white text-sm font-medium leading-normal" href="#">Interviews</a>
              <a class="text-white text-sm font-medium leading-normal" href="#">Templates</a>
              <a class="text-white text-sm font-medium leading-normal" href="#">Settings</a>
            </div> -->
            <button
              class="flex max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 bg-[#363636] text-white gap-2 text-sm font-bold leading-normal tracking-[0.015em] min-w-0 px-2.5"
            >
              <div class="text-white" data-icon="Bell" data-size="20px" data-weight="regular">
                <svg xmlns="http://www.w3.org/2000/svg" width="20px" height="20px" fill="currentColor" viewBox="0 0 256 256">
                  <path
                    d="M221.8,175.94C216.25,166.38,208,139.33,208,104a80,80,0,1,0-160,0c0,35.34-8.26,62.38-13.81,71.94A16,16,0,0,0,48,200H88.81a40,40,0,0,0,78.38,0H208a16,16,0,0,0,13.8-24.06ZM128,216a24,24,0,0,1-22.62-16h45.24A24,24,0,0,1,128,216ZM48,184c7.7-13.24,16-43.92,16-80a64,64,0,1,1,128,0c0,36.05,8.28,66.73,16,80Z"
                  ></path>
                </svg>
              </div>
            </button>
            <div
              class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10"
              style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuB4sE5RkGoLB3ksDJC03yOSi4TUKj4NUXGx36ImXCc-fppVQOIPA2jAAhKtCY7rGtHpM8s-BhQ2O6TPN_pq6hQBi0pnnq2RkooWUZeYc6ji258a4wptbnLP2N2gbhShHLayhSTKjfLPhihYXE60YB020xqjnbviyYPnif2lWmh-66D6mrGGAzLbyB_-i8hUpoRKeQPYuMh0aOC9Wclf-45OWd25qV5eKX-SWdHjFYNhravj0BPQcsn_qG873L4i6uxnm0neAPKp7ypx");'
            ></div>
          </div>
        </header>
        <div class="gap-1 px-6 flex flex-1 justify-center py-5">
          <div class="layout-content-container flex flex-col max-w-[920px] flex-1">
            <div class="flex flex-wrap justify-between gap-3 p-4">
              <p class="text-white tracking-light text-[32px] font-bold leading-tight min-w-72">Interview with Alex Bennett</p>
            </div>
            <h3 class="text-white text-lg font-bold leading-tight tracking-[-0.015em] px-4 pb-2 pt-4">Conversation</h3>
            <div class="flex items-end gap-3 p-4">
              <div
                class="bg-center bg-no-repeat aspect-square bg-cover rounded-full w-10 shrink-0"
                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAWBsBQqKEbCzF68NcOn1Li-PhfsH-hVfA4G_Bn9RqmOUkTCkJZlj2CYbhcTvLq5PdkuT0ARQRXYPsiUw31KZeODhFwVMtM3aTgzF1THbkR_Z0B6l_vJcOM5rXxYb_dGfLpaFSYCt9nQMTkMn2q4xi-AL2V5IIpHd7c94Q4fzN7LLI3XmjW-cGyHhhtd0Te1JYBAmbuGh9BLVHB7TJldKmYQNMrrPMOmY_Z95_RfZygYbu03IfT8JmWC3SEZuqCZmG9lODWALaEy2_k");'
              ></div>
              <div class="flex flex-1 flex-col gap-1 items-start">
                <p class="text-[#adadad] text-[13px] font-normal leading-normal max-w-[360px]">AI Interviewer</p>
                <p class="text-base font-normal leading-normal flex max-w-[360px] rounded-lg px-4 py-3 bg-[#363636] text-white">
                  Welcome, Alex! I'm excited to learn more about your experience and skills today. Let's start with a brief introduction. Can you tell me about your background and
                  what led you to apply for this role?
                </p>
              </div>
            </div>
            <div class="flex items-end gap-3 p-4 justify-end">
              <div class="flex flex-1 flex-col gap-1 items-end">
                <p class="text-[#adadad] text-[13px] font-normal leading-normal max-w-[360px] text-right">Alex Bennett</p>
                <p class="text-base font-normal leading-normal flex max-w-[360px] rounded-lg px-4 py-3 bg-black text-white">
                  Hi! I'm thrilled to be here. I have a background in software engineering with a focus on backend development. I've worked on several projects involving
                  large-scale data processing and API design. I'm particularly interested in this role because it aligns with my passion for building scalable and efficient
                  systems.
                </p>
              </div>
              <div
                class="bg-center bg-no-repeat aspect-square bg-cover rounded-full w-10 shrink-0"
                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAAUpYlADCRG-hfsGPd4hQb9cLlh4vg2_vw3hEDmTr5dIEUM0SGMi4I5HAhLulJzWs84JlZzdJlszpUyhuPiZmk8g0-xFyLvrHH59zuOYMU5RrRODd_pubAHJPZJiXw2qVth1NYhsPYn3g4PTFKvdxY4BrY3fvMy6zTp6tjRH8K8BhSJvsOgnyxsLNzAX8DRO8aIvd-5iJPMVnKJYnaqUUyBlkRFei4lsjxYiQ_WKhk_7fc8e2EeEGVi_IQbhWFvANWfI3MwNsUfnYj");'
              ></div>
            </div>
            <div class="flex items-end gap-3 p-4">
              <div
                class="bg-center bg-no-repeat aspect-square bg-cover rounded-full w-10 shrink-0"
                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDPyVVkRuDnz6BuHMk6qBEjYMi01uTtRgy105qS0gTAudssEWiYp_EG3OijFQow_870dESfU0ypMpzvtzDW-TzCR43Jao_LGk4T2h1yMBZWRWWz424ct_FLmJBfsqWp5zSCZjiqfeWDCis3xhjl9stvP4bJKVO4dxMNVUgboMYDdmJ_XHjweLgGLUR3BDdheCfG8UvDdIbzP1MqP4i3TnYWK1jMVTvQIsd__x2R8LgVo7J5TLFvkhvh4ffmxfY0FZMNeUOEKZZRhoDX");'
              ></div>
              <div class="flex flex-1 flex-col gap-1 items-start">
                <p class="text-[#adadad] text-[13px] font-normal leading-normal max-w-[360px]">AI Interviewer</p>
                <p class="text-base font-normal leading-normal flex max-w-[360px] rounded-lg px-4 py-3 bg-[#363636] text-white">
                  That's great to hear, Alex. Your experience in backend development seems quite relevant. Now, let's dive into some technical questions. Can you describe a
                  challenging project you worked on and how you overcame the technical hurdles?
                </p>
              </div>
            </div>
            <div class="flex items-center px-4 py-3 gap-3 @container">
              <div
                class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10 shrink-0"
                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuCf-5TliYo-T8_uDccf0f28KvCZEPkJclPH79ZRawwmJlQzeTqejonUzmF2O0Lo_XmaFhIE8NrOV-N7aYet6TUFUHdNllEtrEjCIUwSuGKXImymHRSML1POI0B6l7ObReGg5MD3ZsULEgto3Zb1Nzu43cF6Rb3MM-bG2N6Uh3yBDimpzO_Z_gefKMf8ivp4Z94sRITpFxws3_JsFEyA8myGWoTd39nrXHsd9DgXc7sEO4DIx9zQmmM8LKed3C-1O9sktH69v20nCAhD");'
              ></div>
              <label class="flex flex-col min-w-40 h-12 flex-1">
                <div class="flex w-full flex-1 items-stretch rounded-lg h-full">
                  <input
                    placeholder="Type your message here..."
                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-white focus:outline-0 focus:ring-0 border-none bg-[#363636] focus:border-none h-full placeholder:text-[#adadad] px-4 rounded-r-none border-r-0 pr-2 text-base font-normal leading-normal"
                    value=""
                  />
                  <div class="flex border-none bg-[#363636] items-center justify-center pr-4 rounded-r-lg border-l-0 !pr-2">
                    <div class="flex items-center gap-4 justify-end">
                      <div class="flex items-center gap-1">
                        <button class="flex items-center justify-center p-1.5">
                          <div class="text-[#adadad]" data-icon="Microphone" data-size="20px" data-weight="regular">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20px" height="20px" fill="currentColor" viewBox="0 0 256 256">
                              <path
                                d="M128,176a48.05,48.05,0,0,0,48-48V64a48,48,0,0,0-96,0v64A48.05,48.05,0,0,0,128,176ZM96,64a32,32,0,0,1,64,0v64a32,32,0,0,1-64,0Zm40,143.6V232a8,8,0,0,1-16,0V207.6A80.11,80.11,0,0,1,48,128a8,8,0,0,1,16,0,64,64,0,0,0,128,0,8,8,0,0,1,16,0A80.11,80.11,0,0,1,136,207.6Z"
                              ></path>
                            </svg>
                          </div>
                        </button>
                      </div>
                      <button
                        class="min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-8 px-4 bg-black text-white text-sm font-medium leading-normal hidden @[480px]:block"
                      >
                        <span class="truncate">Send</span>
                      </button>
                    </div>
                  </div>
                </div>
              </label>
            </div>
          </div>
          <div class="layout-content-container flex flex-col w-[360px]">
            <div class="flex p-4 @container">
              <div class="flex w-full flex-col gap-4 items-center">
                <div class="flex gap-4 flex-col items-center">
                  <div
                    class="bg-center bg-no-repeat aspect-square bg-cover rounded-full min-h-32 w-32"
                    style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuD1sLCQbVHrELwC6b6KWKO3wMl01itcV5wWVS1pUh02zPhoWZqLS97tYahpHsbuHXOESOcDxkAu3TRjiFBhX_ZMeyugii1Mt6IPCv3u9KbiVWCEzJSffu7iocADJAZfkExZpOi_6SiZrHr31wKJrGfX-w3kUHAznBe2tlLKbSxMrQIqu0V25-hxOw1IZNPBUyijfdrfc8vx6CMjQ3u4OCg41jyb8CP3s-J7YNyd0Dmxbf3uPqK3XMY4RDW1S--reRa7JRzlpw8m09KB");'
                  ></div>
                  <div class="flex flex-col items-center justify-center justify-center">
                    <p class="text-white text-[22px] font-bold leading-tight tracking-[-0.015em] text-center">Alex Bennett</p>
                    <p class="text-[#adadad] text-base font-normal leading-normal text-center">Software Engineer</p>
                  </div>
                </div>
              </div>
            </div>
            <h3 class="text-white text-lg font-bold leading-tight tracking-[-0.015em] px-4 pb-2 pt-4">Interview Details</h3>
            <div class="p-4 grid grid-cols-[20%_1fr] gap-x-6">
              <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#4d4d4d] py-5">
                <p class="text-[#adadad] text-sm font-normal leading-normal">Role</p>
                <p class="text-white text-sm font-normal leading-normal">Backend Engineer</p>
              </div>
              <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#4d4d4d] py-5">
                <p class="text-[#adadad] text-sm font-normal leading-normal">Date</p>
                <p class="text-white text-sm font-normal leading-normal">July 26, 2024</p>
              </div>
              <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#4d4d4d] py-5">
                <p class="text-[#adadad] text-sm font-normal leading-normal">Status</p>
                <p class="text-white text-sm font-normal leading-normal">In Progress</p>
              </div>
            </div>
            <h3 class="text-white text-lg font-bold leading-tight tracking-[-0.015em] px-4 pb-2 pt-4">Controls</h3>
            <div class="flex justify-center">
              <div class="flex flex-1 gap-3 max-w-[480px] flex-col items-stretch px-4 py-3">
                <button
                  class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-black text-white text-sm font-bold leading-normal tracking-[0.015em] w-full"
                >
                  <span class="truncate">Next Question</span>
                </button>
                <button
                  class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-[#363636] text-white text-sm font-bold leading-normal tracking-[0.015em] w-full"
                >
                  <span class="truncate">End Interview</span>
                </button>
                <button
                  class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-[#363636] text-white text-sm font-bold leading-normal tracking-[0.015em] w-full"
                >
                  <span class="truncate">Pause Interview</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
