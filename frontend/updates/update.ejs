<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Stitch Design</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900&display=swap"
    />

    <!-- TailwindCSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              'tech-bg': '#0d1117',
              'tech-card': '#1f2633',
              'tech-blue': '#5B96FF',
              'tech-magenta': '#EE46D3',
              'tech-dark': '#1a2235',
              'tab-inactive': '#72809a',
            },
            boxShadow: {
              neon: '0 0 18px #5B96FF88',
              glow: '0 0 12px #EE46D366',
            },
            borderRadius: {
              'xl2': '1.25rem',
            },
          },
        },
      };
    </script>

    <style>
      body {
        font-family: 'Inter', 'Noto Sans', sans-serif;
        background: radial-gradient(circle at 50% 10%, #0d1117 0%, #161c28 100%);
      }

      .glass-card {
        background: rgba(31, 38, 51, 0.55);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        transition: 0.25s all ease-in-out;
      }

      .glass-card:hover {
        border-color: #5B96FF;
        box-shadow: 0 8px 36px #5B96FF55 inset, 0 0 30px #EE46D366;
        transform: scale(1.01);
      }

      .tab-active {
        border-bottom: 2.5px solid #EE46D3;
        color: white;
      }

      .icon-bg {
        background: linear-gradient(135deg, #5B96FF, #EE46D3);
      }
    </style>
  </head>

  <body class="text-white">
    <!-- ✅ Partial is untouched -->
    <%- include('../partials/navbar') %>

    <div class="min-h-screen px-4 sm:px-8 md:px-20 pt-12 pb-24 mt-[20px]">
      <div class="max-w-5xl mx-auto flex flex-col gap-10">

        <!-- ⛳ Page Header -->
        <header class="text-center sm:text-left">
          <h1 class="text-4xl font-extrabold tracking-tight text-white">Club Updates</h1>
          <p class="text-sm text-gray-400 mt-1">Stay updated with your club's latest announcements and events.</p>
        </header>

        <!-- 🔍 Search Bar -->
        <div class="w-full max-w-xl mx-auto sm:mx-0">
          <div class="flex items-center bg-tech-dark border border-tech-blue/50 rounded-full px-4 h-12 shadow-neon hover:shadow-glow transition duration-300">
            <svg class="text-tech-blue mr-3" xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256">
              <path d="M229.66,218.34l-50.07-50.06A88.11,88.11 0 1 0 180 179l50.06 50.07a8 8 0 0 0 11.32-11.32ZM112 184a72 72 0 1 1 0-144 72 72 0 0 1 0 144Z"/>
            </svg>
            <input
              type="text"
              placeholder="Search updates..."
              class="flex-1 bg-transparent text-white text-sm placeholder:text-slate-400 focus:outline-none"
            />
          </div>
        </div>

        <!-- 🧩 Filter Tabs -->
        

        <!-- 📢 Updates Feed -->
        <div class="flex flex-col gap-6 pt-3">
          <% updates.forEach(update => { %>
          <div class="glass-card group flex items-start justify-between gap-5 px-6 py-5 rounded-xl2 shadow-md hover:shadow-neon transition duration-300">
            <!-- Icon -->
            <div class="icon-bg w-12 h-12 rounded-lg flex items-center justify-center flex-shrink-0 text-white shadow">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256">
                <path d="M240,120a48.05,48.05,0,0,0-48-48H152.2c-2.91-.17-53.62-3.74-101.91-44.24A16,16,0,0,0,24,40V200a16,16,0,0,0,26.29,12.25c37.77-31.68,77-40.76,93.71-43.3v31.72A16,16,0,0,0,151.12,214l11,7.33A16,16,0,0,0,186.5,212l11.77-44.36A48.07,48.07,0,0,0,240,120ZM40,199.93V40h0c42.81,35.91,86.63,45,104,47.24v65.48C126.65,155,82.84,164.07,40,199.93Zm131,8,0,.11-11-7.33V168h21.6ZM192,152H160V88h32a32 32 0 1 1 0 64Z"/>
              </svg>
            </div>

            <!-- Content -->
            <div class="flex-1">
              <p class="text-lg font-semibold mb-1 text-white"><%= update.title %></p>
              <p class="text-tech-magenta text-sm font-medium mb-1">
                Posted by: <%= update.clubName %> (<%= update.posted_by %>)
              </p>
              <p class="text-gray-300 text-sm"><%= update.description %></p>
            </div>

            <!-- Time -->
            <div class="min-w-max">
              <p class="text-xs text-gray-500">3d ago</p>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </div>
  </body>
</html>
