             
     <html>
  <head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link
      rel="stylesheet"
      as="style"
      onload="this.rel='stylesheet'"
      href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900"
    />

    <title>Stitch Design</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  </head>
      <body class="bg-slate-600 text-white">
       <%- include( '../partials/navbar' )%>
    <div class="relative flex size-full min-h-screen flex-col bg-slate-600 group/design-root overflow-x-hidden" style='font-family: Inter, "Noto Sans", sans-serif;'>
      <div class="layout-container flex h-full grow flex-col">
        <div class="px-40 flex flex-1 justify-center py-5">
          <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
            <div class="flex flex-wrap justify-between gap-3 p-4">
              <div class="flex min-w-72 flex-col gap-3">
                <p class="text-white tracking-light text-[32px] font-bold leading-tight">Updates</p>
                <p class="text-[#ffffc0] text-sm font-normal leading-normal">Stay informed with the latest news and activities from your clubs.</p>
              </div>
            </div>
            <div class="px-4 py-3">
              <label class="flex flex-col min-w-40 h-12 w-full">
                <div class="flex w-full flex-1 items-stretch rounded-xl h-full">
                  <div
                    class="text-[#6a7681] flex border-none bg-[#f1f2f4] items-center justify-center pl-4 rounded-l-xl border-r-0"
                    data-icon="MagnifyingGlass"
                    data-size="24px"
                    data-weight="regular"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" fill="currentColor" viewBox="0 0 256 256">
                      <path
                        d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z"
                      ></path>
                    </svg>
                  </div>
                  <input
                    placeholder="Search updates"
                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#121416] focus:outline-0 focus:ring-0 border-none bg-[#f1f2f4] focus:border-none h-full placeholder:text-[#6a7681] px-4 rounded-l-none border-l-0 pl-2 text-base font-normal leading-normal"
                    value=""
                  />
                </div>
              </label>
            </div>
            <div class="pb-3">
              <div class="flex border-b border-[#dde1e3] px-4 gap-8">
                <a class="flex flex-col items-center justify-center border-b-[3px] border-b-[#121416] text-[#121416] pb-[13px] pt-4" href="#">
                  <p class="text-[#fffff1] text-sm font-bold leading-normal tracking-[0.015em]">All</p>
                </a>
                <a class="flex flex-col items-center justify-center border-b-[3px] border-b-transparent text-[#6a7681] pb-[13px] pt-4" href="#">
                  <p class="text-[#fffff1] text-sm font-bold leading-normal tracking-[0.015em]">Announcements</p>
                </a>
                <a class="flex flex-col items-center justify-center border-b-[3px] border-b-transparent text-[#6a7681] pb-[13px] pt-4" href="#">
                  <p class="text-[#fffff1] text-sm font-bold leading-normal tracking-[0.015em]">Events</p>
                </a>
                <a class="flex flex-col items-center justify-center border-b-[3px] border-b-transparent text-[#6a7681] pb-[13px] pt-4" href="#">
                  <p class="text-[#fffff1] text-sm font-bold leading-normal tracking-[0.015em]">News</p>
                </a>
              </div>
            </div>
           
             <% updates.forEach(update => { %>
  <div class="flex gap-4 bg-slate-300 px-4 py-3 justify-between">
    <div class="flex items-start gap-4">
      <div class="text-[#121416] flex items-center justify-center rounded-lg bg-[#f1f2f4] shrink-0 size-12"
           data-icon="<%= update.icon %>" data-size="24px" data-weight="regular">
       <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" fill="currentColor" viewBox="0 0 256 256">
        <path d="M240,120a48.05,48.05,0,0,0-48-48H152.2c-2.91-.17-53.62-3.74-101.91-44.24A16,16,0,0,0,24,40V200a16,16,0,0,0,26.29,12.25c37.77-31.68,77-40.76,93.71-43.3v31.72A16,16,0,0,0,151.12,214l11,7.33A16,16,0,0,0,186.5,212l11.77-44.36A48.07,48.07,0,0,0,240,120ZM40,199.93V40h0c42.81,35.91,86.63,45,104,47.24v65.48C126.65,155,82.84,164.07,40,199.93Zm131,8,0,.11-11-7.33V168h21.6ZM192,152H160V88h32a32,32,0,1,1,0,64Z">

        </path>
        </svg>
      </div>
      <div class="flex flex-1 flex-col justify-center">
        <p class="text-[#121416] text-base font-medium leading-normal"><%= update.title %></p>
        <p class="text-[#592791] text-base  font-normal leading-normal">Posted by: <%=update.clubName %> (<%= update.posted_by %>)</p>
        <p class="text-[#6a7681] text-sm font-normal leading-normal"><%= update.description %></p>
      </div>
    </div>
    <div class="shrink-0"><p class="text-[#6a7681] text-sm font-normal leading-normal">3d ago</p></div>
  </div>
<% }); %>
            
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
